@using Gharshare.CommonHelper
@using Gharshare.Models
@model LeaseAgreement
@{
    ViewData["Title"] = "Renew Lease";
    Layout = null;
}
<div class="row justify-content-center h-100 align-items-center">
    <form id="frmLease">
        <div class="row">
            <form id="frmLease">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ID" />
                <div class="col-xl-3 mt-2">
                    <label>Rental Price Per Week:</label>
                </div>
                <div class="col-xl-9 mb-2">
                    <input required type="text" id="txtweeklyrent" class="form-control" asp-for=@Model.WeeklyRent />
                    <span asp-validation-for="WeeklyRent" class="text-danger"></span>
                </div>
                <div class="col-xl-3 mt-2">
                    <label>Payment Frequency:</label>
                </div>
                <div class="col-xl-9 mb-2">
                    <select id="dllrentperiod" class="nice-select w-100" asp-for="PaymentFrequency">
                        @* <option value="@LeaseAgreement.Frequency.Weekly">Weekly</option> *@
                        <option value="@LeaseAgreement.Frequency.Fortnightly">Fortnightly</option>
                        <option value="@LeaseAgreement.Frequency.Monthly">Monthly</option>
                    </select>
                </div>
                <div class="col-xl-3 mt-2">
                    <label>Amount Per Month:</label>
                </div>
                <div class="col-xl-9 mb-2">
                    <input required id="txtmonthlyrent" readonly type="text" class="form-control"
                           asp-for=@Model.MonthlyRent />
                    <span asp-validation-for="MonthlyRent" class="text-danger"></span>
                    <input type="hidden" id="txtperiodicrent" asp-for="PeriodicRent" />
                </div>
                <div class="col-xl-3 mt-2">
                    <label>Current End Date:</label>
                </div>
                <div class="col-xl-9 mt-2">
                    <label>@Utility.ConvertToShortDateFormat(Model.To)</label>
                </div>
                <div class="col-xl-3 mt-2">
                    <label>New Start Date:</label>
                </div>
                <div class="col-xl-9 mb-2">
                    <input required type="text" class="form-control datepicker" asp-for=@Model.From />
                    <span asp-validation-for="From" class="text-danger"></span>
                </div>
                <div class="col-xl-3 mt-2">
                    <label>New End Date:</label>
                </div>
                <div class="col-xl-9 mb-2">
                    <input required type="text" class="form-control datepicker" asp-for=@Model.To />
                    <span asp-validation-for="To" class="text-danger"></span>
                </div>
                <div class="col-sm-6 text-start offset-md-3">
                    <div class="form-check custom-checkbox ms-1 ">
                        <input type="checkbox" asp-for="IsPeriodicAgreement"
                               class="form-check-input" />
                        <label class="form-check-label">
                            Go Periodic?
                        </label>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="text-label form-label">
                        Would you like to send an updated lease agreement with these changes?
                    </label>
                    <div class="col-sm-2">
                        <input type="radio" class="form-check-input"
                               asp-for="sendupdatedlease" value="true" /> Yes
                    </div>
                    <div class="col-sm-3">
                        <input type="radio" class="form-check-input"
                               asp-for="sendupdatedlease" value="false" /> No
                    </div>
                </div>
                <div class="row">
                    <div id="stepalert" style="display:none;" class="alert alert-success alert-dismissible fade show m-3 p-3">
                        <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="me-2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                        Lease agreement document is being adjusted. Please wait....
                    </div>
                </div>
                <div class="text-center mt-3 mb-1">
                    <button id="btnRenew" type="submit"
                            class="btn btn-primary w-50">
                        Adjust Lease
                    </button>
                </div>
            </form>
        </div>
    </form>
</div>
<partial name="_ValidationScriptsPartial" />
<partial name="_dtpPartial" />
<script src="~/js/lease/calcualteRent.js"></script>
<script src="~/js/lease/renewLease.js"></script>
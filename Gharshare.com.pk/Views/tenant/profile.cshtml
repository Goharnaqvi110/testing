    <script type="text/javascript" src="~/js/Applicant/addVehicle.js"></script>
    <script type="text/javascript" src="~/js/Applicant/addPet.js"></script>
    <script type="text/javascript" src="~/js/Applicant/addResidentialHistory.js"></script>
    <script type="text/javascript" src="~/js/Applicant/addReference.js"></script>
    <script type="text/javascript" src="~/js/Applicant/addemployer.js"></script>
    <script type="text/javascript" src="~/js/commonFunctions/formatmobilenum.js"></script>
    <script type="text/javascript" src="~/js/commonFunctions/integersOnly.js"></script>
    <script type="text/javascript" src="~/js/commonFunctions/bindIntegerOnlyInput.js"></script>
    <script type="text/javascript" src="~/js/Applicant/loadDependent.js"></script>
    <script type="text/javascript" src="~/js/Applicant/loadPet.js"></script>
    <script type="text/javascript" src="~/js/Applicant/loadVehicle.js"></script>
    <script type="text/javascript" src="~/js/Applicant/loadDocument.js"></script>
    <script type="text/javascript" src="~/js/Applicant/loadEmployer.js"></script>
    <script type="text/javascript" src="~/js/Applicant/loadReference.js"></script>
    <script type="text/javascript" src="~/js/Applicant/loadResidentialhistory.js"></script>
}
@using Gharshare.Models
@using Gharshare.CommonHelper
@model LeaseViewVM
@{
    Layout = "~/Views/Shared/_LayoutTenant.cshtml";
    ViewData["Title"] = "Lease Overview";
}
<div class="container-fluid">
    <div class="page-heading-row">
        <h3 class="page-heading heading-secondary">
            <span id="property-address">Lease Overview</span>
        </h3>
    </div>
    <div class="row m-1">
        <div class="row bd-callout bd-callout-default" style="width:100%;">
            <div class="row">
                <div class="col-md-3"><strong>Property Address:</strong></div> @Model.Property.Address
            </div>
        </div>
    </div>
    <div class="row m-1">
        <div class="row bd-callout" style="width:100%;">
            <div class="row">
                <h4>Lease Summary</h4>
            </div>
            <div class="row">
                <h4 class="section-list-title">Landlord</h4>
            </div>
            <div class="row mb-0">
                <div class="col-md-8">
                    <div class="row mb-0">
                        <div class="col-md-6">
                            <h3 class="header-text">Name:</h3>
                        </div>
                        <div class="col-md-6">
                            @Model.Property.Owner.Name
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="offset-md-4 col-md-4">
                    @Model.Property.Owner.Mobile
                </div>
            </div>
            <div class="row">
                <div class="offset-md-4 col-md-4">
                    @Model.Property.Owner.Email
                </div>
            </div>
            <div class="row">
                <h4 class="section-list-title">Lease</h4>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <h3 class="header-text">Term:</h3>
                </div>
                <div class="col-md-4">
                    @Model.leaseAgreement.From.ToShortDateString() -
                    @Utility.ConvertToShortDateFormat(@Model.leaseAgreement.To)
                </div>
            </div>
            <div class="row">
                <h4 class="section-list-title">Rent Details</h4>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <h3 class="header-text">Weekly rent:</h3>
                </div>
                <div class="col-md-4">
                    <span>
                        Rs @Utility.Format(Model.leaseAgreement.WeeklyRent)                         
                    </span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <h3 class="header-text">Payment Frequency:</h3>
                </div>
                <div class="col-md-4">
                    @Model.leaseAgreement.PaymentFrequency
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <h3 class="header-text">Periodic payment:</h3>
                </div>
                <div class="col-md-4">
                    <span>
                        Rs @Utility.Format(@Model.leaseAgreement.MonthlyRent)
                    </span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <h3 class="header-text">First payment date:</h3>
                </div>
                <div class="col-md-4">
                    @Utility.ConvertToShortDateFormat(@Model.leaseAgreement.FirstRentPaymentDueDate)
                </div>
            </div>
            <div class="row">
                <h4 class="section-list-title">Lease Adjustment</h4>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <h3 class="header-text">Changes to Your Lease:</h3>
                </div>
                <div class="col-md-2">
                    <span>Status: No Request</span>
                </div>
            </div>
            <div class="row">
                <h4 class="section-list-title">Maintenance</h4>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <h3 class="header-text">Tasks:</h3>
                </div>
                <div class="col-md-3">
                    <span>Submitted: 2</span>
                </div>
            </div>
            <div class="offset-md-3">
                <a asp-action="maintenance" asp-controller="portal" 
                asp-route-pid=@Model.Property.uid
                asp-route-lid=@Model.leaseAgreement.uid class="red-link">Go to Maintenance</a>
            </div>
        </div>
    </div>
</div>
                        </div> 
        </div>        
    </div>
</div>
<script src="~/theme/vendor/jquery-smartwizard/dist/js/jquery.smartWizard.min.js"></script>
<script>
    var smartWizard = $('#smartwizard').smartWizard({
        selected: 0,
        theme: 'arrows',
        isValidationEnabled: true,         
    });

</script>

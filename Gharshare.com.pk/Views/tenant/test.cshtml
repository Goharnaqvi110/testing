@using Gharshare.Models
@model LeaseViewVM
@{
    Layout = "~/Views/Shared/_LayoutTenant.cshtml";
    ViewData["Title"] = "Lease Agreement";
}
<div class="container-fluid">
    <h3 class="heading-main">Lease Agreement</h3>
    <div class="row bd-callout">
        <div class="col-md-12 form-floating p-1">
             <div id="smartwizard">
                            <ul class="nav">
                                <li class="nav-item">
                                    <a class="nav-link" href="#step-1">

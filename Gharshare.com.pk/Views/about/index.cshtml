@model IEnumerable<Gharshare.Models.StaticContent>
@{
    ViewData["Title"] = "About us ";
    // Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- BREADCRUMB AREA START -->
<div class="ltn__breadcrumb-area text-left bg-overlay-white-30 bg-image " data-bs-bg="img/bg/14.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="page-title">
                        About <span class="ltn__secondary-color-3">Smart</span> Property 
                        <span class="ltn__secondary-color-3">Manager</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- BREADCRUMB AREA END -->
<div class="ltn__about-us-area pt-120--- pb-90 mt--30">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 align-self-center">
                <div class="about-us-info-wrap">
                    <div class="section-title-area ltn__section-title-2--- mb-20">
                        <h6 class="section-subtitle section-subtitle-2 ltn__secondary-color">About Us</h6>
                        <h1 class="section-title">
                            How do we work?:<span class="ltn__secondary-color-3">
                                We Work
                                Smartly.
                            </span>
                        </h1>
                        <p>
                            We're Smart Property Managers, changing how things work in Pakistan's housing market.
                            Instead of the old agent way, we use cool tech to help landlords handle everything online.
                        </p>
                        <p>
                            Find tenants, manage your property, and handle leases easily, all in one place. It's simple,
                            automated, and makes your property management better.
                        </p>
                    </div>
                    <p>Our platform offers a range of features to make your life easier:</p>
                    <div class="bullets">
                        <img src="/img/publicsite/common/tick.svg"
                             alt="" class="toptik" width="15" height="15">
                        <div class="_3m-bullets">
                            <strong>Effortless Tenant Matching: </strong>Find the perfect tenants quickly and easily
                            using our advanced matching tools.
                        </div>
                    </div>
                    <div class="bullets">
                        <img src="/img/publicsite/common/tick.svg"
                             alt="" class="toptik" width="15" height="15">
                        <div class="_3m-bullets">
                            <strong>Centralized Property Management: </strong>
                            Manage all your properties from one convenient dashboard, allowing you to
                            keep track of rent payments, maintenance requests, and more, all in one place.
                        </div>
                    </div>
                    <div class="bullets">
                        <img src="/img/publicsite/common/tick.svg"
                             alt="" class="toptik" width="15" height="15">
                        <div class="_3m-bullets">
                            <strong>Secure Document Storage: </strong>
                            Store important documents such as lease agreements and tenant records securely online,
                            ensuring easy access whenever you need them.
                        </div>
                    </div>
                    <div class="bullets">
                        <img src="/img/publicsite/common/tick.svg"
                             alt="" class="toptik" width="15" height="15">
                        <div class="_3m-bullets">
                            <strong>Automated Reminders: </strong>
                            Say goodbye to missed payments and overdue maintenance tasks!
                            Our platform sends automated reminders to keep you on top of your responsibilities.
                        </div>
                    </div>
                    <div class="bullets">
                        <img src="/img/publicsite/common/tick.svg"
                             alt="" class="toptik" width="15" height="15">
                        <div class="_3m-bullets">
                            <strong>Expert Support: </strong>
                            Need help or advice? Our team of real estate experts is here to assist you every
                            step of the way, providing guidance and assistance whenever you need it.
                        </div>
                    </div>
                    <p>
                        Join us today and discover the ease and convenience of managing your properties with
                        SmartPropertyManager.pk!
                    </p>
                </div>
            </div>
            <div class="col-lg-6 align-self-center">
                <div class="about-us-img-wrap about-img-left">
                    <img src="/img/real-estate-with-customer.jpg" alt="About Us Image" height="600px">
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ABOUT US AREA START -->
<div class="ltn__about-us-area pt-120--- pb-90 mt--30">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 align-self-center">
                <div class="about-us-img-wrap about-img-left">
                    <img src="/img/about-us.webp" alt="About Us Image">
                    <div class="about-us-img-info about-us-img-info-2 about-us-img-info-3">
                        @* <div class="ltn__video-img ltn__animation-pulse1">
                        <img src="/img/about-us.webp" alt="video popup bg image">
                        <a class="ltn__video-icon-2 ltn__video-icon-2-border---"
                        href="https://www.youtube.com/embed/X7R-q9rsrtU?autoplay=1&showinfo=0"
                        data-rel="lightcase:myCollection">
                        <i class="fa fa-play"></i>
                        </a>
                        </div> *@
                    </div>
                </div>
            </div>
            <div class="col-lg-6 align-self-center">
                <div class="about-us-info-wrap">
                    <div class="section-title-area ltn__section-title-2--- mb-20">
                        <h6 class="section-subtitle section-subtitle-2 ltn__secondary-color">Mission</h6>
                        <h1 class="section-title">
                            Our mission:<span class="ltn__secondary-color-3">
                                Do it
                                better.
                            </span>
                        </h1>
                        <p>
                            We are providing our services all over the
                            This breadth of Pakistan, combined with tools and real estate specialists.
                        </p>
                    </div>
                    <ul class="ltn__list-item-half clearfix">
                        <li>
                            <i class="fa fa-home"></i>
                            Find a better way (to rent your property)
                        </li>
                        <li>
                            <i class="fa-solid fa-people-line"></i>Make it work (for our customers)
                        </li>
                        <li>
                            <i class="fa-regular fa-heart"></i>
                            You are the best person to do it
                        </li>
                        <li>
                            <i class="fa-solid fa-chart-line"></i>Deliver what we promise
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!--  ABOUT US AREA START  -->
<div class="ltn__about-us-area">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-7 align-self-center order-2 order-lg-1">
                <div class="about-us-info-wrap">
                    <div class="section-title-area ltn__section-title-2--- mb-20">
                        <h1 class="section-title">
                            Our <span class="ltn__secondary-color-1">
                                Expertise
                            </span>
                        </h1>
                        <p>
                            Backed by years of experience in the real estate industry, our team brings a wealth of
                            knowledge and expertise to the table. From property management to tenant relations,
                            we understand the complexities of the rental market and are here to help you navigate
                            them with confidence.
                        </p>
                        <p>
                            Explore our diverse portfolio of rental properties, ranging from cozy apartments to
                            spacious single-family homes and commercial spaces. With properties located in prime
                            neighborhoods and equipped with modern amenities, we have the perfect rental to suit your
                            lifestyle and preferences.
                        </p>
                        <h4 class="mt-3">Transparency and Communication</h4>
                        <p>
                            We believe in building strong, transparent relationships with our clients.
                            You can trust us to keep you informed every step of the way, providing clear communication
                            and timely updates on your property’s performance.
                        </p>
                        <h4 class="mt-3">Innovation</h4>
                        <p>
                            At Smart Property Manager, innovation is at the heart of everything we do.
                            We leverage cutting-edge technology and industry best practices to create solutions
                            that are not only effective but also intuitive and user-friendly.
                            From our advanced management tools to our seamless rental process,
                            we’re constantly pushing the boundaries to deliver an unparalleled experience
                            for our users.
                        </p>
                        <h4 class="mt-3">Join Us</h4>
                        <p>
                            Ready to take your rental experience to the next level? Join the Smart Property Manager
                            community today and discover the difference for yourself. With our expertise, innovation,
                            and commitment to excellence, we’re here to help you succeed in the world of property
                            rentals.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 order-1 order-lg-2">
                <div class="about-us-img-wrap about-img-left">
                    <img src="img/about-us-top.jpg" alt="Image" class="mt-5" height="450px">
                </div>
                <div class="about-us-img-wrap about-img-left mt-5">
                    <img src="img/homepage/manage.webp" alt="Image" height="400px" class="mt-5">
                </div>
            </div>
        </div>
    </div>
</div>
<!--  ABOUT US AREA END  -->

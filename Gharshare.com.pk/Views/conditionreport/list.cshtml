@using Gharshare.CommonHelper
@using Gharshare.Models
@model ConditionReportVm

@{
    ViewData["Title"] = "Condition Report";
    Layout = "~/Views/Shared/_LayoutLandlord.cshtml";
}
<div class="container-fluid">
    <div class="page-heading-row">
        <h2 class="page-heading heading-secondary">
            <span id="property-address">Condition Report</span>
        </h2>
    </div>
    <div class="row">
        <div class="col-xl-12">
            <div class="bd-callout bd-callout-default">
                @if (Model.Property.Address != null)
                {
                    <p>
                        <strong>Property Address:</strong> @Model.Property.Address
                    </p>
                }                
                <p><b>About this report</b></p>
                <p>
                    This report should be completed and signed by both landlord and tenant to accurately
                    record the condition of the property at the beginning, middle, and end of the lease. It
                    can be a useful reference if any issues arise.
                </p>
            </div>
        </div>
        <div class="col-xl-6 col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Inspect Your Own Property</h4>
                </div>
                <div class="card-body">
                    <div class="basic-form">
                        <p class="text-center">Start new condition report for your property</p>
                        <div class="text-center">
                            <a asp-action="conditionreportItems" asp-route-PID=@Model.Property.uid
                               class="btn btn-primary">
                                <span class="nav-text">Create Report</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Book A Professional -->
        <div class="col-xl-6">
            <div class="card mb-4">
                <div class="card-header d-block">
                    <h4 class="card-title">Book a Professional</h4>
                </div>
                <div class="card-body">
                    <div class="accordion accordion-primary" id="accordion-one">
                        <div class="accordion-item">
                            <div class="accordion-header rounded-lg collapsed" id="headingOne" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-controls="collapseOne" aria-expanded="false" role="button">
                                <span class="accordion-header-icon"></span>
                                <span class="accordion-header-text">
                                    Hire a professional to complete a
                                    condition report
                                </span>
                                <span class="accordion-header-indicator"></span>
                            </div>
                            <div class="text-center mt-4">
                                <a href="" class="btn btn-primary">
                                    <span class="nav-text">Book Now</span>
                                </a>
                            </div>
                            <div id="collapseOne" class="collapse" aria-labelledby="headingOne" data-bs-parent="#accordion-one" style="">
                                <div class="accordion-body-text text-center">
                                    <p>
                                        <strong>Book with our partner: </strong> Rapid Building Inspections
                                    </p>

                                </div>
                                <ul>
                                    <li>
                                        <i class="fa fa-check-circle" style="font-size:15px;color:rgb(5, 184, 5)"></i>
                                        <b>Online booking convenience:</b> It's easy to book from any
                                        device.
                                    </li>
                                    <li>
                                        <i class="fa fa-check-circle" style="font-size:15px;color:rgb(5, 184, 5)"></i>
                                        <b>Fast turnaround:</b> Prompt service that takes care of the work
                                        for you.
                                    </li>
                                    <li>
                                        <i class="fa fa-check-circle" style="font-size:15px;color:rgb(5, 184, 5)"></i>
                                        <b>Proven experience:</b> Certified, trusted professionals you can
                                        rely on.
                                    </li>
                                    <li>
                                        <i class="fa fa-check-circle" style="font-size:15px;color:rgb(5, 184, 5)"></i>
                                        <b>Industry qualified experts:</b> Experienced and qualified
                                        inspectors.
                                    </li>
                                    <li>
                                        <i class="fa fa-check-circle" style="font-size:15px;color:rgb(5, 184, 5)"></i>
                                        <b>Clear results:</b> Easy to read results and attention to detail.
                                    </li>
                                    <li>
                                        <i class="fa fa-check-circle" style="font-size:15px;color:rgb(5, 184, 5)"></i>
                                        <b>Peace of mind:</b> A thorough condition report - without the
                                        stress.
                                    </li>

                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <hr>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Your Reports</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="container">
                            <div class="row">
                                @{
                                    var count = 1;
                                }
                                @if (Model.ReportList.Any())
                                {
                                    @foreach (var report in Model.ReportList)
                                    {
                                        <div class="col-lg-4">
                                            <div class="card">
                                                @* <img class="card-img-top img-fluid" src="~/img/cr-image.png" alt="Card image cap"> *@
                                                <div class="card-header">
                                                    <h5 class="card-title">Condition Report-@count</h5>
                                                    @{count += 1;}
                                                    <div class="dropdown custom-dropdown mb-0">
                                                        <div class="btn sharp btn-primary tp-btn" data-bs-toggle="dropdown" aria-expanded="false">
                                                            <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="18px" height="18px" viewBox="0 0 24 24" version="1.1"><g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"><rect x="0" y="0" width="24" height="24"></rect><circle fill="#000000" cx="12" cy="5" r="2"></circle><circle fill="#000000" cx="12" cy="12" r="2"></circle><circle fill="#000000" cx="12" cy="19" r="2"></circle></g></svg>
                                                        </div>
                                                        <div class="dropdown-menu dropdown-menu-end" style="margin: 0px;">
                                                            <a asp-action="viewconditionreport" asp-controller="portal" 
                                                            asp-route-id=@report.uid class="dropdown-item">View</a>
                                                            <a class="dropdown-item" asp-action="downloadcreport" asp-controller="portal"
                                                       class="pdf-download-link" asp-route-ID=@report.uid>Download</a>
                                                            <a class="dropdown-item text-danger" href="javascript:void();">Delete</a>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card-body">
                                                    <p class="card-text">
                                                    </p><table class="table">
                                                        <tbody>
                                                            <tr>
                                                                <td>Created on:</td>
                                                                <td style="width:120px;">@Utility.ConvertToShortDateFormat(report.CreatedOn)</td>
                                                            </tr>
                                                            <tr>
                                                                <td>Date Inspected:</td>
                                                                <td>@Utility.ConvertToShortDateFormat(report.InspectionDate)</td>
                                                            </tr>
                                                            <tr>
                                                                <td>Tenant:</td>
                                                                <td>
                                                                    @report.PrimaryTenant.FirstName &nbsp;
                                                                    @report.PrimaryTenant.LastName
                                                                </td>
                                                            </tr>                                                            
                                                            <tr>
                                                                <td>Status</td>
                                                                @if (report.status == ConditionReport.Status.Completed ||
                                                               report.status == ConditionReport.Status.SignedByLandlordAndTenant)
                                                                {
                                                                    <td class="text-success" style="width:150px;">
                                                                        <i class="fa fa-check-circle" style="font-size:15px;color:rgb(5, 184, 5)">
                                                                        </i>
                                                                        <span>Signed by landlord & tenant</span>
                                                                    </td>
                                                                }
                                                                else
                                                                {
                                                                    <td>
                                                                        @Utility.GetEnumDisplayName(@report.status)
                                                                    </td>                                                                    
                                                                }
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                    <p></p>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p>no record exists</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
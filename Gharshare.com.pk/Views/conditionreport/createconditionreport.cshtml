@using Gharshare.CommonHelper
@using Gharshare.Models
@model Gharshare.Models.ConditionReportVm

@{
    ViewData["Title"] = "Create Condition Report";
    Layout = "~/Views/Shared/_LayoutLandlord.cshtml";
}
<form id="frmreport" asp-action="savereport" method="post" enctype="multipart/form-data">
    <div class="container-fluid">
        <div class="page-heading heading-secondary">
            @if (Model.Property.Address != null)
            {
                <h2>@Model.Property.Address</h2>
            }
            else
            {
                <h2>@Model.Property.Suburb</h2>
            }
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="bd-callout bd-callout-default">
                    @if (Model.Property.Address != null)
                    {
                        <p><b>Property Address:</b> @Model.Property.Address</p>
                    }
                    else
                    {
                        <p><b>Property Address:</b> @Model.Property.Suburb</p>
                    }
                    <p><b>Created On:</b> @DateTime.Now.ToShortDateString()</p>
                    <div class="row">
                        <div class="col-lg-6">
                            <p><b>Landlord Name:</b>@Model.Property.Owner.Name</p>
                            <input type="hidden" asp-for=@Model.Property.ID>
                            <input type="hidden" asp-for=@Model.Property.OwnerId>
                        </div>
                        <div>
                            @if (Model.Property?.Lease != null)
                            {
                                <input type="hidden" asp-for=@Model.Property.Lease.ID />
                                <input type="hidden" asp-for=@Model.Property.Lease.PrimaryTenantID />
                            }
                        </div>
                        <div class="col-lg-6">
                            <p><b>Tenant Name:</b> @Model.Property.Lease.PrimaryTenant.FirstName</p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-6">
                            <p>
                                <b>Date of Inspection:</b>
                                <div class="input-group">
                                    @{
                                        var inspectionDate = DateTime.Now.ToShortDateString();
                                    }
                                    <input id="inspectionDate" type="text" required readonly
                                           asp-for="@Model.CondtionReport.InspectionDate" value="@inspectionDate"
                                           class="form-control datepicker">                                    
                                    <div class="input-group-text fa fa-calendar"></div>                                    
                                </div>
                                @*<span asp-validation-for="@Model.CondtionReport.InspectionDate"></span>*@
                            </p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-2">
                            <p><b>Status:</b></p>
                        </div>
                        <div class="col-lg-6">
                            <p><b>@ConditionReport.Status.Created</b></p>
                        </div>
                    </div>
                    @*<div class="p-3">
                    <p>Hire a certified professional to complete a condition report for you</p>
                    <a href="" class="btn btn-primary">
                    <span class="nav-text">Hire a Professional</span>
                    </a>
                    <a href="#" class=" float-end">
                    <i class="fa fa-plus"></i>
                    <span class="nav-text"> Add New Room</span>
                    </a>
                    </div>*@
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-xl-12 col-xxl-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Create Condition Report</h4>
                    </div>
                    <div class="card-body">
                        <div id="smartwizard">
                            <ul class="nav">
                                <li class="nav-item">
                                    <a class="nav-link" href="#step-1">
                                        <span class="num">1</span>
                                        Condition Report
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#step-2">
                                        <span class="num">2</span>
                                        View & Send Condition Report
                                    </a>
                                </li>
                            </ul>
                            <div class="tab-content">
                                <div id="step-1" class="tab-pane" role="tabpanel" aria-labelledby="step-1">
                                    <h3 class="text-center">
                                        Create <span class="text-primary"> report</span>
                                    </h3>
                                    @{
                                        string areaName = string.Empty;
                                        for (int i = 0; i < Model.PropertyAreaItem.Count(); i++)
                                        {
                                            bool photoField = @Model.PropertyAreaItem[i].PhotoField;
                                            <input type="hidden" asp-for=@Model.PropertyAreaItem[i].PhotoField>

                                            bool additionalComments = @Model.PropertyAreaItem[i].AddComments;

                                            bool yesNoField = @Model.PropertyAreaItem[i].YesNoField;
                                            <input type="hidden" asp-for=@Model.PropertyAreaItem[i].YesNoField>

                                            bool meterReadingField = @Model.PropertyAreaItem[i].MeterReadingField;
                                            <input type="hidden" asp-for=@Model.PropertyAreaItem[i].MeterReadingField>

                                            bool lastWorkedOnField = @Model.PropertyAreaItem[i].LastWorkedOnField;
                                            <input type="hidden" asp-for=@Model.PropertyAreaItem[i].LastWorkedOnField>

                                            bool normalField = @Model.PropertyAreaItem[i].NormalField;
                                            <input type="hidden" asp-for=@Model.PropertyAreaItem[i].NormalField>

                                            bool tobedoneByField = @Model.PropertyAreaItem[i].TobedoneByField;
                                            <input type="hidden" asp-for=@Model.PropertyAreaItem[i].TobedoneByField>

                                            bool DeadlineDateField = @Model.PropertyAreaItem[i].DeadlineDateField;
                                            bool giveHeading = false;
                                            <input type="hidden" asp-for=@Model.PropertyAreaItem[i].DeadlineDateField>
                                            <div class="row">
                                                <h4>@Model.PropertyAreaItem[i].AreaName</h4>
                                                @{
                                                    var test = Model.PropertyAreaItem[i].AreaName;
                                                }
                                                <input type="hidden" asp-for=@Model.PropertyAreaItem[i].AreaName>
                                                <input type="hidden" asp-for=@Model.PropertyAreaItem[i].PropertyAreaID>
                                            </div>
                                            @if (@Model.PropertyAreaItem[i].AreaName != null)
                                            {
                                                giveHeading = true;
                                            }
                                            <hr />
                                            if (normalField == true)
                                            {
                                                <div class="row">
                                                    <div class="col-md-3">
                                                        <div class="row mt-5">
                                                            <label asp-for=@Model.PropertyAreaItem[i].Name>@Model.PropertyAreaItem[i].Name</label>
                                                            <input type="hidden" asp-for=@Model.PropertyAreaItem[i].Name>
                                                            <input type="hidden" asp-for=@Model.PropertyAreaItem[i].ID>
                                                        </div>
                                                        <div class="row mt-3">
                                                            <span>Comments</span><br />
                                                        </div>
                                                        <div class="row">
                                                            <span>(Max. 500 characters)</span>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4 text-center">
                                                        <div class="col-md-12 text-center">
                                                            @if (i == 0)
                                                            {
                                                                <label>Landlord</label>
                                                            }
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-4 text-center">Clean</div>
                                                            <div class="col-md-4 text-center">Undamaged</div>
                                                            <div class="col-md-4 text-center">Working</div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-4 text-center">
                                                                @if (giveHeading)
                                                                {
                                                                    <div class="btn-group">
                                                                        <label class="crradio-label">
                                                                            <i class="fa fa-check" style="font-size:15px;color:#20C997"></i>
                                                                            <input type="radio" asp-for=@Model.PropertyAreaItem[i].Clean value="true"
                                                                   class="form-check-input correct">
                                                                        </label>
                                                                    </div>
                                                                    <div class="btn-group">
                                                                        <label class="crradio-label">
                                                                            <i class="fa fa-times" style="font-size:15px;color:#EE3232"></i>
                                                                            <input type="radio" asp-for=@Model.PropertyAreaItem[i].Clean value="false"
                                                                   class="form-check-input wrong">
                                                                        </label>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="btn-group">
                                                                        <input type="radio" asp-for=@Model.PropertyAreaItem[i].Clean value="true"
                                                               class="form-check-input correct">
                                                                    </div>
                                                                    <div class="btn-group">
                                                                        <input type="radio" asp-for=@Model.PropertyAreaItem[i].Clean value="false"
                                                               class="form-check-input wrong">
                                                                    </div>
                                                                }
                                                            </div>
                                                            <div class="col-md-4 text-center">
                                                                @if (giveHeading)
                                                                {
                                                                    <div class="btn-group">
                                                                        <label class="crradio-label">
                                                                            <i class="fa fa-check" style="font-size:15px;color:#20C997"></i>
                                                                            <input type="radio" asp-for=@Model.PropertyAreaItem[i].Undamaged value="true"
                                                                   class="form-check-input correct">
                                                                        </label>
                                                                    </div>
                                                                    <div class="btn-group">
                                                                        <label class="crradio-label">
                                                                            <i class="fa fa-times" style="font-size:15px;color:#EE3232"></i>
                                                                            <input type="radio" asp-for=@Model.PropertyAreaItem[i].Undamaged value="false"
                                                                   class="form-check-input wrong">
                                                                        </label>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="btn-group">
                                                                        <input type="radio" asp-for=@Model.PropertyAreaItem[i].Undamaged value="true"
                                                               class="form-check-input correct">
                                                                    </div>
                                                                    <div class="btn-group">
                                                                        <input type="radio" asp-for=@Model.PropertyAreaItem[i].Undamaged value="false"
                                                               class="form-check-input wrong">
                                                                    </div>
                                                                }
                                                            </div>
                                                            <div class="col-md-4 text-center">
                                                                @if (giveHeading)
                                                                {
                                                                    <div class="btn-group">
                                                                        <label class="crradio-label">
                                                                            <i class="fa fa-check" style="font-size:15px;color:#20C997"></i>
                                                                            <input type="radio" asp-for=@Model.PropertyAreaItem[i].Working value="true"
                                                                   class="form-check-input correct">
                                                                        </label>
                                                                    </div>
                                                                    <div class="btn-group">
                                                                        <label class="crradio-label">
                                                                            <i class="fa fa-times" style="font-size:15px;color:#EE3232"></i>
                                                                            <input type="radio" asp-for=@Model.PropertyAreaItem[i].Working value="false"
                                                                   class="form-check-input wrong">
                                                                        </label>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="btn-group">
                                                                        <input type="radio" asp-for=@Model.PropertyAreaItem[i].Working value="true"
                                                               class="form-check-input correct">
                                                                    </div>
                                                                    <div class="btn-group">
                                                                        <input type="radio" asp-for=@Model.PropertyAreaItem[i].Working value="false"
                                                               class="form-check-input wrong">
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                        <div class="row text-center">
                                                            <textarea class="form-control" row=4 style="width:370px;" asp-for="@Model.PropertyAreaItem[i].LandlordComments"></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4 text-center" style="padding-left:70px;">
                                                        <div class="col-md-12 text-center">
                                                            @if (i == 0)
                                                            {
                                                                <label>Tenant</label>
                                                            }
                                                        </div>
                                                        <div class="text-center">
                                                            <span>Agrees?</span>
                                                        </div>
                                                        @if (User.IsInRole(WebSiteRoles.Role_Tenant))
                                                        {
                                                            <div class="row mt-6">
                                                                <div class="col-md-6 text-right">
                                                                    <input type="radio" asp-for=@Model.PropertyAreaItem[i].TenantAgreed
                                                           class="form-check-input correct" value="true">
                                                                </div>
                                                                <div class="col-md-2">
                                                                    <input type="radio" asp-for=@Model.PropertyAreaItem[i].TenantAgreed
                                                           class="form-check-input wrong" value="false">
                                                                </div>
                                                            </div>
                                                            <div class="row pl-70">
                                                                <textarea class="form-control" row=4 style="width:200px;"
                                                          asp-for=@Model.PropertyAreaItem[i].TenantComments></textarea>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="row mt-6">
                                                                <div class="col-md-6 text-right">
                                                                    <input disabled type="radio"
                                                           asp-for=@Model.PropertyAreaItem[i].TenantAgreed
                                                           class="form-check-input correct" value="true">
                                                                </div>
                                                                <div class="col-md-1">
                                                                    <input disabled type="radio"
                                                           asp-for=@Model.PropertyAreaItem[i].TenantAgreed
                                                           class="form-check-input wrong" value="false">
                                                                </div>
                                                            </div>
                                                            <div class="row pl-70">
                                                                <textarea disabled class="form-control" row=4 style="width:200px;"
                                                          asp-for=@Model.PropertyAreaItem[i].TenantComments></textarea>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else if (photoField == true)
                                            {
                                                <div class="row">
                                                    <div class="col-md-3">
                                                        <div class="row mt-5">
                                                            <label>Attach Photos</label>
                                                            <input type="hidden" asp-for=@Model.PropertyAreaItem[i].PhotoField>
                                                            <input type="hidden" asp-for=@Model.PropertyAreaItem[i].Name>
                                                            <input type="hidden" asp-for=@Model.PropertyAreaItem[i].ID>
                                                            <input type="hidden" asp-for=@Model.PropertyAreaItem[i].AreaName>
                                                            <input type="hidden" asp-for=@Model.PropertyAreaItem[i].PropertyAreaID>
                                                        </div>
                                                        <div class="row mt-3">
                                                            <span>(Max. 15 photos)</span><br />
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4 mt-30">
                                                        <div class="input-group mb-3">
                                                            <div>
                                                                <input multiple type="file"
                                                           asp-for=@Model.PropertyAreaItem[i].Photos
                                                           class="form-file-input form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <hr />
                                            }
                                            else if (additionalComments == true)
                                            {
                                                <div class="row">
                                                    <div class="col-md-3">
                                                        <div class="row mt-5">
                                                            <label>Additional Comments</label>
                                                            <input type="hidden" asp-for=@Model.PropertyAreaItem[i].AddComments>
                                                            <input type="hidden" asp-for=@Model.PropertyAreaItem[i].Name>
                                                            <input type="hidden" asp-for=@Model.PropertyAreaItem[i].ID>
                                                            <input type="hidden" asp-for=@Model.PropertyAreaItem[i].AreaName>
                                                            <input type="hidden" asp-for=@Model.PropertyAreaItem[i].PropertyAreaID>
                                                        </div>
                                                        <div class="row mt-3">
                                                            <span>(Max. 500 characters)</span><br />
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4 text-center mt-30">
                                                        <textarea placeholder="Enter Additional Comments" class="form-control" row=4 style="width:370px;"
                                                      asp-for="@Model.PropertyAreaItem[i].AdditionalComments"></textarea>
                                                    </div>
                                                </div>
                                                <hr />
                                            }
                                            else if (yesNoField == true)
                                            {
                                                <div class="row">
                                                    <div class="col-md-5">
                                                        <label asp-for=@Model.PropertyAreaItem[i].Name>@Model.PropertyAreaItem[i].Name</label>
                                                        <input type="hidden" asp-for=@Model.PropertyAreaItem[i].Name>
                                                        <input type="hidden" asp-for=@Model.PropertyAreaItem[i].ID>
                                                    </div>
                                                    <div class="col-md-1">
                                                        <div class="btn-group">
                                                            <div>
                                                                <div class="mt-1">
                                                                    <label>Yes</label>
                                                                </div>
                                                                <input type="radio" asp-for=@Model.PropertyAreaItem[i].isTrue
                                                           class="form-check-input correct" value="true" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-1">
                                                        <div class="btn-group">
                                                            <div>
                                                                <div class="mt-1">
                                                                    <label>No</label>
                                                                </div>
                                                                <input type="radio" asp-for=@Model.PropertyAreaItem[i].isTrue
                                                           class="form-check-input wrong" value="false" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4 text-center ml-5">
                                                        <div class="col-md-12 text-center">
                                                            @if (i == 0)
                                                            {
                                                                <label>Tenant</label>
                                                            }
                                                        </div>
                                                        <div class="text-center">
                                                            <span>Agrees?</span>
                                                        </div>
                                                        @if (User.IsInRole(WebSiteRoles.Role_Tenant))
                                                        {
                                                            <div class="row">
                                                                <div class="col-md-6 text-right">
                                                                    <input type="radio"
                                                           asp-for=@Model.PropertyAreaItem[i].TenantAgreed
                                                           class="form-check-input correct" value="true">
                                                                </div>
                                                                <div class="col-md-1">
                                                                    <input type="radio"
                                                           asp-for=@Model.PropertyAreaItem[i].TenantAgreed
                                                           class="form-check-input wrong" value="false">
                                                                </div>
                                                            </div>
                                                            <div class="row pl-70 pt-3">
                                                                <textarea class="form-control" row=4 style="width:200px;"
                                                          asp-for=@Model.PropertyAreaItem[i].TenantComments></textarea>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="row">
                                                                <div class="col-md-6 text-right">
                                                                    <input disabled type="radio"
                                                           asp-for=@Model.PropertyAreaItem[i].TenantAgreed
                                                           class="form-check-input correct" value="true">
                                                                </div>
                                                                <div class="col-md-1">
                                                                    <input disabled type="radio"
                                                           asp-for=@Model.PropertyAreaItem[i].TenantAgreed
                                                           class="form-check-input wrong" value="false">
                                                                </div>
                                                            </div>
                                                            <div class="row text-center pl-70 pt-3">
                                                                <textarea disabled class="form-control" row=4 style="width:200px;"
                                                          asp-for=@Model.PropertyAreaItem[i].TenantComments></textarea>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else if (meterReadingField == true)
                                            {
                                                <div class="row">
                                                    <div class="col-md-4 mt-30">
                                                        <label asp-for=@Model.PropertyAreaItem[i].Name>
                                                            @Model.PropertyAreaItem[i].Name
                                                        </label>
                                                        <input type="hidden" asp-for=@Model.PropertyAreaItem[i].Name>
                                                        <input type="hidden" asp-for=@Model.PropertyAreaItem[i].ID>
                                                    </div>
                                                    <div class="col-md-4 mt-30">
                                                        <input type="number" maxlength="7" class="form-control" placeholder="Enter meter reading"
                                                   asp-for=@Model.PropertyAreaItem[i].Reading />
                                                    </div>
                                                    <div class="col-md-3"></div>
                                                </div>
                                            }
                                            else if (lastWorkedOnField == true)
                                            {
                                                <div class="row">
                                                    <div class="col-md-4 mt-30">
                                                        <label asp-for=@Model.PropertyAreaItem[i].Name>
                                                            @Model.PropertyAreaItem[i].Name
                                                        </label>
                                                        <input type="hidden" asp-for=@Model.PropertyAreaItem[i].Name>
                                                        <input type="hidden" asp-for=@Model.PropertyAreaItem[i].ID>
                                                    </div>
                                                    <div class="col-md-4 mt-30">
                                                        <div class="input-group">
                                                            <input type="text" readonly class="form-control datepicker"
                                                       asp-for=@Model.PropertyAreaItem[i].LastWorkedDate />
                                                            <div class="input-group-text fa fa-calendar"></div>
                                                        </div>

                                                    </div>
                                                    <div class="col-md-3"></div>
                                                </div>
                                                //<hr>
                                            }
                                            else if (tobedoneByField == true && DeadlineDateField == false)
                                            {
                                                <div class="row col-md-12">
                                                    <p>(Skip if not required)</p>
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-12 m-2">
                                                        <label asp-for=@Model.PropertyAreaItem[i].Name>
                                                            @Model.PropertyAreaItem[i].Name
                                                        </label>
                                                        <input type="hidden" asp-for=@Model.PropertyAreaItem[i].Name>
                                                        <input type="hidden" asp-for=@Model.PropertyAreaItem[i].ID>
                                                    </div>
                                                </div>
                                                <div class="row m-2">
                                                    <textarea rows=5 class="form-control"
                                                  asp-for=@Model.PropertyAreaItem[i].LandlordPromise></textarea>
                                                </div>
                                            }
                                            else if (tobedoneByField == true && DeadlineDateField == true)
                                            {
                                                <div class="row mt-30">
                                                    <div class="col-md-4">
                                                        <label>@Model.PropertyAreaItem[i].Name</label>
                                                        <input type="hidden" asp-for=@Model.PropertyAreaItem[i].Name>
                                                        <input type="hidden" asp-for=@Model.PropertyAreaItem[i].ID>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="input-group">
                                                            <input readonly type="text" class="form-control datepicker"
                                                       asp-for=@Model.PropertyAreaItem[i].DeadlineDate />
                                                            <div class="input-group-text fa fa-calendar"></div>
                                                        </div>

                                                    </div>
                                                </div>
                                            }
                                        }
                                    }

                                    <div id="stepalert" style="display:none;" class="alert alert-success alert-dismissible fade show m-3 p-3">
                                        <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="me-2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                                        Creating condition report. Please wait....
                                    </div>
                                    <div class="row mt-5">
                                        <div class="col-lg-6">
                                            <p><strong>Signed by landlord</strong></p>
                                            <button id="btnclick2sign" type="button"
                                                    class="btn btn-primary mb-2"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#exampleModal"
                                                    data-toggle="modal" data-target="#exampleModal">
                                                Click
                                                to sign
                                            </button>
                                            <input asp-for=@Model.CondtionReport.LandlorsigData type="hidden" id="sigval" />
                                            <input id="sigDate" asp-for=@Model.CondtionReport.LandlordSignedOn type="hidden" />
                                            <div class="row m-1">
                                                <img src="" id="signaturePreview" data-bs-toggle="modal"
                                                     data-bs-target="#exampleModal"
                                                     data-toggle="modal" data-target="#exampleModal">
                                            </div>
                                            <div class="row pl-160">
                                                <span id="lblsignon" style="display:none">Signed by Landlord on:</span>
                                                <span id="signedon"></span>
                                            </div>

                                            <!-- Modal -->
                                            <div class="modal fade" id="exampleModal">
                                                <div class="modal-dialog"
                                                     role="document">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">
                                                                Sign Condition Report
                                                            </h5>
                                                            <button type="button"
                                                                    class="btn-close"
                                                                    data-bs-dismiss="modal">
                                                            </button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div id="signature" style="width:400px;
                                                        border: 1px solid black;"></div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button"
                                                                    class="btn btn-danger light"
                                                                    data-bs-dismiss="modal">
                                                                Close
                                                            </button>
                                                            <button type="button" id="preview" class="btn btn-primary"
                                                                    data-bs-dismiss="modal">
                                                                Sign
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-6 float-end">
                                            <p>
                                                <strong> Signed by Tenant</strong>
                                            </p>
                                            <div class="click-to-sign"
                                                 id="click-to-sign">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div id="step-2" class="tab-pane" role="tabpanel" aria-labelledby="step-2">
                                    <h3 class="text-center">View and<span class="text-primary"> send</span> report</h3>
                                    <div class="row">
                                        <div class="col-md-8 p-1">
                                            <div class="card" style="border:1px solid #f5f5f5; margin:10px;">
                                                <div class="card-header">
                                                    <h6>
                                                        <span>Condition Report</span>
                                                    </h6>
                                                </div>
                                                <div class="card-body">
                                                    <embed id="embedreport" height="450" width="100%" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-xl-4">
                                            <div class="card" style="border:1px solid #f5f5f5; margin:10px;height:230px;">
                                                <div class="card-header">
                                                    <h6>
                                                        <i class="fa fa-envelope"></i>
                                                        <span>Send condition report to tenant(s)</span>
                                                    </h6>
                                                </div>
                                                <div class="card-body">

                                                    <div class="row">
                                                        <p>Click below button to send condion report to tenant(s).</p>
                                                    </div>
                                                    <div class="row mt-3">
                                                        <input id="reportId" type="hidden" />
                                                        <a onclick="sendReport($('#reportId').val())"
                                                           class="btn btn-primary w-100" href="#">
                                                            Send Condition Report
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Include optional progressbar HTML -->
                            <div class="progress">
                                <div class="progress-bar" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>


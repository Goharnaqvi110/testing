@using Gharshare.CommonHelper
@using Gharshare.Models
@model SearchVM
@{
    ViewData["Title"] = "Search Product";

    Pager pager = new Pager();
    int pageNo = 0;

    if(ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;
        pageNo = pager.CurrentPage;
    }
}

<!-- BREADCRUMB AREA START -->
@*<div class="ltn__breadcrumb-area text-left bg-overlay-white-30 bg-image " data-bs-bg="/img/bg/14.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner">
                    <h1 class="page-title">Search Properties</h1>
                    <div class="ltn__breadcrumb-list">
                        <ul>
                            <li><a href="index.html"><span class="ltn__secondary-color"><i class="fas fa-home"></i></span> Home</a></li>
                            <li>Search Properties</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>*@
<!-- BREADCRUMB AREA END -->
<!-- PRODUCT DETAILS AREA START -->
<div class="ltn__product-area ltn__product-gutter">
    <div class="container mt-50">
        <div class="row">
            <div class="col-lg-8 order-lg-2 mb-100">
                <div class="ltn__shop-options">
                    <ul class="justify-content-start">
                        <li>
                            <div class="ltn__grid-list-tab-menu ">
                                <div class="nav">
                                    <a class="active show" data-bs-toggle="tab" href="#liton_product_grid"><i class="fas fa-th-large"></i></a>
                                    <a data-bs-toggle="tab" href="#liton_product_list"><i class="fas fa-list"></i></a>
                                </div>
                            </div>
                        </li>
                        <li class="d-none">
                            <div class="showing-product-number text-right">
                                <span>Showing 1–12 of 18 results</span>
                            </div>
                        </li>
                        <li>
                            <div class="short-by text-center">
                                <select id="ddlsort" class="nice-select input-control">
                                    <option value="1">Default Sorting</option>
                                    <option value="2">Sort by popularity</option>
                                    <option value="3">Sort by new arrivals</option>
                                    <option value="4">Sort by rent: low to high</option>
                                    <option value="5">Sort by rent: high to low</option>
                                </select>
                            </div>
                        </li>
                        @* <li>
                            <div class="short-by text-center">
                                <select class="nice-select input-control">
                                    <option>Per Page: 12</option>
                                    <option>Per Page: 20</option>
                                    <option>Per Page: 30</option>
                                    <option>Per Page: 50</option>
                                    <option>Per Page: 100</option>
                                </select>
                            </div>
                        </li> *@
                    </ul>
                </div>
                <div class="tab-content">
                    <div class="tab-pane fade active show" id="liton_product_grid">
                        <div class="ltn__product-tab-content-inner ltn__product-grid-view">
                            <div class="row">
                                <div class="col-lg-12">
                                    <!-- Search Widget -->
                                    <div class="footer-newsletter">
                                        <form asp-controller="property" asp-action="search">
                                            <input id="txtsearch" asp-for="@Model.Searchphrase" class="input-control" placeholder="Search your keyword...">
                                            <div class="btn-wrapper">
                                                <a href="#" class="theme-btn-1 btn input-control-btn btn-news">                                                         
                                                    <i class="fas fa-search"></i>
                                                </a>
                                            </div>
                                        </form>
                                    </div>                                    
                                </div>
                                <!-- ltn__product-item -->
                                @if(Model.Properties.Count()==0)
                                {                                   
                                      <h4 class="text-center">
                                          <span id="message">no record found</span>
                                       </h4> 
                                }  
                                <h4 class="text-center">
                                          <span id="message2"></span>
                                       </h4>
                                <div class="sort" id="sort">
                                @foreach(var property in Model.Properties)
                                {                                 
                                <div class="col-xl-12 col-sm-6 col-12">
                                    <div class="ltn__product-item ltn__product-item-4 ltn__product-item-5 text-center---">
                                        <div class="product-img">
                                            <a asp-controller="property" asp-action="detail" asp-route-uid=@property.uid><img src="@property.CoverImage" alt="#"></a>
                                            @*<div class="real-estate-agent">
                                                <div class="agent-img">
                                                    <a href="team-details.html"><img src="img/blog/author.jpg" alt="#"></a>
                                                </div>
                                            </div>*@
                                        </div>
                                        <div class="product-info">
                                            <div class="product-badge">
                                                <ul>
                                                    <li class="sale-badg">For Rent</li>
                                                </ul>
                                            </div>
                                            <h2 class="product-title">
                                                <a asp-controller="property" asp-action="detail" asp-route-uid=@property.uid>
                                                    @property.AdTitle</a></h2>
                                            <div class="product-img-location">
                                                <ul>
                                                    <li>
                                                        <a href="locations.html"><i class="flaticon-pin"></i>@property.Address</a>
                                                    </li>
                                                </ul>
                                            </div>
                                            <ul class="ltn__list-item-2--- ltn__list-item-2-before--- ltn__plot-brief">
                                                <li>
                                                    <span>@property.Bed </span>
                                                    Bed
                                                </li>
                                                <li>
                                                    <span>@property.Bathroom </span>
                                                    Bath
                                                </li>
                                                <li>
                                                    <span>@property.TotalArea </span>
                                                    Square Ft
                                                </li>
                                            </ul>                                             
                                        </div>
                                        <div class="product-info-bottom">
                                            <div class="product-price">
                                                <span>Rs @property.Rent?.ToString("#,##0")<label>/Month</label></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>                                
                                <!--  -->                                 
                                }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="liton_product_list">
                        <div class="ltn__product-tab-content-inner ltn__product-list-view">
                            <div class="row">
                                <div class="col-lg-12">
                                    <!-- Search Widget -->
                                    <div class="footer-newsletter">
                                        <form asp-controller="property" asp-action="search">
                                            <input id="txtlistviewsearch" asp-for="@Model.Searchphrase" class="input-control" placeholder="Search your keyword...">
                                            <div class="btn-wrapper ">
                                                <button class="theme-btn-1 btn input-control-btn btn-news"
                                                        type="submit" value="Search">
                                                    <i class="fas fa-search"></i>
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                                <div id="list">
                                @foreach(var property in Model.Properties)
                                {
                                <!-- ltn__product-item -->
                                <div class="col-lg-12">
                                    <div class="ltn__product-item ltn__product-item-4 ltn__product-item-5">
                                        <div class="product-img">
                                            <a asp-route-uid=@property.uid asp-action="detail" 
                                            asp-controller="property">
                                            <img src="@property.CoverImage" alt="#"></a>
                                        </div>
                                        <div class="product-info">
                                            <div class="product-badge-price">
                                                <div class="product-badge">
                                                    <ul>
                                                        <li class="sale-badg">For Rent</li>
                                                    </ul>
                                                </div>
                                                <div class="product-price">
                                                    <span>Rs @property.Rent?.ToString("#,##0")<label>/Month</label></span>
                                                </div>
                                            </div>
                                            <h2 class="product-title">
                                                <a asp-route-uid=@property.uid asp-action="detail" 
                                            asp-controller="property">@property.AdTitle</a></h2>
                                            <div class="product-img-location">
                                                <ul>
                                                    <li>
                                                        <a href="locations.html"><i class="flaticon-pin"></i> Belmont Gardens, Chicago</a>
                                                    </li>
                                                </ul>
                                            </div>
                                            <ul class="ltn__list-item-2--- ltn__list-item-2-before--- ltn__plot-brief">
                                                <li>
                                                    <span>@property.Bed</span>
                                                    Bed
                                                </li>
                                                <li>
                                                    <span>@property.Bathroom </span>
                                                    Bath
                                                </li>
                                                <li>
                                                    <span>@property.TotalArea </span>
                                                    Square Ft
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="product-info-bottom">
                                            <div class="real-estate-agent">
                                                <div class="agent-img">
                                                    <a asp-route-uid=@property.uid asp-action="detail" 
                                            asp-controller="property">
                                            <img src="@property.Owner?.ProfilePicture" alt="#"></a>
                                                </div>
                                                <div class="agent-brief">
                                                    <h6><a href="team-details.html">@property.Owner?.Name</a></h6>
                                                    <small>Landlord</small>
                                                </div>
                                            </div>
                                            <div class="product-hover-action">
                                                <ul>
                                                    <li>
                                                        <a href="#" title="Quick View" data-bs-toggle="modal" data-bs-target="#quick_view_modal">
                                                            <i class="flaticon-expand"></i>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a href="#" title="Wishlist" data-bs-toggle="modal" data-bs-target="#liton_wishlist_modal">
                                                            <i class="flaticon-heart-1"></i>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a asp-route-uid=@property.uid asp-action="detail"
                                                        asp-controller="property" title="Property Details">
                                                            <i class="flaticon-add"></i>
                                                        </a>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!--  -->
                                }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>                 
                <partial name="_AjaxPager" model="@pager" />
            </div>
            <div class="col-lg-4  mb-100">
                <aside class="sidebar ltn__shop-sidebar">
                    <h3 class="mb-30">Search Properties</h3>                     
                    <!-- Advance Information widget -->
                    <div class="widget ltn__menu-widget">
                        <h4 class="ltn__widget-title">Property Type</h4>
                        <ul>
                            <li>
                                <label class="checkbox-item">
                                    House
                                    <input class="type" value="1" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>                                 
                            </li>
                            <li>
                                <label class="checkbox-item">
                                    Room
                                    <input class="type" value="2" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>                                 
                            </li>
                            <li>
                                <label class="checkbox-item">
                                    Apartment
                                    <input class="type" value="3" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                            </li>
                            <li>
                                <label class="checkbox-item">
                                    Hostel
                                    <input class="type" value="4" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>                                 
                            </li>
                            <li>
                                <label class="checkbox-item">
                                    Hostel Room
                                    <input class="type" value="5" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                            </li>
                            <li>
                                <label class="checkbox-item">
                                    Shop
                                    <input class="type" value="6" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>                                 
                            </li>
                            <li>
                                <label class="checkbox-item">
                                    Office
                                    <input class="type" value="7" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>                                 
                            </li>
                        </ul>
                        <hr>
                        <h4 class="ltn__widget-title">Features</h4>
                        <ul>
                            @foreach(var feature in Model.Features)
                            {
                            <li>
                                <label class="checkbox-item">
                                    @feature.Title
                                    <input value="@feature.ID" class="feature" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>                                 
                            </li>
                            }                             
                        </ul>
                        <hr>
                        <h4 class="ltn__widget-title">Rent Range</h4>
                        <ul>
                            <li>
                                <label class="checkbox-item">
                                    Low Budget
                                    <input class="rent" value="5000-20000" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                                <span class="categorey-no">Rs 5,000 - Rs 20,000</span>
                            </li>
                            <li>
                                <label class="checkbox-item">
                                    Medium
                                    <input class="rent" value="20000-40000" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                                <span class="categorey-no">Rs 20,000 - Rs 40,000</span>
                            </li>
                            <li>
                                <label class="checkbox-item">
                                    High Budget
                                    <input class="rent" value="40000-1000000000" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                                <span class="categorey-no">Rs 40,000 or More</span>
                            </li>
                        </ul>
                        <hr>                        
                        <h4 class="ltn__widget-title">Bed/bath</h4>
                        <ul>
                            <li>
                                <label class="checkbox-item">
                                    Single
                                    <input id="single" class="bed not5filter" value="1" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>                                 
                            </li>
                            <li>
                                <label class="checkbox-item">
                                    Double
                                    <input id="double" class="bed not5filter" value="2" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>                                 
                            </li>
                            <li>
                                <label class="checkbox-item">
                                    Up To 3
                                    <input id="triple" class="bed not5filter" value="3" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>                                 
                            </li>
                            <li>
                                <label class="checkbox-item">
                                    5 Or More
                                    <input id="chk5bed" class="bed" value="5" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>                                 
                            </li>
                        </ul>
                        <hr>
                    </div> 
                </aside>
            </div>
        </div>
    </div>
</div>
<!-- PRODUCT DETAILS AREA END -->
<script src="/js/commonFunctions/recreatePaging.js"></script>
<script src="/js/property/getProperties.js"></script>
<script src="/js/search/sortProperties.js"></script>
<script src="/js/search/searchPropertyOnInput.js"></script>
<script src="/js/search/filterProperties.js"></script>
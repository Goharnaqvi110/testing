@using Gharshare.CommonHelper
@using Gharshare.Models
@model SearchVM
@{
    ViewData["Title"] = "Search Properties";

    Pager pager = new Pager();
    int pageNo = 0;

    if (ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;
        pageNo = pager.CurrentPage;
    }
}
<!-- BREADCRUMB AREA START -->
<div class="ltn__breadcrumb-area text-left bg-overlay-white-30 bg-image " data-bs-bg="/img/bg/14.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="page-title">
                        Search <span class="ltn__secondary-color-3">Properties</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- PRODUCT DETAILS AREA START -->
<div class="ltn__product-area ltn__product-gutter">
    <div class="container mt-50">
        <div class="row">
            <div class="col-lg-9 order-lg-2 mb-100">
                <div class="ltn__shop-options" style="margin-bottom:0px;">
                    <ul class="justify-content-start">
                        <li>
                            <div class="short-by text-center">
                                <select id="ddlsort" class="nice-select input-control">
                                    <option value="1">Default Sorting</option>
                                    <option value="2">Sort by popularity</option>
                                    <option value="3">Sort by new arrivals</option>
                                    <option value="4">Sort by rent: low to high</option>
                                    <option value="5">Sort by rent: high to low</option>
                                </select>
                            </div>
                        </li>
                    </ul>
                </div>
                <div class="tab-content">
                    <div class="tab-pane fade active show" id="liton_product_grid">
                        <div class="ltn__product-tab-content-inner ltn__product-grid-view">
                            <div class="row">
                                <div class="col-lg-12">
                                    <!-- Search Widget -->
                                    <div class="footer-newsletter">
                                        <form asp-controller="property" asp-action="search">
                                            <input id="txtsearch" asp-for="@Model.Searchphrase" class="input-control" placeholder="Search your keyword...">
                                            <div class="btn-wrapper">
                                                <a href="#" class="theme-btn-1 btn input-control-btn btn-news">
                                                    <i class="fas fa-search"></i>
                                                </a>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                                <!-- ltn__product-item -->
                                @if (Model.Properties.Count() == 0)
                                {
                                    <h4 class="text-center">
                                        <span id="message">no record found</span>
                                    </h4>
                                }                                
                                <div class="row" id="propertyList">
                                    @foreach (var property in Model.Properties)
                                    {
                                        <div class="col-lg-4 col-sm-6 col-12">
                                            <div class="ltn__blog-item ltn__blog-item-3">
                                                <div class="ltn__blog-img">
                                                    <a asp-area="" asp-controller="property" asp-action="detail" asp-route-uid=@property.uid>
                                                        <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel"
                                                             data-interval="false">
                                                            <ol class="carousel-indicators">
                                                                <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active">
                                                                </li>
                                                                <li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
                                                                <li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
                                                            </ol>
                                                            <div class="carousel-inner">
                                                                <div class="carousel-item active">
                                                                    <img src="@(property.CoverImage!=null?property.CoverImage:"/img/propertystock.jpg")" class="d-block w-100" alt="..." style="min-height:300px;">
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </a>
                                                </div>
                                                <div class="ltn__blog-brief">
                                                    <div class="ltn__blog-meta">
                                                        <ul>
                                                            <li class="ltn__blog-author">
                                                                <h6><span>Rs.</span> @Utility.Format(property.Rent)/month</h6>
                                                            </li>
                                                        </ul>
                                                        <div class="ltn__blog-meta">
                                                            <div class="row">
                                                                <div class="col-md-7">
                                                                    <i class="fa fa-bed" style="color: #5c727d;"> <span>@property.Bed</span></i>
                                                                    <i class="fa fa-bath" style="color: #5c727d;"> <span>@property.Bathroom</span></i>
                                                                    <i class="fa fa-user" style="color: #5c727d;">
                                                                        @if (property.Totalflatmates != null)
                                                                        {
                                                                            <span>@property.Totalflatmates</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span>0</span>
                                                                        }
                                                                    </i>
                                                                </div>
                                                                <div class="col-md-5">
                                                                    <ul>
                                                                        <li>
                                                                            <p>@Utility.GetEnumDisplayName(property.CatogryID)</p>
                                                                        </li>
                                                                    </ul>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <p>
                                                            <a asp-area="" asp-controller="property" asp-action="detail" asp-route-uid=@property.uid>
                                                                @if (!string.IsNullOrEmpty(property.Description) && property.Description.Length >= 30)
                                                                {
                                                                    <p>@property.Description.Substring(0, 25)....</p>
                                                                }
                                                                else
                                                                {
                                                                    <p>@property.Description</p>
                                                                }
                                                            </a>
                                                        </p>
                                                        @if (property.AvailableFrom <= DateTime.UtcNow)
                                                        {
                                                            <div class="ltn__blog-btn">
                                                                Available Now
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="ltn__blog-btn">
                                                                Available from
                                                                @Utility.ConvertToShortDateFormat(property.AvailableFrom)
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <partial name="_AjaxPager" model="@pager" />
            </div>
            <div class="col-lg-3  mb-100">
                <aside class="sidebar ltn__shop-sidebar">
                    @* <h3 class="mb-30">Search Properties</h3> *@
                    <!-- Advance Information widget -->
                    <div class="widget ltn__menu-widget">
                        <h4 class="ltn__widget-title">Property Type</h4>
                        <ul>
                            <li>
                                <label class="checkbox-item">
                                    House
                                    <input class="type" value="1" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                            </li>
                            <li>
                                <label class="checkbox-item">
                                    Room
                                    <input class="type" value="2" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                            </li>
                            <li>
                                <label class="checkbox-item">
                                    Apartment
                                    <input class="type" value="3" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                            </li>
                            <li>
                                <label class="checkbox-item">
                                    Hostel
                                    <input class="type" value="4" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                            </li>
                            <li>
                                <label class="checkbox-item">
                                    Hostel Room
                                    <input class="type" value="5" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                            </li>
                            <li>
                                <label class="checkbox-item">
                                    Shop
                                    <input class="type" value="6" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                            </li>
                            <li>
                                <label class="checkbox-item">
                                    Office
                                    <input class="type" value="7" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                            </li>
                        </ul>
                        <hr>
                        <h4 class="ltn__widget-title">Features</h4>
                        <ul>
                            @foreach (var feature in Model.Features)
                            {
                                <li>
                                    <label class="checkbox-item">
                                        @feature.Title
                                        <input value="@feature.ID" class="feature" type="checkbox">
                                        <span class="checkmark"></span>
                                    </label>
                                </li>
                            }
                        </ul>
                        <hr>
                        <h4 class="ltn__widget-title">Rent Range</h4>
                        <ul>
                            <li>
                                <label class="checkbox-item">
                                    Low Budget
                                    <input class="rent" value="5000-20000" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                                <span class="categorey-no">Rs 5,000 - Rs 20,000</span>
                            </li>
                            <li>
                                <label class="checkbox-item">
                                    Medium
                                    <input class="rent" value="20000-40000" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                                <span class="categorey-no">Rs 20,000 - Rs 40,000</span>
                            </li>
                            <li>
                                <label class="checkbox-item">
                                    High Budget
                                    <input class="rent" value="40000-1000000000" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                                <span class="categorey-no">Rs 40,000 or More</span>
                            </li>
                        </ul>
                        <hr>
                        <h4 class="ltn__widget-title">Bed/bath</h4>
                        <ul>
                            <li>
                                <label class="checkbox-item">
                                    Single
                                    <input id="single" class="bed not5filter" value="1" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                            </li>
                            <li>
                                <label class="checkbox-item">
                                    Double
                                    <input id="double" class="bed not5filter" value="2" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                            </li>
                            <li>
                                <label class="checkbox-item">
                                    Up To 3
                                    <input id="triple" class="bed not5filter" value="3" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                            </li>
                            <li>
                                <label class="checkbox-item">
                                    5 Or More
                                    <input id="chk5bed" class="bed" value="5" type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                            </li>
                        </ul>
                        <hr>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</div>
<!-- PRODUCT DETAILS AREA END -->
<!--Scripts for getting properties and create paging start -->
<script src="/js/commonFunctions/recreatePaging.js"></script>
<script src="/js/property/getProperties.js"></script>
<script src="/js/commonFunctions/formatValue.js"></script>
<script src="/js/commonFunctions/formatDateToDDMMYY.js"></script>
<script src="/js/property/availableFrom.js"></script>
<script src="/js/property/getPropertyType.js"></script>
<script src="/js/commonFunctions/getShortDescription.js"></script>
<script src="/js/property/createPropertyList.js"></script>
<script src="/js/search/searchPropertiesByAddress.js"></script>
<!--Scripts for getting properties and create paging end -->

<script src="/js/search/sortProperties.js"></script>
<script src="/js/search/searchPropertyOnInput.js"></script>
<script src="/js/search/filterProperties.js"></script>
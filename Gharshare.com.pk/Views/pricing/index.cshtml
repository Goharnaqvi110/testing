@using Gharshare.Models
@using System.Globalization
@model vmPricing
@{
    ViewData["Title"] = "Plans and Pricing ";
}
<!-- BREADCRUMB AREA START -->
<div class="ltn__breadcrumb-area text-left bg-overlay-white-30 bg-image " data-bs-bg="img/bg/14.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="page-title">
                        Pricing <span class="ltn__secondary-color-3">Smart</span> Property
                        <span class="ltn__secondary-color-3">Manager</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Pricing AREA START ( Feature - 6) -->
<div class="ltn__feature-area mb-120---">
    <div class="container">
        @* <div class="row">
            <div class="col-lg-12">
                <div class="ltn__gallery-menu text-center">                     
                    <div class="ltn__gallery-filter-menu portfolio-filter text-uppercase mb-3 text-center">
                        <button class="active" data-filter=".pricing_1">Pricing</button>
                    </div>
                </div>
            </div>
        </div> *@
        <div class="row ltn__custom-gutter--- justify-content-center">
            <div class="col-lg-4 col-sm-6 col-12 pricing pricing_1 ">
                <div class="ltn__pricing-head section-bg-6 text-center p-2">
                    <h5 class="m-0">@Model.Plans[0].BoxHeading</h5>
                </div>
                <div class="ltn_pricing-body ltn__feature-item ltn__feature-item-6 text-center bg-white pt-2 box-shadow-1 custom-padding">
                    <div class="ltn__feature-icon">                         
                        <img src="img/homepage/match-icon.webp" class="service-icon" alt="#">
                    </div>
                    <div class="ltn__feature-info">
                        <h4><a href="#">@Model.Plans[0].Title</a></h4>
                        <p>@Model.Plans[0].Tagline</p>
                        <h4>Rs @Model.Plans[0].UpFrontPrice.ToString("#,##0")<span class="fs-6 fw-light">&nbsp one-off</span></h4>
                        <a id="register" asp-area="identity" asp-page="/account/register" class="theme-btn-1 btn btn-effect-1 mt-4">Get Started <i class="flaticon-right-arrow"></i></a>
                        <p class="pt-3">
                            <span class="ltn__secondary-color-3">
                                <img src="/img/publicsite/common/pinkcheck.png" alt="" class="custom-rounded me-1" width="15" height="15">
                            </span>@Model.Plans[0].Description
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-sm-6 col-12 pricing pricing_1">
                <div class="ltn__pricing-head section-bg-6 text-center p-2">
                    <h5 class="m-0">@Model.Plans[1].BoxHeading</h5>
                </div>
                <div class="ltn_pricing-body ltn__feature-item ltn__feature-item-6 text-center bg-white pt-2 box-shadow-1">
                    <div class="ltn__feature-icon">                         
                        <img src="img/bestvalue.webp" class="service-icon" alt="#">
                    </div>
                    <div class="ltn__feature-info">
                        <h4><a href="service-details.html">@Model.Plans[1].Title</a></h4>
                        <p>@Model.Plans[1].Tagline</p>
                        <h4>Rs @Model.Plans[1].UpFrontPrice.ToString("#,##0") <span class="fs-6 fw-light">one-off +</span> Rs @Model.Plans[1].MonthlyCharges?.ToString("#,##0") <span class="fs-6 fw-light">/month*</span></h4>
                        <a id="register" asp-area="identity" asp-page="/account/register" class="theme-btn-1 btn btn-effect-1">Get Started <i class="flaticon-right-arrow"></i></a>
                        <p class="pt-3">
                            <span class="ltn__secondary-color-3">
                                <img src="/img/publicsite/common/pinkcheck.png" alt="" class="custom-rounded me-1" width="15" height="15">
                            </span>@Model.Plans[1].Description
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-sm-6 col-12 pricing pricing_1">
                <div class="ltn__pricing-head section-bg-6 text-center p-2">
                    <h5 class="m-0">@Model.Plans[2].BoxHeading</h5>
                </div>
                <div class="ltn_pricing-body ltn__feature-item ltn__feature-item-6 text-center bg-white pt-2 box-shadow-1">
                    <div class="ltn__feature-icon">                        
                        <img src="img/homepage/manage-icon.webp" class="service-icon" alt="#">
                    </div>
                    <div class="ltn__feature-info">
                        <h4><a href="service-details.html">@Model.Plans[2].Title</a></h4>
                        <p>@Model.Plans[2].Tagline</p>
                        <h4>Rs @Model.Plans[2].MonthlyCharges?.ToString("#,##0")<span class="fs-6 fw-light">/month</span></h4>
                        <a id="register" asp-area="identity" asp-page="/account/register" class="theme-btn-1 btn btn-effect-1">Get Started <i class="flaticon-right-arrow"></i></a>
                        <p class="pt-3">
                            <span class="ltn__secondary-color-3">
                                <img  src="/img/publicsite/common/pinkcheck.png" alt="" class="custom-rounded me-1" width="15" height="15">
                            </span>@Model.Plans[2].Description
                        </p>
                    </div>
                </div>
            </div>
            <h4>
                See detailed list of inclusions below.
            </h4>
        </div>
    </div>
</div>
<div class="ltn__category-area ltn__product-gutter --- ">
    <div class="container">
        <div class="row ">
            <div class="col-lg-12">
                <div class="section-title-area ltn__section-title-2--- text-center">
                    <h6 class="section-subtitle section-subtitle-2 ltn__secondary-color">Service</h6>
                    <h1 class="section-title">
                        What's in it for <span class="ltn__secondary-color-3">you?</span>
                    </h1>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12">
                <div class="table-responsive">
                    <table class="table table-hover text-center">
                        <thead>
                            <tr>
                                <td>&nbsp;</td>
                                <td>
                                    <h6 class="m-0">Rs @Model.Plans[0].UpFrontPrice.ToString("#,##0") <span class="fs-6 fw-light">one-off</span></h6>
                                </td>
                                <td>
                                    <h6 class="m-0">Rs @Model.Plans[1].UpFrontPrice.ToString("#,##0") <span class="fs-6 fw-light">one-off +</span> @Model.Plans[1].MonthlyCharges <span class="fs-6 fw-light">/month*</span></h6>
                                </td>
                                <td>
                                    <h6 class="m-0">Rs @Model.Plans[2].MonthlyCharges?.ToString("#,##0") <span class="fs-6 fw-light">/month</span></h6>
                                </td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th>Match</th>
                                <td></td>
                                <td></td>
                                <td></td>
                            </tr>
                            @foreach (var service in Model.Match)
                            {
                                <tr>
                                    <td class="w-25 text-left">
                                        @service.Name
                                    </td>
                                    <td>
                                        @if (service.InPlan1 == true)
                                        {
                                            <img loading="lazy" src="/img/publicsite/common/pinkcheck.png" alt="" class="image-15" width="18">
                                        }
                                    </td>
                                    <td>
                                        @if (service.InPlan2 == true)
                                        {
                                            <img loading="lazy" src="/img/publicsite/common/pinkcheck.png" alt="" class="image-15" width="18">
                                        }
                                    </td>
                                    <td>
                                        @if (service.InPlan3 == true)
                                        {
                                            <img loading="lazy" src="/img/publicsite/common/pinkcheck.png" alt="" class="image-15" width="18">
                                        }
                                    </td>
                                </tr>
                            }
                            <tr>
                                <th>Manage</th>
                                <td></td>
                                <td></td>
                                <td></td>
                            </tr>
                            @foreach (var service in Model.Manage)
                            {
                                <tr>
                                    <td class="text-left"> @service.Name</td>
                                    <td>
                                        @if (service.InPlan1 == true)
                                        {
                                            <img loading="lazy" src="/img/publicsite/common/pinkcheck.png" alt="" class="image-15" width="18">
                                        }
                                    </td>
                                    <td>
                                        @if (service.InPlan2 == true)
                                        {
                                            <img loading="lazy" src="/img/publicsite/common/pinkcheck.png" alt="" class="image-15" width="18">
                                        }
                                    </td>
                                    <td>
                                        @if (service.InPlan3 == true)
                                        {
                                            <img loading="lazy" src="/img/publicsite/common/pinkcheck.png" alt="" class="image-15" width="18">
                                        }
                                </tr>
                            }
                            <tr>
                                <th>Maintain</th>
                                <td></td>
                                <td></td>
                                <td></td>
                            </tr>
                            @foreach (var service in Model.Maintain)
                            {
                                <tr>
                                    <td class="text-left"> @service.Name</td>
                                    <td>
                                        @if (service.InPlan1 == true)
                                        {
                                            <img loading="lazy" src="/img/publicsite/common/pinkcheck.png" alt="" class="image-15" width="18">
                                        }
                                    </td>
                                    <td>
                                        @if (service.InPlan2 == true)
                                        {
                                            <img loading="lazy" src="/img/publicsite/common/pinkcheck.png" alt="" class="image-15" width="18">
                                        }
                                    </td>
                                    <td>
                                        @if (service.InPlan3 == true)
                                        {
                                            <img loading="lazy" src="/img/publicsite/common/pinkcheck.png" alt="" class="image-15" width="18">
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Pricing AREA END -->

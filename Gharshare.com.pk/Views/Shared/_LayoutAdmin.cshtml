 @using Gharshare.DataAccessLayer.Data.Infrastructure.IRepository
@using Gharshare.Models
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Identity
@inject IHttpContextAccessor Accessor
@inject UserManager<ApplicationUser> _userManager
@{
    IUnitofWork _unitOfWork = null;
    if (Accessor?.HttpContext != null)
    {
        _unitOfWork = Accessor.HttpContext.RequestServices.GetService<IUnitofWork>();
    }
    var newMessages = _unitOfWork.Message.GetAll(e => e.Read==false && 
        (e.ToUser.UserType==ApplicationUser.usertype.admin ||
        e.ToUser.UserType==ApplicationUser.usertype.superadmin)
        ,includeProperties: "FromUser,ToUser").ToList().Count();
}


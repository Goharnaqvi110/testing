                            <div class="card-header chat-list-header text-center" style="margin-left:33%;">

                                <!--Get Primary Tenants of all Properties -->
                                @{
                                    var user = await _userManager.GetUserAsync(User);
                                    var currentUserId = user.Id;
                                    var userName = user.Name;
                                    var userType = user.UserType;

                                    var properties = _unitOfWork.Property.GetAllData(p => p.IsActive == true &&
                                    p.IsAdlive == true &&
                                    p.OwnerId == currentUserId, includes: q => q.Include(p => p.Lease)
                                    .ThenInclude(l => l.PrimaryTenant)
                                    .ThenInclude(x => x.User))
                                    .OrderBy(u => u.Lease?.PrimaryTenant.User.Name)
                                    .ToList();

                                    var primaryTenants = new List<ApplicationUser>();

                                    foreach (var property in properties)
                                    {
                                        var lease = property.Lease;
                                        if (lease != null)
                                        {
                                            if (lease.PrimaryTenant != null &&
                                            lease.PrimaryTenant.User != null)
                                            {
                                                primaryTenants.Add(lease.PrimaryTenant.User);
                                            }
                                        }
                                    }
                                    var uniqueTenants = primaryTenants.Distinct().ToList();
                                }
                                <!--Get Primary Tenants of all Properties End-->

                                <div>
                                    <h6 class="mb-1">Chat List</h6>
                                    <p class="mb-0">Show All</p>
                                </div>
                            </div>
                            <form>
                                <input id="txtUserId" type="hidden" value="@currentUserId" />
                                <div class="card-body contacts_body p-0 dz-scroll  " id="DZ_W_Contacts_Body">
                                    <ul class="contacts">
                                        @{
                                            var firstChar = string.Empty;
                                            var prev1stChar = string.Empty;
                                        }
                                        @foreach (var property in properties)
                                        {
                                            if (property.Lease != null &&
                                            property.Lease.PrimaryTenant != null &&
                                            property.Lease.PrimaryTenant.User != null)
                                            {
                                                var tenant = @property.Lease.PrimaryTenant.User;
                                                firstChar = @tenant.Name.Substring(0, 1);
                                                if (prev1stChar == string.Empty || firstChar != prev1stChar)
                                                {
                                                    <li class="name-first-letter">@firstChar</li>
                                                    prev1stChar = firstChar;
                                                }

                                                <li class="active dz-chat-user">
                                                    <div class="d-flex bd-highlight">
                                                        <div class="img_cont">
                                                            <img src="@tenant.ProfilePicture" class="rounded-circle user_img" alt="" />
                                                            <span class="online_icon"></span>
                                                        </div>
                                                        <div class="user_info">
                                                            <a data-tenantuserid="@tenant.Id" data-tenantname="@tenant.Name" data-lid="@property.Lease.ID" data-landlordpic="@user.ProfilePicture"
                                                       data-tenantpic="@tenant.ProfilePicture" data-landlordid="@currentUserId" class="userMessage">
                                                                <span>@tenant.Name</span>
                                                                @{
                                                                    string address = @property.Address;
                                                                    int commaIndex = address.IndexOf(",");
                                                                    string firstPart = commaIndex == -1 ? address :
                                                                    address.Substring(0, commaIndex);
                                                                }
                                                                <span>@firstPart</span>
                                                                <p>online</p>
                                                            </a>
                                                        </div>
                                                    </div>
                                                </li>
                                            }
                                        }

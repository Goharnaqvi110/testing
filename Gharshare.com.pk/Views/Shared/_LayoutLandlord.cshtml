                                        <input id="tenantInput" type="hidden" value="" />
                                        <input id="landlordInput" type="hidden" value=@user.Id />
                                        <input id="sendBy" type="hidden" value="landlord" />
                                        <input id="currentUserId1" type="hidden" value=@currentUserId />                                        
                                    </ul>
                                </div>

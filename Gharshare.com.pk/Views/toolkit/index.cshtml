@{
    ViewData["Title"] = "Property Self-Management Toolkit";
}
<!-- BREADCRUMB AREA START -->
<div class="ltn__breadcrumb-area text-left bg-overlay-white-30 bg-image " data-bs-bg="img/bg/14.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="page-title">
                        Property <span class="ltn__secondary-color-3">Toolkit</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- BREADCRUMB AREA END -->
<!-- ABOUT feature AREA START -->
<div class="ltn__about-feature-area pt-120 pb-90">
    <div class="container">
        <div class="row mb-5" id="feature1">
            <div class="col-lg-5 sticky_effect ">
                <div class="about-us-info-wrap">
                    <div class="section-title-area ltn__section-title-2--- mb-20">
                        <h1 class="section-title">
                            Property<span class="ltn__secondary-color-3"> Toolkit </span>
                        </h1>
                        <p class="fs-5">All the tools you need to - from knowing what to charge, to sussing out your tenants and saying ‘bye’ to your agent (plus those pesky agent fees).</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-7 bg-white">
                <div class="row  justify-content-center">
                    <div class="col-sm-6 col-12">
                        <div class="ltn__feature-item ltn__feature-item-4 text-center bg-white  box-shadow-1 ">
                            <div class="ltn__feature-icon">
                                <img src="/img/publicsite/toolkit/rentalestimate.webp" width="120" alt="#">
                            </div>
                            <div class="ltn__feature-info">
                                <h4>
                                    Rental Estimate <span class="menu-item-badge">FREE</span>
                                </h4>
                                <p>Find out how much weekly rent you can expect from your property.</p> <br>
                                <a class="ltn__service-btn" asp-controller="toolkit" asp-action="rentalestimate">
                                    Learn more <i class="flaticon-right-arrow"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-12">
                        <div class="ltn__feature-item ltn__feature-item-4 text-center bg-white  box-shadow-1 active">
                            <div class="ltn__feature-icon">
                                <img src="/img/publicsite/toolkit/savingcalculator.webp" width="120" alt="#">
                            </div>
                            <div class="ltn__feature-info">
                                <h4>
                                    Savings Calculator <span class="menu-item-badge">FREE</span>
                                </h4>
                                <p>Find out how much you could save from self-management with <strong>Rent</strong><strong class="bold-text-82">Better</strong> </p>
                                <a class="ltn__service-btn" asp-controller="toolkit" asp-action="savingscalculator">
                                    Learn more <i class="flaticon-right-arrow"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-12">
                        <div class="ltn__feature-item ltn__feature-item-4 text-center bg-white  box-shadow-1 ">
                            <div class="ltn__feature-icon">
                                <img src="/img/publicsite/toolkit/switchkit.webp" width="120" alt="#">
                            </div>
                            <div class="ltn__feature-info">
                                <h4>
                                    Agent Switch Kit <span class="menu-item-badge">FREE</span>
                                </h4>
                                <p>Breaking up with your agent? Here's our handy guide. </p>
                                <a class="ltn__service-btn" asp-controller="toolkit" asp-action="agentswitchkit">
                                    Learn more <i class="flaticon-right-arrow"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-12">
                        <div class="ltn__feature-item ltn__feature-item-4 text-center bg-white  box-shadow-1 active">
                            <div class="ltn__feature-icon">
                                <!-- <span><i class="flaticon-house-3"></i></span> -->
                                <img src="/img/publicsite/toolkit/ebook.webp" width="120" alt="#">
                            </div>
                            <div class="ltn__feature-info">
                                <h4>
                                    E-Book <span class="menu-item-badge">FREE</span>
                                </h4>
                                <p>Everything you need to know about renting and managing your property.</p>
                                <a class="ltn__service-btn" asp-controller="toolkit" asp-action="ebook">
                                    Learn more <i class="flaticon-right-arrow"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-12">
                        <div class="ltn__feature-item ltn__feature-item-4 text-center bg-white  box-shadow-1 active">
                            <div class="ltn__feature-icon">
                                <!-- <span><i class="flaticon-house-3"></i></span> -->
                                <img src="/img/publicsite/toolkit/faq.webp" width="120" alt="#">
                            </div>
                            <div class="ltn__feature-info">
                                <h4>
                                    FAQ & Help Centre
                                </h4>
                                <p class="p1 feature">All your questions answered about <strong>Rent</strong><span class="text-span-91"><strong class="bold-text-83">Better</strong></span>, self management and more.</p>
                                <a class="ltn__service-btn" href="/faqs">
                                    Learn more <i class="flaticon-right-arrow"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-12">
                        <div class="ltn__feature-item ltn__feature-item-4 text-center bg-white  box-shadow-1 active">
                            <div class="ltn__feature-icon">                                 
                                <img src="/img/publicsite/toolkit/blog.webp" width="120" alt="#">
                            </div>
                            <div class="ltn__feature-info">
                                <h4>
                                    <strong><span class="ltn__secondary-color-3">SPM</span></strong> Blog
                                </h4>
                                <p class="p1 feature">All the news and ‘how tos’ about self management and the 
                                    Pakistani rental market.</p>
                                <a class="ltn__service-btn" href="/articles">
                                    Learn more <i class="flaticon-right-arrow"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ABOUT feature AREA END -->

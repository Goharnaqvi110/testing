@{
    ViewData["Title"] = "Savings Calculator";
}
<!-- BREADCRUMB AREA START -->
<div class="ltn__breadcrumb-area text-left bg-overlay-white-30 bg-image " data-bs-bg="/img/bg/14.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="page-title">
                        Savings <span class="ltn__secondary-color-3">Calculator</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- BREADCRUMB AREA END -->
<!--  Savings Calculator START  -->
<div class="ltn__about-us-area">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-6 align-self-center">
                <div class="about-us-info-wrap">
                    <div class="section-title-area ltn__section-title-2--- mb-20">
                        <h1> <span class="ltn__secondary-color-3">Savings </span>Calculator </h1>
                        <p>
                            Enter your weekly rent and agency fee to discover the potential savings you could enjoy
                            within a year on Smartpropertymanager.pk.
                        </p>
                    </div>
                    <div class="ltn__form-widget">
                        <form action="#">
                            <input type="number" class="input-control" id="rent" placeholder=" My monthly rent is 50000">
                            <input type="number" class="input-control" id="fee" placeholder="My agency management fee is 5%">
                        </form>
                        <h4>
                            Your smartpropertymanager.pk savings per year*:
                            <div id="savings-output" class="ltn__secondary-color-3 mt-20">Rs 700200.00</div>
                        </h4>
                        <p>
                            * Total savings over 12 months for residential rental properties. Assumes 12-month average 
                            tenancy length,a 1-month leasing fee and Rs200 listing fee.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 align-self-center">
                <img src="/img/publicsite/toolkit/savingcalculator.webp" />
            </div>
        </div>
    </div>
</div>
<!--  Savings Calculator End  -->
<script src="~/js/publicsite/calculateSavings.js"></script>
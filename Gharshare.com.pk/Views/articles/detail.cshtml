@model Gharshare.Models.StaticContent
@{
    ViewData["Title"] = "Smart Property Manager Blog ";
}
<!-- BREADCRUMB AREA START -->
<div class="ltn__breadcrumb-area text-left bg-overlay-white-30 bg-image " data-bs-bg="/img/bg/14.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="section-title">Blog <span>Detail</span></h1>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- BREADCRUMB AREA END -->
<div class="container">
    <div class="row mb-5">
        <h1 class="section-title">@Model.Heading</h1>
    </div>
    <div class="row mb-5">        
        <div class="col-lg-6 align-self-center">
            <div class="about-us-info-wrap">
                <div class="section-title-area ltn__section-title-2--- mb-20">
                    <h2>
                        @Model.LowersectionHeading
                    </h2>
                    <p>
                        @Html.Raw(Model.LowerSection)
                    </p>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="about-us-img-wrap about-img-left">
                <img src="@Model.Imagepath" alt="Blog Image" height="400px">
            </div>
        </div>
    </div>
    <div class="text-center mb-5">
        <a class="theme-btn-1 btn btn-effect-1" asp-controller="articles" asp-action="index">Back</a>
    </div>
</div>

@using Gharshare.Models
@model List<StaticContent>
@{
    ViewData["Title"] = "Book Condition Report ";
}
<!-- BREADCRUMB AREA START -->
<div class="ltn__breadcrumb-area text-left bg-overlay-white-30 bg-image " data-bs-bg="/img/bg/14.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="page-title">
                        Book <span class="ltn__secondary-color-3">Condition</span> Report
                    </h1>
                </div>
            </div>
        </div>
    </div>
</div>

<!--  Book Condition Report START  -->
<div class="ltn__about-us-area">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-6 align-self-center">
                <div class="about-us-info-wrap">
                    <div class="section-title-area ltn__section-title-2--- mb-20">
                        <h2>
                            <span class="ltn__secondary-color-3">Book </span>a Condition Report
                        </h2>
                        <p>
                            It’s important to conduct an initial condition report and regular rental inspections
                            of your property. This will allow you to identify any maintenance issues, ensure
                            your tenants are keeping the place in a good condition and maintain the value of
                            your property.
                        </p>
                        <br>
                        <a href="/register" class="btn theme-btn-1">Sign Up &amp; Book Now</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 align-self-center">
                <img src="/img/publicsite/marketplace/conditionreport/bookreport.webp">
            </div>
        </div>
    </div>
</div>
<!--  Book Condition Report End  -->
<!--2nd Section Start-->
<div class="ltn__about-us-area py-5">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-6 align-self-center ">
                <div class="about-us-info-wrap">
                    <div class=" ltn__form-widget">
                        <div class="analytics-campaigns-content-text-copy-3-steps left">
                            <div class="ltn__secondary-color-3">Step 1</div>
                            <h2 class="title start-tracking">Request booking</h2>
                            <p class="p1 home-feature content-left">
                                Sign in to your RentBetter, click on
                                ‘Condition Report’ and opt to ‘Book a Professional’.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 offset-md-1 align-self-center mt-4 mt-lg-0">
                <div class="about-us-img-wrap mt-4 mt-md-0  about-img-left">
                    <div data-w-id="c2391b4e-4fee-6738-9f9f-e3c137fa5f8c" class="split-content-3-steps content-right-3-steps">
                        <img src="/img/publicsite/marketplace/conditionreport/requestbooking.webp">
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<!--2nd Section End-->
<!--3rd Section Start--><div class="ltn__about-us-area py-5">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-6 align-self-center ">
                <div class="about-us-info-wrap">
                    <div class=" ltn__form-widget">
                        <div class="analytics-campaigns-content-text-copy-3-steps left">
                            <div class="ltn__secondary-color-3">Step 3</div>
                            <h2 class="title start-tracking">Report completed</h2>
                            <p class="p1 home-feature content-left">
                                Your inspection will be completed in person
                                by a qualified professional.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 offset-md-1 align-self-center mt-4 mt-lg-0">
                <div class="about-us-img-wrap mt-4 mt-md-0  about-img-left">
                    <div data-w-id="c2391b4e-4fee-6738-9f9f-e3c137fa5f8c" class="split-content-3-steps content-right-3-steps">
                        <img src="/img/publicsite/marketplace/conditionreport/reportcompleted.webp">
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>
<!--3rd Section End-->
<!--4th Section Start--><div class="ltn__about-us-area py-5">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-5 offset-md-1 align-self-center mt-4 mt-lg-0">
                <div class="about-us-img-wrap mt-4 mt-md-0  about-img-left">
                    <div data-w-id="c2391b4e-4fee-6738-9f9f-e3c137fa5f8c" class="split-content-3-steps content-right-3-steps">
                        <img src="/img/publicsite/marketplace/conditionreport/reportsigned.webp" alt="" class="image-3-steps start-tracking-1-3-steps">
                    </div>
                </div>
            </div>
            <div class="col-lg-6 align-self-center ">
                <div class="about-us-info-wrap">
                    <div class=" ltn__form-widget">
                        <div class="analytics-campaigns-content-text-copy-3-steps left">
                            <div class="ltn__secondary-color-3">Step 4</div>
                            <h2 class="title start-tracking">Approve &amp; sign</h2>
                            <p class="p1 home-feature content-left">
                                Once your inspection is complete, the report
                                will be available online so you can digitally sign and approve it.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!--4th Section End-->
<!--5th Section Start-->
<div class="container mt-30">
    <div class="row mb-5">
        <div class="content-left home-features">
            <h2 class="title home-features">
                Why book a professional for your Condition Report or Routine
                Inspection?
            </h2>
        </div>
        <div class="col-lg-6 align-self-center ">
            <div class="about-us-info-wrap">
                <div class=" ltn__form-widget">

                    <div class="home-feature-wrapper">
                        <div class="home-feature-content">
                            <div class="bullets">
                                <img src="/img/publicsite/common/tick.svg" height="15" width="20" alt="" class="image analytics-tool-feature-icon-copy">
                                <h3 class="title h4-size home-feature-title animated fadeIn">
                                    <strong>Easily book online</strong>
                                </h3>
                            </div>
                            <p class="p1 home-feature content-left">
                                It’s simple to book directly online with
                                <strong>GharShare.</strong> The details of your property are automatically
                                populated, so all you need to do is fill in the inspection form details. We’ll
                                sort the rest!
                            </p>
                        </div>
                    </div>
                    <div class="home-feature-content">
                        <div class="bullets">
                            <img src="/img/publicsite/common/tick.svg" height="15" width="20" alt="" class="image analytics-tool-feature-icon-copy">
                            <h3 class="title h4-size home-feature-title animated fadeIn"><strong>Fast turnaround</strong></h3>
                        </div>
                        <p class="p1 home-feature content-left">
                            Need your inspection done quickly? No problem.
                            All our booking requests are responded to within 24 hours.
                        </p>
                    </div>
                </div>

            </div>
        </div>
        <div class="col-lg-5 offset-md-1 align-self-center">
            <div class="home-feature-content">
                <div class="bullets">
                    <img src="/img/publicsite/common/tick.svg" height="15" width="20" alt="" class="image analytics-tool-feature-icon-copy">
                    <h3 class="title h4-size home-feature-title animated fadeIn">
                        <strong>
                            Certified &amp; trusted
                            professionals
                        </strong>
                    </h3>
                </div>
                <p class="p1 home-feature content-left">
                    We’ve partnered with Rapid Building Inspections to
                    provide comprehensive inspections for your property that follow Australian recognised
                    standards – all at the click of a button.
                </p>
            </div>
            <div class="home-feature-content">
                <div class="bullets">
                    <img src="/img/publicsite/common/tick.svg" height="15" width="20" alt="" class="image analytics-tool-feature-icon-copy">
                    <h3 class="title h4-size home-feature-title animated fadeIn">
                        <strong>
                            All the work done for you
                        </strong>
                    </h3>
                </div>
                <p class="p1 home-feature content-left">
                    Sometimes completing an in-person inspection is just too
                    much hassle. With <strong> GharShare</strong>, there’s no need to lift a finger. Everything
                    will be done for you. All you need to do is digitally sign your report.
                </p>
            </div>
        </div>

    </div>
</div>
<!--5th Section End-->
<!--FAQs Area Start-->
<div class="mb-100">
    <h2 class="text-center mt-20">Frequently Asked <span class="ltn__secondary-color-3">Questions</span></h2>
</div>
<div class="ltn__faq-area mb-100">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="ltn__faq-inner ltn__faq-inner-2">
                    <div id="accordion_2">
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var faq = Model[i];
                            <!-- card -->
                            <div class="card">
                                <h6 class="ltn__card-title collapsed" data-bs-toggle="collapse"
                                    data-bs-target="#faq-item-@i" aria-expanded="false">
                                    @faq.Heading
                                </h6>
                                <div id="faq-item-@i" class="collapse" data-bs-parent="#accordion_2" style="">
                                    <div class="card-body">
                                        <p>
                                            @Html.Raw(faq.LowerSection)
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <!-- card -->
                        }
                    </div>
                    @* <div class="need-support text-center mt-100">
                    <h2>Still need help? Reach out to support 24/7:</h2>
                    <div class="btn-wrapper mb-30">
                    <a href="contact.html" class="theme-btn-1 btn">Contact Us</a>
                    </div>
                    <h3 class="animated fadeIn"><i class="fas fa-phone"></i> +0123-456-789</h3>
                    </div> *@
                </div>
            </div>
            <div class="col-lg-4">
                <aside class="sidebar-area ltn__right-sidebar">
                    <!-- Newsletter Widget -->
                    <div class="section-bg-2">
                        <div class="footer-widget footer-newsletter-widget widget ltn__search-widget ltn__newsletter-widget">
                            <h4 class="footer-title">Newsletter</h4>
                            <p>Subscribe to our weekly Newsletter and receive updates via email.</p>
                            <div class="footer-newsletter">
                                <form action="#">
                                    <input class="input-control" type="email" name="email" placeholder="Email*">
                                    <div class="btn-wrapper ">
                                        <button class="theme-btn-1 btn input-control-btn btn-news" type="submit">
                                            <i class="fas fa-location-arrow"></i>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</div>
<!--FAQs Area End-->

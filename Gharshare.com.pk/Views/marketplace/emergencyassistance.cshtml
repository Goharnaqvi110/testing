@using Gharshare.Models
@model List<StaticContent>
@{
    ViewData["Title"] = "Emergency Home Assistance";
}
<!-- BREADCRUMB AREA START -->
<div class="ltn__breadcrumb-area text-left bg-overlay-white-30 bg-image " data-bs-bg="/img/bg/14.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="page-title">
                        Emergency <span class="ltn__secondary-color-3">Home</span> Assistance
                    </h1>
                </div>
            </div>
        </div>
    </div>
</div>

<!--  Savings Calculator START  -->
<div class="ltn__about-us-area">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-6 align-self-center">
                <div class="about-us-info-wrap">
                    <div class="section-title-area ltn__section-title-2--- mb-20">

                        <h2>
                            <span class="ltn__secondary-color-3">Emergency </span>Home Assistance
                        </h2>
                        <p class="intro-paragraph">
                            We’d all love a world where drains never blocked, glass never
                            smashed, pipes never burst and keys never ‘disappeared’. Unfortunately, sometimes
                            emergencies happen. In this case, it’s always best to be
                            prepared.<br>&zwj;<br><strong>Smart Property</strong><span class="text-span-147">
                                <strong class="bold-text-97">Manager</strong>
                            </span> has partnered up with
                            <strong>ABC Emergency Home Assistance</strong> to take the stress out of finding
                            a tradesperson in times of need. Allianz Global Assistance will connect you with a
                            tradesperson for help with 10 common home emergencies, 24 hours a day, 7 days a
                            week.
                        </p>
                        <br>
                        @* <button type="submit" class="btn theme-btn-1">Find Out More</button> *@
                    </div>
                </div>
            </div>
            <div class="col-lg-6 align-self-center">
                <img src="~/img/publicsite/marketplace/emergency/emergency.webp">
            </div>
        </div>
    </div>
    <!--  Switch From Your Agent Kit END  -->
    <!--  Serivce AREA START  -->
    <div class="ltn__serivce-area ltn__product-gutter section-bg-1--- pt-115 pb-90 section-bg-1">
        <div class="container">
            <div class="row ">
                <div class="col-lg-12">
                    <div class="section-title-area ltn__section-title-2--- text-center">
                        <h1 class="section-title">
                            3 steps to get help
                        </h1>
                    </div>
                </div>
            </div>
            <div class="row ltn__category-slider-active--- slick-arrow-1 justify-content-center">
                <div class="col-lg-4 col-md-4 col-sm-6 col-6">
                    <div class="ltn__category-item ltn__category-item-5 text-center">
                        <a href="#">
                        <span class="category-icon">
                            <img src="~/img/publicsite/marketplace/emergency/emergencyoccurs_emergencyassistance.webp">
                        </span>
                        <h1>01</h1>
                        <span class="category-title">Emergency occurs</span>
                        <p class="">
                            One of the 10 emergencies listed below occurs at your home. Don’t worry
                            – Smart Property Manager has got you covered!
                        </p>
                        </a>
                    </div>
                </div>
                <div class="col-lg-4 col-md-4 col-sm-6 col-6">
                    <div class="ltn__category-item ltn__category-item-5 text-center">
                        <a href="shop.html">
                            <span class="category-icon">
                                <img src="~/img/publicsite/marketplace/emergency/247_emergencyassistance.webp">
                            </span>
                            <h1>02</h1>
                            <span class="category-title">
                                Call Allianz 24/7 support
                            </span>
                            <p>
                                Phone the 24/7 Emergency Home Assist number to be instantly connected with a
                                tradesperson.
                            </p>
                            <span class="category-btn"><i class="flaticon-right-arrow"></i></span>
                        </a>
                    </div>
                </div>
                <div class="col-lg-4 col-md-4 col-sm-6 col-6">
                    <div class="ltn__category-item ltn__category-item-5 text-center">
                        <a href="shop.html">
                            <span class="category-icon">
                                <img src="~/img/publicsite/marketplace/emergency/tradepersonarrive_emergencyassistance.webp">
                            </span>
                            <h1>03</h1>
                            <span class="category-title">Tradesperson arrives</span>
                            <p>
                                The tradesperson will arrive at your property for repairs or to ensure it is
                                safe.
                            </p>
                            <span class="category-btn"><i class="flaticon-right-arrow"></i></span>
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
<!-- Serivce AREA END  -->
<!-- FAQ AREA START (faq-2) (ID > accordion_2) -->
<div class="mb-100 mt-100">
    <h2 class="text-center mt-20">
        Frequently Asked <span class="ltn__secondary-color-3">Questions</span>
    </h2>
</div>
<div class="ltn__faq-area mb-100">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="ltn__faq-inner ltn__faq-inner-2">
                    <div id="accordion_2">
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var faq = Model[i];
                            <!-- card -->
                            <div class="card">
                                <h6 class="ltn__card-title collapsed" data-bs-toggle="collapse"
                                    data-bs-target="#faq-item-@i" aria-expanded="false">
                                    @faq.Heading
                                </h6>
                                <div id="faq-item-@i" class="collapse" data-bs-parent="#accordion_2" style="">
                                    <div class="card-body">
                                        <p>
                                            @Html.Raw(faq.LowerSection)
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <!-- card -->
                        }
                    </div>

                    @* <div class="need-support text-center mt-100">
                    <h2>Still need help? Reach out to support 24/7:</h2>
                    <div class="btn-wrapper mb-30">
                    <a href="contact.html" class="theme-btn-1 btn">Contact Us</a>
                    </div>
                    <h3 class="animated fadeIn"><i class="fas fa-phone"></i> +0123-456-789</h3>
                    </div> *@
                </div>
            </div>
            <div class="col-lg-4">
                <aside class="sidebar-area ltn__right-sidebar">
                    <!-- Newsletter Widget -->
                    <div class="section-bg-2">
                        <div class="footer-widget footer-newsletter-widget widget ltn__search-widget ltn__newsletter-widget">
                            <h4 class="footer-title">Newsletter</h4>
                            <p>Subscribe to our weekly Newsletter and receive updates via email.</p>
                            <div class="footer-newsletter">
                                <form action="#">
                                    <input class="input-control" type="email" name="email" placeholder="Email*">
                                    <div class="btn-wrapper ">
                                        <button class="theme-btn-1 btn input-control-btn btn-news" type="submit"><i class="fas fa-location-arrow"></i></button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>


                    <!-- Banner Widget -->
                    <div class="widget ltn__banner-widget">
                        <a href="shop.html"><img src="img/banner/banner-3.jpg" alt="Banner Image"></a>
                    </div>

                </aside>
            </div>
        </div>
    </div>
</div>

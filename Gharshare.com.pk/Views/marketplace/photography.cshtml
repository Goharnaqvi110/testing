@using Gharshare.Models
@model List<StaticContent>
@{
    ViewData["Title"] = "Property Photoshoot";
}
<!-- BREADCRUMB AREA START -->
<div class="ltn__breadcrumb-area text-left bg-overlay-white-30 bg-image " data-bs-bg="/img/bg/14.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="page-title">
                        Property <span class="ltn__secondary-color-3">Photoshoot</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</div>

<!--  Savings Calculator START  -->
<div class="ltn__about-us-area py-5">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-6 align-self-center">
                <div class="about-us-info-wrap">
                    <div class="section-title-area ltn__section-title-2--- mb-20">

                        <h2>
                            <span class="ltn__secondary-color-3">Professional </span>Property Photography
                        </h2>
                        <p class="intro-paragraph">
                            Want to attract more potential tenants, more enquiries, and
                            more clicks to your online property listing? Top notch property photos are a
                            critical first step to generate interest for your rental advertisement.
                            <br><br>Through <strong>Smart Property </strong><span class="text-span-148">
                                <strong class="bold-text-104">Manager</strong>
                            </span>, you can organise a
                            professional photo shoot with <strong>Snappr Photography</strong>, using the code
                            <span class="text-span-148"><strong>SPMPK</strong></span> for a 5%&nbsp;discount on
                            any home photography package.
                        </p>
                        <br>
                        <a href="#" class="btn theme-btn-1">Book Your Photo Shoot</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 align-self-center">
                <img src="~/img/publicsite/marketplace/photography/photoshoot.webp">
            </div>
        </div>
    </div>
</div>
<!--  Switch From Your Agent Kit END  -->
<!--  Serivce AREA START  -->
<div class="ltn__serivce-area ltn__product-gutter section-bg-1--- pt-115 pb-90 section-bg-1">
    <div class="container">
        <div class="row ">
            <div class="col-lg-12">
                <div class="section-title-area ltn__section-title-2--- text-center">
                    <h1 class="section-title">
                        4 steps to a property photoshoot
                    </h1>
                </div>
            </div>
        </div>
        <div class="row ltn__category-slider-active--- slick-arrow-1 justify-content-center">
            <div class="col-lg-3 col-md-4 col-sm-6 col-6">
                <div class="ltn__category-item ltn__category-item-5 text-center">
                    <a href="shop.html">
                        <span class="category-icon">
                            <img src="~/img/publicsite/marketplace/photography/book_phorography.webp">
                        </span>
                        <h1>01</h1>
                        <span class="category-title">Book</span>
                        <p class="">
                            Click here to book your photo shoot and provide some basic information about
                            your property and requirements.
                        </p>
                        <span class="category-btn"><i class="flaticon-right-arrow"></i></span>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6 col-6">
                <div class="ltn__category-item ltn__category-item-5 text-center">
                    <a href="shop.html">
                        <span class="category-icon">
                            <img src="~/img/publicsite/marketplace/photography/match_phorography.webp">
                        </span>
                        <h1>02</h1>
                        <span class="category-title">Match</span>
                        <p>In less than 1 minute, Snappr will match you with a photographer.</p>
                        <span class="category-btn"><i class="flaticon-right-arrow"></i></span>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6 col-6">
                <div class="ltn__category-item ltn__category-item-5 text-center">
                    <a href="shop.html">
                        <span class="category-icon">
                            <img src="~/img/publicsite/marketplace/photography/shoot_phorography.webp">
                        </span>
                        <h1>03</h1>
                        <span class="category-title">Shoot</span>
                        <p>
                            Your Snappr photographer will complete a full, professional photoshoot at your
                            property – at a time that suits you.
                        </p>
                        <span class="category-btn"><i class="flaticon-right-arrow"></i></span>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6 col-6">
                <div class="ltn__category-item ltn__category-item-5 text-center">
                    <a href="shop.html">
                        <span class="category-icon">
                            <img src="~/img/publicsite/marketplace/photography/recievephoto_phorography.webp">
                        </span>
                        <h1>04</h1>
                        <span class="category-title">Receive photos & advertise</span>
                        <p class="margin-bottom-0px">
                            You’ll get access to your photos within 48 hours and can
                            use these in your <strong>RentBetter</strong> rental advertisement.
                        </p>
                        <span class="category-btn"><i class="flaticon-right-arrow"></i></span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Serivce AREA END  -->
<!-- FAQ AREA START (faq-2) (ID > accordion_2) -->

<div class="mb-100 mt-100">
    <h2 class="text-center mt-20">Frequently Asked <span class="ltn__secondary-color-3">Questions</span></h2>
</div>

<div class="ltn__faq-area mb-100">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="ltn__faq-inner ltn__faq-inner-2">
                    <div id="accordion_2">
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var faq = Model[i];
                            <!-- card -->
                            <div class="card">
                                <h6 class="ltn__card-title collapsed" data-bs-toggle="collapse"
                                    data-bs-target="#faq-item-@i" aria-expanded="false">
                                    @faq.Heading
                                </h6>
                                <div id="faq-item-@i" class="collapse" data-bs-parent="#accordion_2" style="">
                                    <div class="card-body">
                                        <p>
                                            @Html.Raw(faq.LowerSection)
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <!-- card -->
                        }
                    </div>
                    @* <div class="need-support text-center mt-100">
                        <h2>Still need help? Reach out to support 24/7:</h2>
                        <div class="btn-wrapper mb-30">
                            <a href="contact.html" class="theme-btn-1 btn">Contact Us</a>
                        </div>
                        <h3><i class="fas fa-phone"></i> +0123-456-789</h3>
                    </div> *@
                </div>
            </div>
            <div class="col-lg-4">
                <aside class="sidebar-area ltn__right-sidebar">
                    <!-- Newsletter Widget -->
                    <div class="section-bg-2">
                        <div class="footer-widget footer-newsletter-widget widget ltn__search-widget ltn__newsletter-widget">
                            <h4 class="footer-title">Newsletter</h4>
                            <p>Subscribe to our weekly Newsletter and receive updates via email.</p>
                            <div class="footer-newsletter">
                                <form action="#">
                                    <input class="input-control" type="email" name="email" placeholder="Email*">
                                    <div class="btn-wrapper ">
                                        <button class="theme-btn-1 btn input-control-btn btn-news"
                                                type="submit">
                                            <i class="fas fa-location-arrow"></i>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</div>
<!-- FAQ AREA START -->

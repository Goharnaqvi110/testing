@using Gharshare.Models
@model List<StaticContent>

@{
    ViewData["Title"] = "Hire a Tradesperson";
}
<!-- BREADCRUMB AREA START -->
<div class="ltn__breadcrumb-area text-left bg-overlay-white-30 bg-image " data-bs-bg="/img/bg/14.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="page-title">
                        Hire a <span class="ltn__secondary-color-3">Tradesperson</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</div>

<!--  Savings Calculator START  -->
<div class="ltn__about-us-area">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-6 align-self-center">
                <div class="about-us-info-wrap">
                    <div class="section-title-area ltn__section-title-2--- mb-20">
                        <h2>
                            <span class="ltn__secondary-color-3">Hire </span>a Tradesperson
                        </h2>
                        <p class="intro-paragraph">
                            Need to hire a gardener? Find an emergency plumber? Track
                            down a local electrician? When self-managing your property, it’s important to have a
                            network of reliable tradespeople at your fingertips – just in case!<br><br>Luckily,
                            through <strong>Smart Property</strong><span class="text-span-149">
                                <strong class="bold-text-105">Manager</strong>
                            </span> in partnership with
                            <strong>abc.com</strong>, you’ll score immediate access to a vast
                            network of local tradies across Australia – including electricians, plumbers,
                            painters, gardeners, cleaners, plasterers, removalists, tilers and much more. <br>
                        </p>
                        <br>
                        <button type="submit" class="btn theme-btn-1">Find a Tradesperson</button>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 align-self-center">
                <img src="~/img/publicsite/marketplace/hire/hire-tradeperson.webp">
            </div>
        </div>
    </div>
</div>
<!--  Switch From Your Agent Kit END  -->
<!--  Serivce AREA START  -->
<div class="ltn__serivce-area ltn__product-gutter section-bg-1--- pt-115 pb-90 section-bg-1">
    <div class="container">
        <div class="row ">
            <div class="col-lg-12">
                <div class="section-title-area ltn__section-title-2--- text-center">
                    <h6 class="section-subtitle section-subtitle-2 ltn__secondary-color">Service</h6>
                    <h1 class="section-title">
                        4 steps to hiring a tradesperson
                    </h1>
                </div>
            </div>
        </div>
        <div class="row ltn__category-slider-active--- slick-arrow-1 justify-content-center">
            <div class="col-lg-3 col-md-4 col-sm-6 col-6">
                <div class="ltn__category-item ltn__category-item-5 text-center">                    
                        <span class="category-icon">
                            <img src="~/img/publicsite/marketplace/hire/search.webp">
                        </span>
                        <h1>01</h1>
                        <span class="category-title">Search for a tradesperson</span>
                        <p class="">
                            Search by what kind of tradesperson you’re after (tiler, cleaner,
                            electrician etc.) in your particular suburb or postcode.
                        </p>                         
                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6 col-6">
                <div class="ltn__category-item ltn__category-item-5 text-center">                     
                        <span class="category-icon">
                            <img src="~/img/publicsite/marketplace/hire/setup-job.webp">
                        </span>
                        <h1>02</h1>
                        <span class="category-title">Set-up your job</span>
                        <p>
                            Share some details about your job and attach photos if available. Confirm when you
                            need the job done e.g. urgently, this week, on a particular date.
                        </p>
                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6 col-6">
                <div class="ltn__category-item ltn__category-item-5 text-center">
                    <span class="category-icon">
                        <img src="~/img/publicsite/marketplace/hire/receive-quotes.webp">
                    </span>
                    <h1>03</h1>
                    <span class="category-title">Receive quotes</span>
                    <p>
                        You will receive prices and quotes from local professional tradies based on your
                        suburb and job requirements.
                    </p>

                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6 col-6">
                <div class="ltn__category-item ltn__category-item-5 text-center">
                    <span class="category-icon">
                        <img src="~/img/publicsite/marketplace/hire/select.webp">
                    </span>
                    <h1>04</h1>
                    <span class="category-title">Select your tradie</span>
                    <p>
                        Compare quotes and decide on the best person for the job. Finalise the time and
                        details with your tenant. Easy!
                    </p>
                    @* <span class="category-btn"><i class="flaticon-right-arrow"></i></span> *@
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Serivce AREA END  -->
<!-- FAQ AREA START (faq-2) (ID > accordion_2) -->

<div class="mb-100 mt-100">
    <h2 class="text-center mt-20">Frequently Asked <span class="ltn__secondary-color-3">Questions</span></h2>
</div>

<div class="ltn__faq-area mb-100">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="ltn__faq-inner ltn__faq-inner-2">
                    <div id="accordion_2">
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var faq = Model[i];
                            <!-- card -->
                            <div class="card">
                                <h6 class="ltn__card-title collapsed" data-bs-toggle="collapse"
                                    data-bs-target="#faq-item-@i" aria-expanded="false">
                                    @faq.Heading
                                </h6>
                                <div id="faq-item-@i" class="collapse" data-bs-parent="#accordion_2" style="">
                                    <div class="card-body">
                                        <p>
                                            @Html.Raw(faq.LowerSection)
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <!-- card -->
                        }
                    </div>
                    @* <div class="need-support text-center mt-100">
                    <h2>Still need help? Reach out to support 24/7:</h2>
                    <div class="btn-wrapper mb-30">
                    <a href="contact.html" class="theme-btn-1 btn">Contact Us</a>
                    </div>
                    <h3><i class="fas fa-phone"></i> +0123-456-789</h3>
                    </div> *@
                </div>
            </div>
            <div class="col-lg-4">
                <aside class="sidebar-area ltn__right-sidebar">
                    <!-- Newsletter Widget -->
                    <div class="section-bg-2">
                        <div class="footer-widget footer-newsletter-widget widget ltn__search-widget ltn__newsletter-widget">
                            <h4 class="footer-title">Newsletter</h4>
                            <p>Subscribe to our weekly Newsletter and receive updates via email.</p>
                            <div class="footer-newsletter">
                                <form action="#">
                                    <input class="input-control" type="email" name="email" placeholder="Email*">
                                    <div class="btn-wrapper ">
                                        <button class="theme-btn-1 btn input-control-btn btn-news"
                                                type="submit">
                                            <i class="fas fa-location-arrow"></i>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>


                    <!-- Banner Widget -->
                    <div class="widget ltn__banner-widget">
                        <a href="shop.html"><img src="img/banner/banner-3.jpg" alt="Banner Image"></a>
                    </div>

                </aside>
            </div>
        </div>
    </div>
</div>
<!-- FAQ AREA START -->

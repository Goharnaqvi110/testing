@{
    ViewData["Title"] = "Marketplace";
}
<!-- BREADCRUMB AREA START -->
<div class="ltn__breadcrumb-area text-left bg-overlay-white-30 bg-image " data-bs-bg="img/bg/14.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="page-title">
                        <span class="ltn__secondary-color-3">Marketplace</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- BREADCRUMB AREA END -->
<!-- ABOUT feature AREA START -->
<div class="ltn__about-feature-area pb-90">
    <div class="container">
        <div class="col-xl-12">
            <div class="section-title-area ltn__section-title-2--- text-center">
                <h2 class="animated fadeIn ms-4 mb-0">
                    Explore our <span class="ltn__secondary-color-3">
                        partner services
                    </span> where you can book an inspection, find a tradie or even
                    landlord insurance, all in the one place!
                </h2>
            </div>
        </div>
        <div class="row mb-5" id="feature1">
            <div class="col-lg-12 bg-white">
                <div class="row  justify-content-center">
                    <div class="col-sm-4 col-12">
                        <div class="ltn__feature-item ltn__feature-item-4 text-center bg-white  box-shadow-1 ">
                            <div class="ltn__feature-icon">
                                <img src="/img/publicsite/marketplace/conditionreport/bookreport.webp"
                                     width="120" alt="#">
                            </div>
                            <div class="ltn__feature-info">
                                <h4>
                                    Book a condition report
                                </h4>
                                <p>
                                    Hire a pro to complete a condition report at entry, exit or as a routine
                                    inspection during the lease.
                                </p> <br>
                                <a class="ltn__service-btn" href="marketplace/bookconditionreport">
                                    Learn more <i class="flaticon-right-arrow"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 col-12">
                        <div class="ltn__feature-item ltn__feature-item-4 text-center bg-white  box-shadow-1 active">
                            <div class="ltn__feature-icon">
                                <img src="/img/publicsite/toolkit/savingcalculator.webp" width="120" alt="#">
                            </div>
                            <div class="ltn__feature-info">
                                <h4>
                                    Property Viewings
                                </h4>
                                <p>
                                    Need to run an open home or show your property but can't be there for the inspection
                                    times? No problem! You can book a pro to do it for you.
                                </p>
                                <a class="ltn__service-btn" href="marketplace/bookinspection">
                                    Learn more <i class="flaticon-right-arrow"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 col-12">
                        <div class="ltn__feature-item ltn__feature-item-4 text-center bg-white  box-shadow-1 ">
                            <div class="ltn__feature-icon">
                                <img src="/img/publicsite/toolkit/switchkit.webp" width="120" alt="#">
                            </div>
                            <div class="ltn__feature-info">
                                <h4>
                                    Hire a tradeperson
                                </h4>
                                <p>
                                    Need to hire a gardener? Find an emergency plumber? Track down a local electrician?
                                    When self-managing your property, it’s important to have a network of reliable
                                    tradespeople at your fingertips – just in case!
                                </p>
                                <a class="ltn__service-btn" href="marketplace/hiretradeperson">
                                    Learn more <i class="flaticon-right-arrow"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 col-12">
                        <div class="ltn__feature-item ltn__feature-item-4 text-center bg-white  box-shadow-1 active">
                            <div class="ltn__feature-icon">                                 
                                <img src="/img/publicsite/toolkit/ebook.webp" width="120" alt="#">
                            </div>
                            <div class="ltn__feature-info">
                                <h4>
                                    Property Photography
                                </h4>
                                <p>
                                    Want to attract more potential tenants, more enquiries, and more clicks
                                    to your online property listing? Top notch property photos are a critical first
                                    step to generate interest for your rental advertisement.
                                </p>
                                <a class="ltn__service-btn" href="marketplace/photography">
                                    Learn more <i class="flaticon-right-arrow"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 col-12">
                        <div class="ltn__feature-item ltn__feature-item-4 text-center bg-white  box-shadow-1 active">
                            <div class="ltn__feature-icon">
                                <!-- <span><i class="flaticon-house-3"></i></span> -->
                                <img src="/img/publicsite/toolkit/faq.webp" width="120" alt="#">
                            </div>
                            <div class="ltn__feature-info">
                                <h4>
                                    Emergency Assistance
                                </h4>
                                <p class="p1 feature">
                                    We’d all love a world where drains never blocked, glass never smashed,
                                    pipes never burst and keys never ‘disappeared’. Unfortunately,
                                    sometimes emergencies happen. In this case, it’s always best to be prepared.
                                </p>
                                <a class="ltn__service-btn" href="marketplace/emergencyassistance">
                                    Learn more <i class="flaticon-right-arrow"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 col-12">
                        <div class="ltn__feature-item ltn__feature-item-4 text-center bg-white  box-shadow-1 active">
                            <div class="ltn__feature-icon">
                                <img src="/img/publicsite/toolkit/blog.webp" width="120" alt="#">
                            </div>
                            <div class="ltn__feature-info">
                                <h4>
                                    Landlord Insurance
                                </h4>
                                <p class="p1 feature">
                                    Investing in property can be a rewarding experience which is designed to build wealth and stability
                                    for your future. As with any investment, there is an element of risk;however, you can reduce this by
                                    covering your property with Landlord's Insurance.
                                </p>
                                <a class="ltn__service-btn" href="marketplace/landlordinsurance">
                                    Learn more <i class="flaticon-right-arrow"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ABOUT feature AREA END -->

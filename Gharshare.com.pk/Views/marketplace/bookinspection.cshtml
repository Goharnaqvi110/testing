<!-- BREADCRUMB AREA START -->
<div class="ltn__breadcrumb-area text-left bg-overlay-white-30 bg-image " data-bs-bg="/img/bg/14.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="page-title">
                        Book <span class="ltn__secondary-color-3">Property</span> Inspection
                    </h1>
                </div>
            </div>
        </div>
    </div>
</div>

<!--  Savings Calculator START  -->
<div class="ltn__about-us-area">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-6 align-self-center">
                <div class="about-us-info-wrap">
                    <div class="section-title-area ltn__section-title-2--- mb-20">
                        <h2>
                            <span class="ltn__secondary-color-3">Book </span>Property Viewings
                        </h2>
                        <p class="intro-paragraph-copy">
                            Property viewings (also known as open inspections) are
                            an essential part of being able to market your home. <br><br>Inspections are the
                            most effective way to showcase your property but they can be time-consuming and
                            challenging, especially if you've got a busy schedule or are not located near your
                            property.
                        </p>
                        <br>
                        <a href="/register" class="btn theme-btn-1">Sign Up & Book Now</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 align-self-center">
                <img src="/img/publicsite/marketplace/propertyviewing/book.webp" />
            </div>
        </div>
    </div>
</div>
<!--  Switch From Your Agent Kit END  -->


@using Gharshare.Models
@model List<StaticContent>
@{
    ViewData["Title"] = "Tax Depreciation Schedule";
}
<!-- BREADCRUMB AREA START -->
<div class="ltn__breadcrumb-area text-left bg-overlay-white-30 bg-image " data-bs-bg="/img/bg/14.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="page-title">
                        Tax <span class="ltn__secondary-color-3">Depreciation</span> Schedule
                    </h1>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container">
                <div class="row mb-5">
                    <div class="col-lg-6 align-self-center">
                        <div class="about-us-info-wrap">
                            <div class="section-title-area ltn__section-title-2--- mb-20">

                                <h2> Tax <span class="ltn__secondary-color-3"> Depreciation Schedule</span>
                                </h2>
                                <p class="intro-paragraph">A depreciation schedule is a document that contains
                                    information about your building and forecasts how certain components, such as
                                    fixtures, fittings, and common areas, will lose value over time. <br><br>It
                                    essentially outlines the exact amount of depreciation tax deductions that you are
                                    entitled to claim on your rental property investment. The depreciation schedule will
                                    be used by your accountant to file a claim with the Australian Taxation Office on
                                    your behalf. <br><br>Find out how you can get a quote in 2 easy steps below.</p>
                                   @*  <button class="btn theme-btn-1">  <a href="https://www.rapidbuildinginspections.com.au/sample-report-download" target="_blank" class="button-secondary w-button">See Sample Report</a></button> *@

                                    <a href="#" class="btn theme-btn-1">Find Better Deal</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 align-self-center">
            <img src="~/img/publicsite/marketplace/tax/tax.webp" />
                    </div>
                </div>
            </div>
            <!--  Switch From Your Agent Kit END  -->

            <!--  Serivce AREA START  -->
            <div class="ltn__serivce-area ltn__product-gutter section-bg-1--- pt-115 pb-90 section-bg-1">
                <div class="container">
                    <div class="row ">
                        <div class="col-lg-12">
                            <div class="section-title-area ltn__section-title-2--- text-center">
                                <h1 class="section-title">2 easy steps to your Tax Depreciation quote
                                </h1>
                            </div>
                        </div>
                    </div>
                    <div class="row ltn__category-slider-active--- slick-arrow-1 justify-content-center">
                        <div class="col-lg-6 col-md-4 col-sm-6 col-6">
                            <div class="ltn__category-item ltn__category-item-5 text-center">
                                <a href="#">
                                    <span class="category-icon">
                            <img src="~/img/publicsite/marketplace/tax/enterdetails.webp" />
                                    </span>
                                    <h1>01</h1>
                                    <span class="category-title">Enter details</span>
                                    <p>Click a Get a Quote to book your Tax Depreciation Schedule and provide some basic information about your property and requirements.</p>
                                    <span class="category-btn"><i class="flaticon-right-arrow"></i></span>
                                </a>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-4 col-sm-6 col-6">
                            <div class="ltn__category-item ltn__category-item-5 text-center">
                                <a href="#">
                                    <span class="category-icon">
                            <img src="~/img/publicsite/marketplace/tax/getquote.webp" />
                                    </span>
                                    <h1>02</h1>
                                    <span class="category-title">Receive quote
                                    </span>
                                    <p>After you submit the information, you will receive an email with a quote for the schedule.

                                    </p>
                                    @* <span class="category-btn"><i class="flaticon-right-arrow"></i></span> *@
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Serivce AREA END  -->
<!-- FAQ AREA START (faq-2) (ID > accordion_2) -->

<div class="mb-100 mt-100">
    <h2 class="text-center mt-20">Frequently Asked <span class="ltn__secondary-color-3">Questions</span></h2>
</div>

<div class="ltn__faq-area mb-100">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="ltn__faq-inner ltn__faq-inner-2">
                    <div id="accordion_2">
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var faq = Model[i];
                            <!-- card -->
                            <div class="card">
                                <h6 class="ltn__card-title collapsed" data-bs-toggle="collapse"
                                    data-bs-target="#faq-item-@i" aria-expanded="false">
                                    @faq.Heading
                                </h6>
                                <div id="faq-item-@i" class="collapse" data-bs-parent="#accordion_2" style="">
                                    <div class="card-body">
                                        <p>
                                            @Html.Raw(faq.LowerSection)
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <!-- card -->
                        }
                    </div>
                    @* <div class="need-support text-center mt-100">
                    <h2>Still need help? Reach out to support 24/7:</h2>
                    <div class="btn-wrapper mb-30">
                    <a href="contact.html" class="theme-btn-1 btn">Contact Us</a>
                    </div>
                    <h3><i class="fas fa-phone"></i> +0123-456-789</h3>
                    </div> *@
                </div>
            </div>
            <div class="col-lg-4">
                <aside class="sidebar-area ltn__right-sidebar">
                    <!-- Newsletter Widget -->
                    <div class="section-bg-2">
                        <div class="footer-widget footer-newsletter-widget widget ltn__search-widget ltn__newsletter-widget">
                            <h4 class="footer-title">Newsletter</h4>
                            <p>Subscribe to our weekly Newsletter and receive updates via email.</p>
                            <div class="footer-newsletter">
                                <form action="#">
                                    <input class="input-control" type="email" name="email" placeholder="Email*">
                                    <div class="btn-wrapper ">
                                        <button class="theme-btn-1 btn input-control-btn btn-news"
                                                type="submit">
                                            <i class="fas fa-location-arrow"></i>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</div>
<!-- FAQ AREA START -->
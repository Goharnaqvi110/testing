@model Gharshare.Models.StaticContent
@{
    ViewData["Title"] = "Refund & Returns Policy";
}

<div class="mb-100">
    <h2 class="text-center mt-20">Refund & Returns Policy</h2>
</div>
<div class="ltn__faq-area mb-100">
    <div class="container">
        <div class="row">
            <p>
                If for any reason you
                are not completely satisfied with your purchase we will give you a 3 day money-back guarantee
                from the time you post your ad. <br><br>Please email us at <a class="ltn__secondary-color-3"
                                                                              href="mailto:info@smartpropertymanager.pk?subject=Website%20contact">info@smartpropertymanager.pk</a>
                within that time if you are not satisfied with your purchase so that we can resolve any
                problems.<br><br>This refund policy does not apply to ads which have been published and reviewed
                as expected, received enquiries and applications, or for which a tenant has been signed even if
                the tenant was secured using another service or agent. <br><br>Where a customer has paid for an
                ad and not responded to verification requests in a timely manner, a refund will not be offered.
                Where a purchase has been made and a refund has been requested, a Rs 500/ processing fee will be
                charged.  
            </p>            
        </div>
    </div>
</div>


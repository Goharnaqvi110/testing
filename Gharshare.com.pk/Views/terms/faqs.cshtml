@model Gharshare.Models.StaticContent
@{
    ViewData["Title"] = "Frequently Asked Questions";
}
<!-- BREADCRUMB AREA START -->
<div class="ltn__breadcrumb-area text-left bg-overlay-white-30 bg-image " data-bs-bg="/img/bg/14.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="page-title">
                        Frequently <span class="ltn__secondary-color-3">Asked</span> Questions                         
                    </h1>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="ltn__faq-area mb-100">
    <div class="container">
        <div class="row">
            <p>
                <strong>What is Smart Property Manager?</strong><br />
                Smart Property Manager is a platform for property owners who want to cut out the middleman and 
                maximise their return on investment by renting out or selling their property themselves.
                We help landlords to find new tenants or sell their property by advertising their properties on
                Pakistan’s most popular property websites. We also help to facilitate the enquiry and application
                process to make leasing and selling properties as stress-free as possible.
            </p>
            <p>
                <strong>What type of properties can I list?</strong><br />
                 for residential or commercial property owners who are looking for quality tenants or to sell their
                 properties.Unfortunately, we are unable to list individual rooms in shared houses or short-term holiday rentals.
            </p>
            <p>
                <strong>How do I get started?</strong><br />
                Simply click on the Get Started button to set up an account, then add the details of your property 
                and you’re ready to go!

            </p>
            <p>
                <strong>How secure is my information?</strong><br />
                The privacy and security of members is a priority for us at SPM.
                High-security measures are enforced in order to maintain the security and integrity of customer information. 
                Administrative access is restricted to only a small number of approved employees.A username and password are 
                required to authenticate all users and security measures are in place to verify all password changes.
            </p>
            <p>
                <strong>How long does it take for my ad to go up?</strong><br />
                Once the ad has been submitted, our team will review it to make sure nothing critical is missing and 
                the ad will be published within 2 to 4 hours of paying and verifying your property.
            </p>
            <p>
                <strong>Will I get confirmation that my ad has been posted?</strong><br />
                Once your ad has been published, you will receive a confirmation email 
                from us with the link to the online ad and an overview of the next steps.
            </p>
            <p>
                <strong>Can I edit and make changes to my ad once it has been submitted?</strong><br />
                Yes, just log back in and select ‘edit ad’ from the ‘My Properties’ page. We want you to be 
                happy with your ad, so you can make as many changes as you like for no additional cost.
                Once the changes have been saved, they will be reviewed by our team and your ad will be updated within 2 to 4 hours.
            </p>
            <p>
                <strong></strong><br />
            </p>

        </div>
    </div>
</div>


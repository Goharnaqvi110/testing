@using Microsoft.AspNetCore.Identity
@using Gharshare.Models
@using Gharshare.CommonHelper
@model PropertyVM
@inject UserManager<ApplicationUser> userManager;
@{
    ViewData["Title"] = "Edit Property";
    if (User.IsInRole(WebSiteRoles.Role_Admin))
    {
        Layout = "_Layout_1";
    }
    else if (User.IsInRole(WebSiteRoles.Role_Landlord))
    {
        Layout = "_LayoutLandlord";
    }
}
<div class="container" style="padding:40px;">
    <div class="col-md-12">
        <h1>Edit Your Ad</h1>
    </div>
    <form method="Post" asp-action="Editad" enctype="multipart/form-data">
        <input type="hidden" id="cover" asp-for=Property.CoverImage value="@Model.Property.CoverImage" />
        <input type="hidden" id="PID" asp-for=Property.ID value="@Model.Property.ID" />
        <input type="hidden" id="SID" asp-for=Landlord.StateID value="@Model.Landlord.StateID" />
        <input type="hidden" id="CID" asp-for=Landlord.CityID value="@Model.Landlord.CityID" />
        <input type="hidden" id="OID" asp-for=Property.OwnerId value="@Model.Property.OwnerId" />
        @*<input type="hidden" asp-for=Property.CityID value="@Model.Property.CityID" />
        <input type="hidden" asp-for=Property.StateID value="@Model.Property.StateID" />*@
        <input type="hidden" asp-for=@Model.Property.IsAdcreated />

        <strong class="text-center">Property Address</strong><hr />
        <div class="row">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <label>Landlord Name</label>
            <select asp-for="Landlord.Id" asp-items="Model.Landlords" class="form-control">
                <option selected="selected" disabled>--Select Landlord--</option>
            </select>
            <span asp-validation-for="Landlord.Id" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-4 form-floating p-1">
                <label asp-for="Property.Suburb">Unit No</label>
                <input type="text" readonly asp-for="Property.UnitNo" class="form-control" aria-required="true" />
                
            </div>
            <div class="col-md-4 form-floating p-1">
                <label asp-for="Property.Street">Street</label>
                <input type="text" readonly asp-for="Property.Street" class="form-control" aria-required="true" />
                
            </div>
            <div class="col-md-4 form-floating p-1">
                <label asp-for="Property.Suburb">Suburb</label>
                <input type="text" readonly asp-for="Property.Suburb" class="form-control" aria-required="true" />
                
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 form-floating p-1">
                <label>Province</label>
                <select id="state" asp-for="Property.StateID" asp-items=@Model.States  class="form-control">
                    <option selected="selected" value="">--Select Province--</option>
                </select>
                    <span asp-validation-for="Property.StateID" class="text-danger"></span>
            </div>
            <div class="col-md-4 form-floating p-1">
                <label>City</label>
                <select id="city" asp-for="Property.CityID" asp-items="Model.Cities" class="form-control">
                </select>
            </div>

            <div class="col-md-4 form-floating p-1">
                <label>Postcode</label>
                <input type="text" readonly asp-for="Property.PostalCode" class="form-control" aria-required="true" />
                <label asp-for="Property.PostalCode">PostalCode</label>
            </div>
        </div>
        <div class="row">
            <div class="custom-file p-1 col-md-12">
                @Html.CheckBoxFor(m =>m.Property.HideAddress)
                <label>Check this box if you wish to hide your address, and display suburb only</label>
            </div>
        </div>
        <strong class="text-center">Property Details</strong><hr />
        <div class="row">
            <div class="col-md-4 form-floating p-1">
                <label>Property Type</label>
                @*<select id="propertytype" class="form-control" asp-for="Property.Type">
                    <option selected="selected" value="">--Select type--</option>
                    <option value="Apartment">Apartment</option>
                    <option value="House">House</option>
                    <option value="Studio">Studio</option>
                    <option value="Terrace/Semi">Terrace/Semi</option>
                    <option value="Townhouse">Townhouse</option>
                    <option value="Unit">Unit</option>
                    <option value="Villa">Villa</option>
                </select>*@
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 form-floating p-1">
                <label asp-for="Property.Bed">Bed Room</label>
                <input type="text" asp-for="Property.Bed" class="form-control" required="" aria-required="true" />
                
                <span asp-validation-for="Property.Bed" class="text-danger"></span>
            </div>
            <div class="col-md-4 form-floating p-1">
                <label asp-for="Property.Bathroom">Bathroom</label>
                <input type="text" asp-for="Property.Bathroom" class="form-control" required="" autocomplete="Name" aria-required="true" />
                
                <span asp-validation-for="Property.Bathroom" class="text-danger"></span>
            </div>
            <div class="col-md-4 form-floating p-1">
                <label asp-for="Property.TotalArea">Total Area(m<sup>2</sup>)</label>
                <input type="text" asp-for="Property.TotalArea" class="form-control" aria-required="true" />
                
                <span asp-validation-for="Property.TotalArea" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 form-floating p-1">
                @*<label asp-for="Property.ParkingType">Parking Type</label>
                <input type="text" asp-for="Property.ParkingType" class="form-control" required="" aria-required="true" />
                
                <span asp-validation-for="Property.ParkingType" class="text-danger"></span>*@
            </div>
            <div class="col-md-4 form-floating p-1">
                <label asp-for="Property.TotalParkings">TotalParkings</label>
                <input type="text" asp-for="Property.TotalParkings" class="form-control" aria-required="true" />
                
                <span asp-validation-for="Property.TotalParkings" class="text-danger"></span>
            </div>
            <div class="col-md-4 form-floating p-1">
                <label asp-for="Property.AvailableFrom">Available From</label>
                <input type="text" id="datepicker" readonly asp-for="Property.AvailableFrom" class="form-control datepicker" aria-required="true" />
                
                <span asp-validation-for="Property.AvailableFrom" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 form-floating p-1">
                <label asp-for="Property.Rent">Weekly Rent</label>
                <input type="text" asp-for="Property.Rent" class="form-control" required="" aria-required="true" />
                
                <span asp-validation-for="Property.Rent" class="text-danger"></span>
            </div>
            <div class="col-md-4 form-floating p-1">
                <label asp-for="Property.BondValue">Bond Value</label>
                <input type="text" asp-for="Property.BondValue" class="form-control" required="" aria-required="true" />
                
                <span asp-validation-for="Property.BondValue" class="text-danger"></span>
            </div>
            <div class="col-md-4 form-floating p-1">
                @*<label asp-for="Property.MinimumStay">Minimum Stay in Week(s)</label>
                <input type="text" asp-for="Property.MinimumStay" class="form-control" required="" aria-required="true" />
                
                <span asp-validation-for="Property.MinimumStay" class="text-danger"></span>*@
            </div>
        </div>
        <div class="row">
            <div class="custom-file p-1">
                @Html.CheckBoxFor(m =>m.Property.HidePrice)
                <label>Hide price and display "Contact for Price"</label>
            </div>
        </div>
        <div clas="row">
            <div class="form-floating p-1">
                <label asp-for="Property.GoogleMapEmbedAPIURL">Google map embed code</label>
                <input type="text" asp-for="Property.GoogleMapEmbedAPIURL" class="form-control" aria-required="true" />
                
            </div>
            <div class="form-floating p-1">
            </div>
            @if (User.IsInRole(WebSiteRoles.Role_Admin))
            {
                <div class="custom-file p-1">
                    @Html.CheckBoxFor(m => m.Property.IsActive)
                    <label>Show on public site?</label>
                </div>
            }
            <div class="custom-file p-1">
                @Html.CheckBoxFor(m => m.Property.IsRented)
                <label>Is rented out?</label>
            </div>
            <div class="custom-file p-1">
                @Html.CheckBoxFor(m => m.Property.IsRentedWhole)
                <label>Rented out as whole?</label>
            </div>
            <div class="custom-file p-1">
                @Html.CheckBoxFor(m =>m.Property.RoomAvailable)
                <label>Room Avilable?</label>
            </div>
            <div class="custom-file p-1">
                @Html.CheckBoxFor(m =>m.Property.HideAddress)
                <label>Hide Address?</label>
            </div>
        </div><hr />
        <strong>Features</strong>
        <div class="row">
            @for (int i = 0; i < @Model.PropertyFeatures.Count(); i++)
            {
                <div class="col-md-3 btn-group">
                    <div class="p-1">
                        <input type="hidden" asp-for=@Model.PropertyFeatures[i].FeatureID />
                        <input type="hidden" asp-for=@Model.PropertyFeatures[i].PropertyID />
                        <input type="hidden" asp-for=@Model.PropertyFeatures[i].ID />
                        <input type="checkbox" id=@Model.PropertyFeatures[i].FeatureID asp-for=@Model.PropertyFeatures[i].isSelected />
                    </div>
                    <div class="p-1">
                        <label asp-for=@Model.PropertyFeatures[i].Feature.Title> @Model.PropertyFeatures[i].Feature.Title</label>
                    </div>
                </div>
            }
        </div>
        <strong>Property Images</strong>
        <div id="divimg">
            <div class="row">
                @for (int i = 0; i < @Model.PropertyImages.Count(); i++)
                {
                    <div class="col-md-3">
                        <div class="p-1">
                            <img src="@Model.PropertyImages[i].ImagePath" style="height:150px; width:180px" alt="" class="img-a img-fluid">
                        </div>
                        <div class="p-1">
                            <a href="#" id=@Model.PropertyImages[i].ID onclick="DeletePropertyImage(this.id);">
                                Click here to delete picture
                                <span class="bi bi-chevron-right"></span>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 form-floating p-1">
                <input id="filecoverImage" type="file" name="filecoverImage" class="pb-2" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 form-floating p-1">
                <input id="files" multiple type="file" name="files" class="pb-2" />
            </div>
        </div>
        <strong>Acceptings</strong><hr />
        <div class="row">
            @for (int i = 0; i < @Model.PropertyAcceptings.Count(); i++)
            {
                <div class="col-md-3 btn-group">
                    <div class="p-1">
                        <input type="hidden" asp-for=@Model.PropertyAcceptings[i].AcceptingID />
                        <input type="hidden" asp-for=@Model.PropertyAcceptings[i].PropertyID />
                        <input type="hidden" asp-for=@Model.PropertyAcceptings[i].ID />
                        <input type="checkbox" id=@Model.PropertyAcceptings[i].AcceptingID asp-for=@Model.PropertyAcceptings[i].isSelected />
                    </div>
                    <div class="p-1">
                        <label asp-for=@Model.PropertyAcceptings[i].Accepting.Title> @Model.PropertyAcceptings[i].Accepting.Title</label>
                    </div>
                </div>
            }
        </div>
        <div class="row">
            <div class="col-md-12 form-floating p-1">
                <label>Advertisement Title</label>
                <input type="text" asp-for="Property.AdTitle" class="form-control" aria-required="true" />
                
                <span asp-validation-for="Property.AdTitle" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 form-floating p-1">
                <label asp-for="Property.Description">About the property</label>
                <textarea id="Description" asp-for="Property.Description" class="form-control" cols="45" rows="16" placeholder="Description" required="" style="Height:235px;"></textarea>
                
                <span asp-validation-for="Property.Description" class="text-danger"></span>
            </div>
        </div>
        <strong class="text-center">Property Viewing inspection times</strong><hr />
        @for (int i = 0; i < @Model.Inspections.Count(); i++)
        {
            <input type="hidden" asp-for="Inspections[i].ID" />
            <input type="hidden" asp-for="Inspections[i].PropertyID" />
            <div class="row">
                <div class="col-md-4 form-floating p-1">
                    <label>Inspection Date</label>
                    <input type="date" asp-for="Inspections[i].InspectionDate" class="form-control" aria-required="true" />
                    <span asp-validation-for="Inspections[i].InspectionDate" class="text-danger"></span>
                </div>
                <div class="col-md-4 form-floating p-1">
                    <label>From</label>
                    <select class="form-control" asp-for=Inspections[i].From>
                        <option value="">--Select time--</option>
                        <option value="10:00 AM">10:00 AM</option>
                        <option value="11:00 AM">11:00 AM</option>
                        <option value="11:15 AM">11:15 AM</option>
                        <option value="10:15 AM">10:15 AM</option>
                        <option value="6:00 AM">6:00 AM</option>
                        <option value="6:15 AM">6:15 AM</option>
                        <option value="6:30 AM">6:30 AM</option>
                        <option value="6:45 AM">6:45 AM</option>
                        <option value="7:00 AM">7:00 AM</option>
                    </select>
                </div>
                <div class="col-md-4 form-floating p-1">
                    <label>To</label>
                    <select class="form-control" asp-for=Inspections[i].To>
                        <option value="">--Select time--</option>
                        <option value="11:30 AM">11:30 AM</option>
                        <option value="11:15 AM">11:15 AM</option>
                        <option value="10:15 AM">10:15 AM</option>
                        <option value="7:00 AM">7:00 AM</option>
                        <option value="6:00 AM">6:00 AM</option>
                        <option value="6:15 AM">6:15 AM</option>
                        <option value="6:30 AM">6:30 AM</option>
                        <option value="6:45 AM">6:45 AM</option>
                        <option value="7:00 AM">7:00 AM</option>
                    </select>
                </div>
            </div>
        }
        <strong class="text-center">Your Details</strong><hr />
        <div class="row">
            <div class="col-md-4 form-floating p-1">
                <label asp-for="Property.OwnerName">Owner Name</label>
                <input type="text" asp-for="Property.OwnerName" class="form-control" required="" aria-required="true" />
                
                <span asp-validation-for="Property.OwnerName" class="text-danger"></span>
            </div>
            <div class="col-md-4 form-floating p-1">
                <label asp-for="Property.Owner">Owner Email</label>
                <input type="text" asp-for="Property.Owneremail" class="form-control" required="" aria-required="true" />
                
                <span asp-validation-for="Property.Owneremail" class="text-danger"></span>
            </div>
            <div class="col-md-4 form-floating p-1">
                <label asp-for="Property.Ownermobile">Owner Mobile</label>
                <input type="text" asp-for="Property.Ownermobile" class="form-control" required="" aria-required="true" />
                
                <span asp-validation-for="Property.Ownermobile" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            If someone calls RentBetter about your property:
        </div>
        <div class="row">
            <div class="custom-file p-1">
                @Html.RadioButtonFor(m =>m.Property.SharePhone,true)
                <label>Please give them my phone number and ask them to contact me"</label>
            </div>
        </div>
        <div class="row">
            <div class="custom-file p-1">
                @Html.RadioButtonFor(m =>m.Property.SharePhone,false)
                <label>Please capture their name and number and email me their details</label>
            </div>
        </div>
        <div class="row">
            <span>Acknowledgement</span>
            <div class="custom-file p-1">
                @Html.CheckBoxFor(m =>m.Property.IsOnwnerOrAuthorized)
                <label>I acknowledge that I am the owner or am authorized to rent out this property and can provide evidence if required.</label>
            </div>
            <div class="custom-file p-1">
                @Html.CheckBoxFor(m =>m.Property.IsAdlive)
                <label>I am ready for my ads to go live on the property sites which will appear in the public domain</label>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <button type="submit" onclick="return Validate()" class="w-100 btn btn-primary">Update Ad</button>
            </div>
            <div class="col-md-6">
                <a asp-action="List" class="w-50 btn btn-secondary">Go back to List</a>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_dtpPartial" />
    <partial name="_GoogleAutocompAddPartial" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/PopulateDropdownList.js" type="text/javascript"></script>
    <script type="text/javascript">

        var DeletePropertyImage = function(ID) {
            var ImageID = ID;
            var PID = document.getElementById('PID').value;

            $.ajax({
                url: '/Property/DeletePropertyImage',
                type: "POST",
                dataType: "JSON",
                data: { ID: ImageID },
                success: function(response) {
                    // window.location = "https://www.aspsnippets.com/";
                    // window.location = "/Property/editad/1";
                    window.location.reload();
                }
            })
        }

    </script>
    <script type="text/javascript">

        var DeleteCoverImage = function() {
            var PID = document.getElementById('PID').value;


            $.ajax({
                url: '/Property/DeleteCover',
                type: "POST",
                dataType: "JSON",
                data: { ID: PID },
                success: function(response) {
                    // window.location = "https://www.aspsnippets.com/";
                    window.location = "/Property/PropertyPics/" + PID.toString();

                }
            })
        }
    </script>


    @*<script type="text/javascript">
        function Validate() {
            if (document.getElementById("filecoverImage").value == "" || document.getElementById("files").value == "") {
                Swal.fire({
                    icon: 'error',
                    title: 'Validation Error',
                    text: 'Must select one image for property front & at least one other image of the property!',
                    //footer: '<a href="">Why do I have this issue?</a>'
                })
                return false;
            }
            return true;
        }
    </script>*@

}



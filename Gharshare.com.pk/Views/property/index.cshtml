@using Gharshare.CommonHelper
@using Gharshare.Models
@model IEnumerable<Property>

@section metatags
{
<meta name="description" content="Australia's No.1 shared accommodation & management site.MRB Share house Managers offers the best
shared accomodation & management services.">
<meta name="keywords" content="Share houses, Australia, Share accomodation, sharehouse management, flatemate, shared room,
Australia's No.1 property site,property management melbourne,sharehouse manager melbourne, share house melbourne, shared home management melbourne,shared property management melbourne,Tenants">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
}

@{
    ViewData["Title"] = "Properties List | MRB";
    Pager pager = new Pager();
    int pageNo = 0;

    if (ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;
        pageNo = pager.CurrentPage;
    }
}
<div style="padding:59px;">
    <div class="row">
        <div class="col-md-6">
            <h1>Property List</h1>
        </div>
        <div class="col-md-6 text-end">
            <a class="float-right btn btn-primary" asp-area="" asp-controller="Property" asp-action="Create" style="width:200px;"><i class="bi bi-plus-circle"></i> Create Property</a>
        </div>
        <hr />
    </div>
    <div class="row">
        <div class="text-star col-md-6 p-3">
            <vc:search-bar Search="@ViewBag.Search">
            </vc:search-bar>
        </div>
        <div class="text-end col-md-6 p-2">
            @* pagination*@
            <partial name="_Pager" model="@pager" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <table class="table table-bordered table-striped text-wrap table-responsive">
                <thead>
                    <tr>
                        <th scope="col" style="width:60px;">#</th>
                        @*<th scope="col" class="col-3" >Location</th>*@
                        <th scope="col" class="col-5">
                            <i class="@ViewData["SortIcon"]"></i>
                            <a asp-action="index" asp-route-pg="@ViewBag.pg" asp-route-sortOrder="@ViewBag.LocationSortParam">Location</a>
                        </th>
                        <th scope="col" class="col-1">
                            <i class="@ViewData["SortIconCity"]"></i>
                            <a asp-action="index" asp-route-pg="@ViewBag.pg" asp-route-sortOrder="@ViewBag.CitySortParam">City</a>                            
                        </th>
                        <th scope="col" class="col-3">Owned/Managed by</th>
                        <th scope="col" class="col-2">Contact</th>
                        <th scope="col" class="text-center col-1">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var count = 1;
                        @foreach (var property in Model)
                        {
                            <tr>
                                <th scope="row">@count</th>
                                <td>@property.Address</td>
                                <td>@property.City.Name</td>
                                <td>@property.Owner.Name</td>
                                <td>@property.Owner.PhoneNumber</td>
                                <td class="text-center">
                                    <div class="btn-group text-end" role="group">
                                        <a asp-action="Edit" title="Edit" asp-route-id=@property.ID class="btn btn btn-primary mx-1"><i class="bi bi-pencil-square"></i></a>
                                        <a asp-action="Delete" title="Delete" asp-route-id=@property.ID class="btn btn btn-danger mx-1"><i class="bi bi-trash-fill"></i></a>
                                        <a asp-action="PropertyPics" title="View Pictures" asp-route-id=@property.ID class="btn btn btn-primary mx-1"><i class="bi bi-images"></i></a>
                                    </div>
                                </td>
                            </tr>
                            count = count + 1;
                        }
                    }
                </tbody>
            </table>
            <partial name="_Pager" model="@pager" />
        </div>
    </div>
    <div>
        @if (@Model.Count() == 0)
        {
            <p>There is no Property. Click 'Create Property' to add new.</p>
        }
    </div>
</div>

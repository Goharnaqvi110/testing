@using Gharshare.CommonHelper
@model List<Gharshare.Models.PropertyEnquiry>

@{
    ViewData["Title"] = "Enquiries";
    Layout = "~/Views/Shared/_Layoutlandlord.cshtml";
    Pager pager = new Pager();
    int pageNo = 0;
    if (ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;
        pageNo = pager.CurrentPage;
    }
}
<div class="container-fluid">
    <div class="page-heading-row">
        <h2 class="page-heading heading-secondary">
            <span id="property-address">Enquiries</span>
        </h2>
    </div>
    <div class="col-xl-12 bd-callout bd-callout-default">
        <p>
            <strong>Property Address:</strong> G-6/2, Islmabad
        </p>
        <p>
            Tip: Once you have marked an item as 'paid' it will automatically feed the reporting feature.
            To mark as 'paid' please click edit and select yes.
        </p>
    </div>
    <div class="col-xl-12 bd-callout">
        <div class="row mb-3">
            <a class="btn btn-primary w-25" asp-action="addmaintenance">
                <i class="fa fa-plus"></i>
                Create new enquiries
            </a>
        </div>
        @if (Model.Any())
        {
            <div id="enquiryList">
            <div class="table-responsive">
                <table class="table table-responsive-md">
                    <thead>
                        <tr>
                            <th style="width:30px;">
                                <h6>No</h6>
                            </th>
                            <th><h6>About</h6></th>
                            <th><h6>Name</h6></th>
                            <th><h6>Email</h6></th>
                            <th><h6>Mobile</h6></th>
                            <th><h6>Message</h6></th>
                            <th><h6>Received</h6></th>
                            <th class="text-center"><h6>Status</h6></th>
                            <th class="text-center" style="width:74px;"><h6>Action</h6></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int sno = 0;
                        }
                        @for (int i = 0; i < Model.Count(); i++)
                        {
                            var enquiry = Model[i];
                            sno = @i + 1;
                            <tr>
                                <td>@sno</td>
                                <td>
                                    @Utility.GetEnumDisplayName(enquiry.About)
                                </td>
                                <td>@enquiry.Name</td>
                                <td>@enquiry.Email</td>
                                <td>@enquiry.Mobile</td>
                                <td>@enquiry.Message</td>
                                <td>@Utility.ConvertToShortDateFormat(enquiry.DateReceived)</td>
                                <td>
                                    <select class="nice-select" asp-for="@enquiry.Status">
                                        <option value="1" data-eid="@enquiry.ID" data-pid="@enquiry.PropertyID">read</option>
                                        <option value="2" data-eid="@enquiry.ID" data-pid="@enquiry.PropertyID">unread</option>
                                        <option value="3" data-eid="@enquiry.ID" data-pid="@enquiry.PropertyID">shortlist</option>
                                        <option value="4" data-eid="@enquiry.ID" data-pid="@enquiry.PropertyID">not suitable</option>
                                    </select>
                                </td>
                                <td>
                                    <div class="text-center">
                                        <a asp-action="Edit" asp-route-id="@enquiry.ID"
                                   title="Edit" class="edit btn btn-danger shadow btn-xs sharp me-1">
                                            <i class="fa fa-pen"></i>
                                        </a>
                                        <a asp-action="deletemaitenance" asp-route-id="@enquiry.ID"
                                   title="Delete" class="edit btn btn-danger shadow btn-xs sharp me-1">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
            </div>
            <partial name="_AjaxPager" model="@pager" />
        }
        else
        {
            <div id="noplan" class="row text-center p-3">
                <h4>No record found</h4>
            </div>
        }
        <div style="display:none" id="message" class="row text-center p-3">
            <h4>No record found</h4>
        </div>
    </div>
</div>

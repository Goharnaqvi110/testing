@using Gharshare.CommonHelper
@using Gharshare.Models
@model Gharshare.Models.BondVM
@*@inject UserManager<ApplicationUser> userManager*@

@{
    ViewData["Title"] = "Bond";
    if (User.IsInRole(WebSiteRoles.Role_Landlord))
        Layout = "~/Views/Shared/_LayoutLandlord.cshtml";
    else if (User.IsInRole(WebSiteRoles.Role_Tenant))
        Layout = "~/Views/Shared/_LayoutTenant.cshtml";
}
<div class="container-fluid">
    <h3 class="heading-main">Bond</h3>
    <div class="row bd-callout bd-callout-default  m-1 mb-3">
        <div class="col-xl-6">
            <p>
                <strong>Property Address:</strong> @Model.leaseAgreement.Property.Address
            </p>
            <p><b>About rental bonds</b></p>
            <p>
                A rental <strong>bond is a security deposit</strong> that a tenant pays at the start of a
                tenancy which is then lodged with the relevant state government or bond authority.
            </p>
            <p>
                The bond plays a role in providing peace of mind and <strong>protection for a landlord</strong>.
                Typically you would ask for up to 4 weeks rent to be held as a bond. As a result,
                it is incredibly important that there is a bond in place at the beginning of every
                tenancy.
            </p>
            <p>
                There are <strong>two steps involved</strong> in lodging a bond which include
                setting up your account and then paying the bond.
            </p>
        </div>
        <div class="col-xl-6 mt-4">
            <p class="mt-3"><b>How to lodge the bond for your property</b></p>
            <p>
                The bond lodgement process has been made a lot easier with the bonds online
                system. There are two steps required:
            </p>
            <p>
                Once the PDF version of the lease agreement has been generated, you can view a
                draft of it and make any update or changes before finalising the agreement. You
                will need to send the completed copy to your tenant(s) to sign digitally through
                this application.
            </p>
            <p>
                <strong>Step 1: Set up an account</strong><br />
                Register your property, lease and tenant details through the local bond authority.
            </p>
            <p>
                <strong>Step 2: Paying the bond</strong><br />
                you can collect the bond via the RentBetter Platform and then pay the bond to your
                local authority. If you follow the steps below you can create a bond request for
                your tenant to pay the bond and then once received submit the bond to the local
                bond authority.
            </p>
        </div>
        <div class="report-net-total"></div>
        <div class="col-xl-12">
            <p>
                Please Note: The local authority in your state provides guidance on the timeframes
                for collecting, lodging and receipting a bond payment. The links provided in this
                section will guide you through the process, but you are always welcome to check with
                your local authority.
            </p>
        </div>
        <div class="d-flex" style="padding-bottom: 20px;">
            <img src="/img/tool-tip.png" alt="More Info on Bond" style="height:20px;width:20px;">
            <p style="margin-left:5px;">Would like to know more about bond? Take a look at the preview</p>

        </div>
        <div>
            <a class="btn btn-primary">
                How bond works
            </a>
        </div>
    </div>
    <div class="row bd-callout m-1 mb-3">
        @if (Model.leaseAgreement != null)
        {
            <div class="table-responsive">
                <table class="table table-responsive-md">
                    <thead>
                        <tr>
                            <th><h6>Due date</h6></th>
                            <th><h6>Rental Bond</h6></th>
                            <th><h6>Status</h6></th>
                            <th><h6>Paid</h6></th>
                            <th class="text-center"><h6>Action</h6></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <span class="w-space-no">
                                        @Utility.ConvertToShortDateFormat(Model.leaseAgreement.BondPaymentDate)
                                    </span>
                                </div>
                            </td>
                            <td>@Utility.Format(Model.leaseAgreement.BondAmount)</td>
                            <td>
                                Bond Details Sent<br />
                                @if (User.IsInRole(WebSiteRoles.Role_Landlord))
                                {
                                    <a class="red-link" href="#">Resend Bond Details</a>
                                }
                            </td>
                            <td>
                                @if (Model.leaseAgreement.IsBondPaid == true)
                                {
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-circle text-success me-1"></i> Paid
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-circle text-danger me-1"></i> Unpaid
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="text-center">
                                    <a href="#" title="Edit"
                                       class="edit btn btn-danger shadow btn-xs sharp me-1">
                                        <i class="fa fa-pen"></i>
                                    </a>
                                    <a href="#" title="Delete"
                                       class="edit btn btn-danger shadow btn-xs sharp me-1">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            //<partial name="_Pager" model="@pager" />
            @if (Model.leaseAgreement.IsBondPaid == false && User.IsInRole(WebSiteRoles.Role_Tenant))
            {
                <div class="offset-md-9 col-md-4">
                    <a id="proceed2pay"
                       onclick="showBondPaymentUI('Bond',@Model.leaseAgreement.BondAmount,
'@Model.leaseAgreement.BondPaymentDate',@Model.leaseAgreement.ID)"
                       class="btn btn-primary">Proceed to payment</a>
                </div>
            }
            <div class="bill-row">
                <input type="hidden" id="numberOfFiles">
                <input type="hidden" id="isAttachmentinput">
                <div class="ep-no-pm add-attachment-wrapper">
                    <a onclick="$('#numberOfFiles').val(3);$('#isAttachmentinput').val(true); $('#attachment').click();" class="rbb" id="add-attachment-initial">
                        <span class="fa fa-paperclip"></span> Add Attachments
                    </a><span class="file-num-limit">
                        (max. files: 3)
                        <form id="frmattachment">
                            <input id="attachment" name="attachment" type="file" multiple style="display:none"
                                   onchange="uploadAttachment(this,$('#numberOfFiles').val(),$('#isAttachmentinput').val())">
                            <input type="hidden" id="leaseId" value="@Model.leaseAgreement.ID">
                        </form>
                    </span>
                    <input id="toggle" type="hidden" value="0" />
                    <p class="attachment-toggle" id="attachment-toggle"
                       onclick="toggleBondAttachment()">                    
                         See More <i class="fa fa-plus"></i>
                    </p>
                    <div id="attachments" class="bond-attachments d-none">
                        <div class="landlord-attachment-section">
                            <div class="row">
                                <div class="col-md-4 col-sm-6">
                                    <p>Landlord attachments:</p>
                                </div>
                                <div class="col-md-8 col-sm-6 landlord-attachment-lists"
                                     id="landlord-attachment">
                                    @if (@Model.LandlordAttachments != null)
                                    {
                                        for (int i = 0; i < @Model.LandlordAttachments.Count(); i++)
                                        {
                                            string filepath = @Model.LandlordAttachments[i].FilePath;
                                            Int32 no = @i + 1;
                                            <div>
                                                <a asp-action="viewdoc" asp-route-id=@Model.LandlordAttachments[i].ID class="singleTenantAttachment" style="margin-left:18px;">
                                                    Attachemnt-@no
                                                </a>
                                                @if (User.IsInRole(WebSiteRoles.Role_Landlord))
                                                {
                                                    <a href="#" id=@Model.LandlordAttachments[i].ID
                                                       onclick="DeleteAttachment(this);" title="Delete attachment">
                                                        <i class="fa fa-trash red-link"></i>
                                                    </a>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="landlord-attachment-section">
                            <div class="row">
                                <div class="col-md-4 col-sm-6">
                                    <p style="margin-left:15px;">Tenant attachments:</p>
                                </div>
                                <div class="col-md-8 col-sm-6 landlord-attachment-lists"
                                     id="tenant-attachment">
                                    @if (@Model.TenantAttachments != null)
                                    {
                                        for (int i = 0; i < @Model.TenantAttachments.Count(); i++)
                                        {
                                            string filepath = @Model.TenantAttachments[i].FilePath;
                                            Int32 no = @i + 1;
                                            <div>
                                                <a asp-action="viewdoc" asp-route-id=@Model.TenantAttachments[i].ID title="Click to view document" class="singleTenantAttachment">
                                                    Attachemnt-@no
                                                </a>
                                                @if (User.IsInRole(WebSiteRoles.Role_Tenant))
                                                {
                                                    <a href="#" id=@Model.TenantAttachments[i].ID title="Delete attachment"
                                                       onclick="DeleteAttachment(this);">
                                                        <i class="bi bi-trash red-link"></i>
                                                    </a>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div id="noplan" class="row text-center p-3">
                <h4>No record exists</h4>
            </div>
        }
        <div style="display:none" id="message" class="row text-center p-3">
            <h4>No record exists</h4>
        </div>
    </div>
    <div id="divPayBond" class="d-none mt-5">
        <div class="row" style="margin-left:0px;">
            <div class="col-md-9 p-1">
                <div class="card">
                    <div class="card-header">
                        <h6>
                            <strong>Payment Summary</strong>
                        </h6>
                    </div>
                    <div class="card-body">
                        <input type="hidden" id="leaseId" value="@Model.leaseAgreement.ID" />
                        <div class="row">
                            <div class="col-md-4"><strong>Title:</strong></div>
                            <div class="col-md-6" id="title"></div>
                            <div class="col-md-4"><strong>Amount:</strong></div>
                            <div class="col-md-6" id="amount"></div>
                            <div class="col-md-4"><strong>Payment Due Date:</strong></div>
                            <div class="col-md-6" id="dueDate"></div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-md-4">Subtotal</div>
                            <div class="col-md-6" id="subTotal"></div>
                            <div class="col-md-4">GST.</div>
                            <div class="col-md-6" id="gst"></div>
                            <div class="col-md-4"><strong>Total</strong></div>
                            <div class="col-md-6" id="total"><strong></strong></div>
                        </div>
                        <hr />
                        <div class="flex">
                            <input type="checkbox" onchange="enablePayment(this.checked)" class="form-check-input" id="chkAck" />
                            <span style="margin-left:10px;">
                                I acknowledge that when I click pay below that the
                                payment will begin processing and the money will be collected via my preferred
                                payment method.
                            </span>
                        </div>
                        <div class="text-center">
                            <input id="btnPayment" type="button" class="btn btn-primary w-50" value="Pay" disabled />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3">
                <div class="card bd-callout-default" style="height:440px;">
                    <div class="card-header">
                        <strong>Note</strong>
                    </div>
                    <div class="card-body">
                        <p>
                            Your payment will be run the same way as your normal rental payment.
                            Please make sure there are funds in your account until the end of the
                            next business day after clicking pay. It will be processed within 3 days.
                            To change the method of payment, please go to 'Update Payment Method'
                            in <strong>My Dashboard.</strong>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row bd-callout m-1 mb-3">
        <div class="row">
            <h4>Bond Documents</h4>
        </div>
        <p>
            Feel free to upload any related documents for your personal record.
            If you would like to share a document with your tenant you can add an
            attachment to your bond card
        </p>
        <div class="lease-agreement-grid-box" style="width:96%;padding-top:40px;padding-bottom:30px;">
            <div class="offset-md-5 col-md-6">
                <strong>Browse to upload your file</strong>
            </div>
            <div class="offset-md-4 col-md-6">
                <p>Only JPEG, PNG, and PDF files with max size of 15 MB</p>
            </div>
            <div class="offset-md-5 col-md-6">
                <p>(max. files: 5)</p>
                <a onclick="$('#numberOfFiles').val(5);$('#isAttachmentinput').val(false); $('#attachment').click();" id="browseFile" class="btn btn-primary">Browse File</a>
            </div>
        </div>
    </div>
    <div class="bond-doc-section" id="bond-doc-section">
        @if (User.IsInRole(WebSiteRoles.Role_Landlord))
        {
            foreach (var file in Model.LandlordFiles)
            {
                <a asp-action="viewdoc" asp-route-id=@file.ID title="Click to view document">
                    <div class="bond-doc-wrapper">
                        <div class="bond-doc-type">
                            <img src="~/img/thumbnail-doc.png"
                                 alt="Bond Document" class="img-responsive">
                        </div>
                        <div class="bond-doc-date">
                            <div class="bond-doc-date-wrapper">
                                <p class="bond-doc-title">
                                    <i class="fa fa-image"></i>
                                    about
                                </p>
                                <p class="bond-doc-time">
                                    Uploaded on
                                    @Utility.ConvertToShortDateFormat(file.CreatedOn)
                                </p>
                                <a href="#" id=@file.ID
                                   title="Delete attachment" class="deleteBondDoc"
                                   onclick="DeleteAttachment(this);">
                                    <i class="fa fa-trash" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </a>
            }
        }
        else if (User.IsInRole(WebSiteRoles.Role_Tenant))
        {
            foreach (var file in Model.TenantFiles)
            {
                <a asp-action="viewdoc" asp-route-id=@file.ID title="Click to view document">
                    <div class="bond-doc-wrapper">
                        <div class="bond-doc-type">
                            <img src="~/img/thumbnail-doc.png"
                                 alt="Bond Document" class="img-responsive">
                        </div>
                        <div class="bond-doc-date">
                            <div class="bond-doc-date-wrapper">
                                <p class="bond-doc-title">
                                    <i class="fa fa-image"></i>
                                    about
                                </p>
                                <p class="bond-doc-time">
                                    Uploaded on
                                    @Utility.ConvertToShortDateFormat(file.CreatedOn)
                                </p>
                                <a href="#" id=@file.ID
                                   title="Delete attachment" class="deleteBondDoc"
                                   onclick="DeleteAttachment(this);">
                                    <i class="fa fa-trash" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </a>
            }
        }
    </div>
</div>
<div class="container">
    <p>
        @if (User.IsInRole(WebSiteRoles.Role_Tenant))
        {
            <a class="red-link" asp-controller="tenant" asp-action="index">Go to Dashboard</a>
        }
        else
        {
            <a class="red-link" asp-controller="property" asp-action="list">
                Go to Dashboard
            </a>
        }
    </p>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/portal/deleteBondattachment.js" type="text/javascript"></script>
<script src="~/js/portal/uploadAttachment.js" type="text/javascript"></script>
<script src="~/js/portal/testupload.js" type="text/javascript"></script>
<script src="~/js/showpaybond.js" type="text/javascript"></script>
<script src="~/js/commonFunctions/formatDateToDDMMYY.js"></script>
<script src="~/js/portal/showBondPaymentUI.js"></script>
<script src="~/js/portal/enablePayment.js"></script>
<script src="~/js/portal/toggleBondAttachment.js"></script>

<script type="text/javascript">
    function Validate() {
        if (document.getElementById("attachment").value == "") {
            Swal.fire({
                icon: 'error',
                title: 'Validation Error',
                text: 'Must select at least one file to attach!',
                //footer: '<a href="">Why do I have this issue?</a>'
            })
            return false;
        }
        return true;
    }
</script>

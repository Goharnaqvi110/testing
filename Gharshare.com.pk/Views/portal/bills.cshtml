@using Gharshare.CommonHelper
@model List<Gharshare.Models.TenantBill>

@{
    ViewData["Title"] = "Bills";
    if (User.IsInRole(WebSiteRoles.Role_Landlord))
        Layout = "~/Views/Shared/_LayoutLandlord.cshtml";
    else if (User.IsInRole(WebSiteRoles.Role_Tenant))
        Layout = "~/Views/Shared/_LayoutTenant.cshtml";

    Pager pager = new Pager();
    int pageNo = 0;

    if (ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;
        pageNo = pager.CurrentPage;
    }
}
<div class="container-fluid">
    <div class="page-heading-row">
        <h2 class="page-heading heading-secondary">
            <span id="property-address">Bills</span>
        </h2>
    </div>
    <div class="col-xl-12 bd-callout bd-callout-default">
        <p>
            <strong>Property Address:</strong> @ViewData["propertyAddress"].ToString()
        </p>
        <p>
            Tip: Once you have marked an item as 'paid' it will automatically feed the reporting feature.
            To mark as 'paid' please click edit and select yes.
        </p>
    </div>
    <div class="col-xl-12 bd-callout">
        @if (User.IsInRole(WebSiteRoles.Role_Landlord))
        {
            <div class="offset-md-10 mb-4">
                <a href="#" class="btn btn-primary" onclick="loadBillUI(@ViewBag.LeaseID)"
                   data-bs-target="#largeModal" data-bs-toggle="modal">
                    <i class="fa fa-plus"></i>
                    Create new bill
                </a>
            </div>
        }
        <div id="billList">
            <div class="table-responsive">
                <table class="table table-responsive-md">
                    <thead>
                        <tr>
                            <th style="width:50px;">
                                <h6>No</h6>
                            </th>
                            <th><h6>Category</h6></th>
                            <th><h6>Title</h6></th>
                            <th><h6>Description</h6></th>
                            <th><h6>Amount</h6></th>
                            <th><h6>Due date</h6></th>
                            <th><h6>Attachment(s)</h6></th>
                            <th><h6>Created on</h6></th>
                            <th><h6>Status</h6></th>
                            <th class="text-center"><h6>Action</h6></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            int sno = 0;

                            @for (int i = 0; i < Model.Count(); i++)
                            {
                                var bill = Model[i];
                                sno = @i + 1;
                                <tr>
                                    <td>@sno</td>
                                    <td>@bill.Category.Title</td>
                                    <td>@bill.Title</td>
                                    <td>@bill.Description</td>
                                    <td>@Utility.Format(bill.Amount)</td>
                                    <td>@Utility.ConvertToShortDateFormat(bill.DueDate)</td>
                                    <td>
                                        @if (bill.BillDocuments.Any())
                                        {
                                            @for (int j = 0; j < bill.BillDocuments.Count; j++)
                                            {
                                                int no = @j + 1;
                                                <a href=@bill.BillDocuments[@j].FilePath>Attachement-@no</a>
                                                <br />
                                            }
                                        }
                                        else
                                        {
                                            <span>NA</span>
                                        }
                                    </td>
                                    <td>@Utility.ConvertToShortDateFormat(bill.CreatedOn)</td>
                                    <td>
                                        @if (bill.IsPaidByTenant)
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="fa fa-circle text-success me-1"></i> Paid
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="fa fa-circle text-danger me-1"></i> Unpaid
                                            </div>
                                        }
                                    </td>
                                    @if (User.IsInRole(WebSiteRoles.Role_Landlord))
                                    {
                                        <td>
                                            <div class="text-center" style="width:80px;">
                                                <a href="#" data-bs-target="#largeModal" data-bs-toggle="modal"
                                                   onclick="editBill(@bill.ID)"
                                                   title="Edit bill" class="edit btn btn-danger shadow btn-xs sharp me-1">
                                                    <i class="fa fa-pen"></i>
                                                </a>
                                                <a href="#" data-bs-target="#largeModal" data-bs-toggle="modal"
                                                   onclick="deleteBill(@bill.ID)"
                                                   title="Delete bill" class="edit btn btn-danger shadow btn-xs sharp me-1">
                                                    <i class="fa fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    }
                                    else if (User.IsInRole(WebSiteRoles.Role_Tenant) && bill.IsPaidByTenant == false)
                                    {
                                        <td style="width:160px;">
                                            <a href="#" onclick="showPaymentUI('@bill.Category.Title',
'@bill.Title',
'@bill.Description',
'@bill.Amount',
'@Utility.ConvertToShortDateFormat(bill.DueDate)',@bill.ID)" id="proceed2pay" class="red-link">
                                                <i class="fa fa-credit-card"></i>
                                                Proceed to payment
                                            </a>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10">
                                    <div id="noplan" class="text-center p-3">
                                        <h4>No record found</h4>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <partial name="_AjaxPager" model="@pager" />
        <div style="display:none" id="message" class="row text-center p-3">
            <h4>No record exists</h4>
        </div>
    </div>
    <div id="divPaybill" class="d-none">
        <div class="row" style="margin-left:0px;">
            <div class="col-md-9 p-1">
                <div class="card">
                    <div class="card-header">
                        <h6>
                            <strong>@ViewData["propertyAddress"].ToString()</strong>
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3"><strong>Bill Summary</strong></div>
                        <input type="hidden" id="billId" />
                        <div class="row">
                            <div class="col-md-4"><strong>Category:</strong></div>
                            <div class="col-md-6" id="cat"></div>
                            <div class="col-md-4"><strong>Title:</strong></div>
                            <div class="col-md-6" id="title"></div>
                            <div class="col-md-4"><strong>Description:</strong></div>
                            <div class="col-md-6" id="desc"></div>
                            <div class="col-md-4"><strong>Amount:</strong></div>
                            <div class="col-md-6" id="amount"></div>
                            <div class="col-md-4"><strong>Payment Date:</strong></div>
                            <div class="col-md-6" id="dueDate"></div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-md-4">Subtotal</div>
                            <div class="col-md-6" id="subTotal"></div>
                            <div class="col-md-4">GST.</div>
                            <div class="col-md-6" id="gst"></div>
                            <div class="col-md-4"><strong>Total</strong></div>
                            <div class="col-md-6" id="total"><strong></strong></div>
                        </div>
                        <hr />
                        <div class="flex">
                            <input type="checkbox" onchange="enablePayment(this.checked)" class="form-check-input" id="chkAck" />
                            <span style="margin-left:10px;">
                                I acknowledge that when I click pay below that the
                                payment will begin processing and the money will be collected via my preferred
                                payment method.
                            </span>
                        </div>
                        <div class="text-center">
                            <input id="btnPayment" type="button" class="btn btn-primary w-50" value="Pay" disabled />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3">
                <div class="card bd-callout-default" style="height:440px;">
                    <div class="card-header">
                        <strong>Note</strong>
                    </div>
                    <div class="card-body">
                        <p>
                            Your payment will be run the same way as your normal rental payment.
                            Please make sure there are funds in your account until the end of the
                            next business day after clicking pay. It will be processed within 3 days.
                            To change the method of payment, please go to 'Update Payment Method'
                            in <strong>My Dashboard.</strong>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/js/portal/loadBillUI.js"></script>
<script src="~/js/portal/deleteBill.js"></script>
<script src="~/js/portal/editBill.js"></script>
<script src="~/js/portal/showPaymentUI.js"></script>
<script src="~/js/portal/enablePayment.js"></script>

<script src="/js/commonFunctions/recreatePaging.js"></script>
<script src="/js/commonFunctions/formatDateToDDMMYY.js"></script>
<script src="~/js/bill/createBillList.js"></script>
<script src="~/js/bill/getBills.js"></script>

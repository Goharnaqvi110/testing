@using Gharshare.CommonHelper
@model Gharshare.Models.Expense

@{
    ViewData["Title"] = "Edit expense";
    Layout = null;

}
<div class="container">
    <form asp-action="editexpense" asp-action="POST" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div>
            <input type="hidden" asp-for="PropertyID" />
            <input type="hidden" asp-for="LeaseAgreementID" />
            <input type="hidden" asp-for="CreatedbyUserId" />
            <input type="hidden" asp-for="CreatedOn" />
            <input type="hidden" asp-for="ID" />
        </div>
        <div class="row">
            <label>Category</label>
            <select required asp-for="CategoryID" class="nice-select" asp-items="ViewBag.Categories">
                <option value="">Select Category</option>
            </select>
            <span asp-validation-for="CategoryID" class="text-danger"></span>
        </div>
        <div class="row">
            <label>Title</label>
            <input required asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="row">
            <label>Description</label>
            <input required asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-6">
                <label>Amount</label>
                <input required asp-for="Amount" class="form-control" value="@Utility.Format(Model.Amount)" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label>Expense Date</label>
                <input type="text" required asp-for="ExpenseDate" class="form-control datepicker"
                value="@Utility.ConvertToShortDateFormat(Model.ExpenseDate)"/>
                <span asp-validation-for="ExpenseDate" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            <label class="form-check-label">
                <input class="form-check-input" asp-for="AlreadyPaid" />
                <span> Has this expense already been paid for?</span>
            </label>
        </div>
        <div class="row">
            <label class="form-check-label">
                <input class="form-check-input" asp-for="GSTIncluded" /><span> GST included?</span>
            </label>
        </div>
        <label>Receipts</label>
        <div class="mb-3">
            <input id="receipts" multiple type="file" name="receipts" class="form-control" />
        </div>
        <div class="text-center">
            <input type="submit" value="Save" class="btn btn-primary w-50" />
        </div>
    </form>
</div>
<partial name="_dtpPartial"></partial>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


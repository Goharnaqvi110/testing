@using Gharshare.CommonHelper
@model List<Gharshare.Models.Document>

@{
    ViewData["Title"] = "Documents";
    if (User.IsInRole(WebSiteRoles.Role_Landlord))
        Layout = "~/Views/Shared/_LayoutLandlord.cshtml";
    else
        Layout = "~/Views/Shared/_LayoutTenant.cshtml";
    Pager pager = new Pager();
    int pageNo = 0;

    if (ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;
        pageNo = pager.CurrentPage;
    }
}
<div class="container-fluid">
    <div class="page-heading-row">
        <h2 class="page-heading heading-secondary">
            <span id="property-address">Documents</span>
        </h2>
    </div>
    @if (ViewData["propertyAddress"] == string.Empty)
    {
        <div class="col-xl-12 bd-callout bd-callout-default">
            <p>
                <strong>Property Address:</strong> @ViewData["propertyAddress"]
            </p>
            <p>
                Tip: Once you have marked an item as 'paid' it will automatically feed the
                reporting feature. To mark as 'paid' please click edit and select yes.
            </p>
        </div>
    }
    <div class="col-xl-12 bd-callout">
        <div id="documentList">
        <div class="table-responsive">
            <table class="table table-responsive-md">
                <thead>
                    <tr>
                        <th style="width:50px;">
                            <h6>No</h6>
                        </th>
                        <th><h6>Document</h6></th>
                        <th><h6>Property address</h6></th>
                        <th><h6>Created by</h6></th>
                        <th><h6>Created on</h6></th>
                        <th class="text-center"><h6>Action</h6></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        int sno = 0;

                        @for (int i = 0; i < Model.Count(); i++)
                        {
                            var document = Model[i];
                            sno = @i + 1;
                            <tr>
                                <td>@sno</td>
                                <td>@document.DocumentType.Title</td>
                                <td style="width:450px;">@document.Property.Address</td>
                                <td>@document.CreatedbyUser.Name</td>
                                <td style="width:80px;">@Utility.ConvertToShortDateFormat(document.CreatedOn)</td>
                                <td>
                                    <div class="text-center">
                                        <a asp-controller="portal" asp-action="document" asp-route-uid=@document.uid
                                           title="View" class="edit btn btn-danger shadow btn-xs sharp me-1">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                        <a asp-controller="portal" asp-action="download" asp-route-uid=@document.uid
                                           title="Download" class="edit btn btn-danger shadow btn-xs sharp me-1">
                                            <i class="fa fa-download"></i>
                                        </a>
                                        <a href="#" data-bs-target="#largeModal" data-bs-toggle="modal"
                                           onclick="deleteDocument(@document.ID)"
                                           title="Delete" class="edit btn btn-danger shadow btn-xs sharp me-1">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div id="noplan" class="text-center p-3">
                                    <h4>No record found</h4>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </div>
        <partial name="_AjaxPager" model="@pager"/>
        <div style="display:none" id="message" class="row text-center p-3">
            <h4>No record exists</h4>
        </div>
    </div>
</div>
<script src="~/js/portal/deleteDocument.js"></script>
<script src="/js/commonFunctions/recreatePaging.js"></script>
<script src="/js/commonFunctions/formatDateToDDMMYY.js"></script>
<script src="~/js/document/createDocumentList.js"></script>
<script src="~/js/document/getDocuments.js"></script>
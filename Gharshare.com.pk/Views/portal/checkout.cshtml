@using Gharshare.CommonHelper
@using Gharshare.Models
@using System.Globalization
@model vmPricing
@{
    ViewData["Title"] = "index";
    Layout = "_LayoutLandlord";
}

<div class="container">
    @* <div>
    <br><br>
    <h3 class="text-center">
    Please select <span class="text-primary"> a Plan </span>
    </h3>
    <br>
    </div> *@
    <div class="row">
        @if (Model.Plans.Any())
        {
            foreach (var plan in Model.Plans)
            {
                <div class="col-xl-4">
                    <div class="card" style="@(plan.DefaultPlan ? "border: 1px solid red;" : "")">
                        <div class="card-header section-bg-6 border-0 p-3" style="padding:0px;">
                            <h3 class="card-title ">
                                <span style="color:white;">@plan.BoxHeading</span>
                            </h3>
                        </div>
                        <div class="card-body text-center">
                            <input id="@plan.ID" class="d-none"
                                   onchange="selectUnselectPlan(this,'@plan.Title',@plan.MonthlyCharges,@plan.UpFrontPrice)"
                                   name="plan" type="radio">
                            <label for="@plan.ID">
                                <img src="@plan.ImagePath" class="service-icon"
                                     style="width:242px;height:236px;" alt="#">
                                <h4 class="mt-4">@plan.Title</h4>
                                <p style="min-height:50px;">@plan.Tagline</p>
                                <h4>
                                    @if (plan.UpFrontPrice > 0)
                                    {
                                        <span>Rs @Utility.Format(plan.UpFrontPrice)</span>
                                        <span class="fs-6 fw-light">
                                            one-off +
                                        </span>
                                    }
                                    Rs @Utility.Format(plan.MonthlyCharges)
                                    <span class="fs-6 fw-light">/month*</span>
                                </h4>
                                <button class="btn btn-primary selectPlan w-100" type="button"
                                        onclick="scrollToBottom(this,event,'@plan.Title',@plan.MonthlyCharges,@plan.UpFrontPrice)">
                                    Select Plan
                                    @* <i class="flaticon-right-arrow"></i> *@
                                </button>
                                @if (plan.Services.Any())
                                {
                                    foreach (var service in plan.Services)
                                    {
                                        <p class="pt-3">
                                            <span class="ltn__secondary-color-3">
                                                <img src="/img/publicsite/common/pinkcheck.png" alt="" class="custom-rounded me-1" width="15" height="15">
                                            </span>@service.Service.Name
                                        </p>
                                    }
                                }
                            </label>
                        </div>
                        <div class="card-footer border-0 pt-0">
                            <div class="card-footer border-0 pt-0">
                                <p class="hover hidden text-center"></p>
                                <span class="fas fa-arrow-right"></span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

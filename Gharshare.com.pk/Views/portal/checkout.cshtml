<div class="container-fluid mt-2">
    <div class="row">
        <div class="col-xl-7 bd-callout bd-callout-default" style="margin-left:40px;">
            <div class="page-heading-row">
                <h4 class="page-heading heading-secondary pb-4">
                    <span id="property-address" style="margin-left:20px;">
                        Payment Details
                    </span>
                </h4>
            </div>
            <div class="row offset-md-1">
                <label>Card Details *</label>
                <input class="form-control" style="margin-left:0px;" required />
                <span class="text-danger"></span>
            </div>
            <div class="row offset-md-1">
                <label>Cardholder Name *</label>
                <input class="form-control" style="margin-left:0px;" required />
                <span class="text-danger"></span>
            </div>
            <div class="text-center">
                <a class="btn btn-primary w-25">Pay</a>
            </div>
        </div>
        <div class="col-xl-4 bd-callout bd-callout-default" style="margin-left:30px;">
            <h4 class="page-heading heading-secondary pb-2">
                <i class="fa fa-shopping-cart"></i>
                <span id="property-address" style="margin-left:20px;">
                    Purchase Summary
                </span>
            </h4>
            <div class="row">
                <h4 class="page-heading heading-secondary pb-2">
                    <span id="title" class="text-primary mt-3">
                        @Model.DefaultPlan.Title
                    </span>
                </h4>
            </div>
            <div class="row">
                <div class="col-md-5">
                    <span>Property Address</span>
                </div>
                <div class="col-md-7">
                    <span id="address">
                        @ViewBag.PropertyAddress
                    </span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <span>Price</span>
                </div>
                <div class="col-md-8">
                    <span class="text-primary" id="price">
                        Rs @Utility.Format(Model.DefaultPlan.UpFrontPrice) +
                        Rs @Utility.Format(Model.DefaultPlan.MonthlyCharges)/month
                    </span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <span>GST</span>
                </div>
                <div class="col-md-8">
                    <span id="gst" class="text-primary">
                        @{
                            var gst = (Model.DefaultPlan.MonthlyCharges + Model.DefaultPlan.UpFrontPrice) * 18 / 100;
                            var total = Model.DefaultPlan.MonthlyCharges + Model.DefaultPlan.UpFrontPrice + gst;
                        }
                        Rs @Utility.Format(gst)
                    </span>
                </div>
                <span class="mt-3" id="monthly">
                    *after 3 months billed
                    Rs @Utility.Format(Model.DefaultPlan.MonthlyCharges)/month
                </span>
            </div>
            <hr />
            <div class="row">
                <div class="col-md-5">
                    <span>Total</span>
                </div>
                <div class="col-md-7">
                    <span id="total">
                        Rs @Utility.Format(total)
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="/js/plan/selectunselectplan.js"></script>
<script src="/js/plan/scrolltoBottom.js"></script>
<script src="https://code.jquery.com/jquery-1.12.4.min.js"
        integrity="sha256-ZosEbRLbNQzLpnKIkEdrPv7lOy9C27hHQ+Xp8a4MxAQ="
        crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/3.1.2/rollups/aes.js"></script>

<script type="text/javascript" src="~/js/commonFunctions/PaybyAlfalahRedirect.js"></script>              
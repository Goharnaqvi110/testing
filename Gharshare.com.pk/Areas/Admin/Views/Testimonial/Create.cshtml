@using Gharshare.Models
@model Testimonial
@{
    ViewData["Title"] = "Create Testimonial";
}
<div class="container" style="padding:60px;">
    <div class="col-md-12">
        <h1>Create Testimonial</h1>
        <hr />
    </div>
    <form method="Post" asp-action="Create" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-6">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="CreatedbyUserID" />
                <div class="form-floating p-1">
                    <input maxlength="20" type="text" asp-for="Name" class="form-control" autocomplete="Name" aria-required="true" />
                    <label asp-for="Name">Name</label>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-floating p-1">
                    <textarea maxlength="650" id="open-source-plugins" asp-for="Description" 
                    class="form-control" cols="45" 
                    placeholder="Testimonial" required="" style="Height:160px;"></textarea>
                    <label asp-for="Description">Description</label>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="custom-file">
                    <input id="file" type="file" name="file" class="custom-file-input pb-2" />
                </div>
                <div class="custom-file">
                    <input type="checkbox" id="IsShown" checked class="m-1 form-check-input" />
                    <label>Show on public website</label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <button type="submit" class="w-100 btn btn-primary">Save Testimonial</button>
            </div>
            <div class="col-md-6">
                <a asp-action="Index" class="w-50 btn btn-secondary">Cancle</a>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/TinyMCE/RTETinyMCE.js"></script>
}

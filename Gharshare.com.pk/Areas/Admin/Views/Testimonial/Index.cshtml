@using Gharshare.Models
@using Gharshare.CommonHelper;
@model IEnumerable<Testimonial>
@{
    ViewData["Title"] = "Testimonials";
    Pager pager = new Pager();
    int pageNo = 0;

    if(ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;
        pageNo = pager.CurrentPage;
    }
}

<div style="padding:60px;">
    <div class="row">
        <div class="col-md-6">
            <h1>Testimonial List</h1>
        </div>
        <div class="col-md-6 text-end">
            <a asp-area="Admin" class="float-right btn btn-primary" asp-controller="Testimonial" asp-action="Create" style="width:200px;"><i class="bi bi-plus-circle"></i> Create Testimonial</a>
        </div>
        <hr />
    </div>
    <div class="row">
        <div class="text-end col-md-6 p-2 ">            
        </div>
        <div class="text-end col-md-6 p-2 ">
            <partial name="_Pager" model="@pager" />            
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <table class="table table-bordered table-striped text-wrap table-responsive">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col" class="col-3">Name</th>
                        <th scope="col" class="col-4">Testimonial</th>
                      @*<th scope="col" class="col-3 text-wrap">Image Path</th>*@
                        <th scope="col" class="col-3">Date Created</th>
                        <th scope="col" class="col-2 text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var count = 1;
                        @foreach (var testimonial in Model)
                        {
                            <tr>
                                <th scope="row">@count</th>
                                <td>@testimonial.Name</td>
                                <td>@testimonial.Description</td>
                                @*<td>@testimonial.ImagePath</td>*@
                                <td>@testimonial.CreatedOn</td>
                                <td>
                                <div class="btn-group text-end" role="group">
                                    <a asp-action="Edit" asp-route-id=@testimonial.Id class="btn btn-primary mx-1" style="width:90px;"><i class="bi bi-pencil-square"></i>Edit</a>
                                    <a asp-action="Delete" asp-route-id=@testimonial.Id class="btn btn-danger mx-1" style="width:93px;"><i class="bi bi-trash-fill"></i>Delete</a>
                                   </div>
                                </td>

                            </tr>
                            count = count + 1;
                        }
                    }
                </tbody>
            </table>
            <partial name="_Pager" model="@pager" />
        </div>
    </div>
    <div>
        @if (@Model.Count() == 0)
        {
            <p>There is no testimonial. Click 'Create Testimonial' to add new.</p>
        }
    </div>
</div>

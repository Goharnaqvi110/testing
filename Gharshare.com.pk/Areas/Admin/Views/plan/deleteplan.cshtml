@using Gharshare.Models
@using Gharshare.CommonHelper
@model Plan
@{
    ViewData["Title"] = "";
    Layout = null;
}
<div class="row justify-content-center h-100 align-items-center">
    <div class="col-md-12">
        <div class="authincation-content">
            <div class="row no-gutters">
                <div class="col-xl-12">
                    @if (Model.UsersonPlan.Any())
                    {
                        <div class="alert alert-danger solid alert-dismissible fade show">
                            <div class="d-flex">
                                <svg viewBox="0 0 24 24" width="24 " height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="me-2"><polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                                The plan is in use & can't be deleted
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="btn-close">
                            </button>
                        </div>
                    }
                    <div class="auth-form">
                        <form id="frmplan">
                            <input type="hidden" asp-for="ID" />
                            <input type="hidden" asp-for="uid" />                             
                            <div class="row justify-content-center mb-3">
                                <div class="col-sm-12">
                                    <label class="text-label form-label">Plan name</label>
                                    <div class="flex">
                                        <input id="txtname" asp-for="Title" type="text" class="form-control"
                                               readonly required placeholder="Enter plan name...">
                                        <span asp-validation-for="Title" id="spanname" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-sm-6">
                                    <span class="text-label form-label">Plan Type</span>
                                    <span>@Utility.GetEnumDisplayName(@Model.PlanType)</span>
                                </div>
                                <div class="col-sm-6">
                                    <label class="text-label form-label">Plan Status</label>
                                    <div class="flex">
                                        <span>@Utility.GetEnumDisplayName(@Model.PlanStatus)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-sm-6">
                                    <label class="text-label form-label">Price</label>
                                    <div class="flex">
                                        <input asp-for="UpFrontPrice" type="text" class="form-control" readonly>
                                    </div>
                                </div>                                
                            </div>
                            <div class="row mb-3">
                                <div class="col-sm-6">
                                    <label class="text-label form-label">Tagline</label>
                                    <div class="flex">
                                        <input id="txttagline" asp-for="Tagline" type="text"
                                               class="form-control" />
                                    </div>
                                </div>                                 
                            </div>
                            <div>
                                <div class="row justify-content-center mb-3">
                                    <label class="text-label form-label">Plan description</label>
                                    <div class="flex">
                                        <textarea readonly id="txtdescription" rows="10" style="height:100px;"
                                                  class="form-control" asp-for="Description"></textarea>
                                    </div>
                                </div>
                            </div>
                            @if (!Model.UsersonPlan.Any())
                            {
                                <div class="row justify-content-center mb-2">
                                    <button type="submit" class="btn btn-primary w-50">
                                        Delete Plan
                                    </button>
                                </div>
                            }
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<partial name="_ValidationScriptsPartial" />
<partial name="_dtpPartial" />
<script src="~/js/plan/createplanlist.js"></script>
<script src="~/js/plan/deletePlan.js"></script>

@using Gharshare.Models
@using Gharshare.CommonHelper;
@model IEnumerable<Plan>
@{
    ViewData["Title"] = "Plans";
    Pager pager = new Pager();
    int pageNo = 0;

    if(ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;
        pageNo = pager.CurrentPage;
    }
}

<div style="padding:60px;">
    <div class="row">
        <div class="col-md-6">
            <h1>Plan List</h1>
        </div>
        <div class="col-md-6 text-end">
            <a asp-area="Admin" class="float-right btn btn-primary" asp-controller="Plan" asp-action="Create" style="width:200px;"><i class="bi bi-plus-circle"></i> Create Plan</a>
        </div>
        <hr />
    </div>
    <div class="row">
        <div class="text-end col-md-6 p-2 ">            
        </div>
        <div class="text-end col-md-6 p-2 ">
            <partial name="_Pager" model="@pager" />            
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col" class="col-2">Name</th>
                        <th scope="col" class="col-4">Description</th>
                        <th scope="col" class="col-3">Price</th>
                        <th scope="col" class="col-3 text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var count = 1;


                        @foreach (var plan in Model)
                        {
                            <tr>
                                <th scope="row">@count</th>
                                <td>@plan.Title</td>
                                <td>@plan.Description</td>
                                <td>@plan.MonthlyCharges</td>
                                <td>
                                <div class="btn-group text-end" role="group">
                                    <a asp-action="Edit" asp-route-id=@plan.ID class="btn btn-primary mx-1" style="width:90px;"><i class="bi bi-pencil-square"></i>Edit</a>
                                    <a asp-action="Delete" asp-route-id=@plan.ID class="btn btn-danger mx-1" style="width:93px;"><i class="bi bi-trash-fill"></i>Delete</a>
                                    <a asp-action="AddServicestoPlan" asp-route-id=@plan.ID asp-controller="Plan" class="btn btn-primary mx-1" style="width:109px;"><i class="bi bi-plus-circle"></i>Services</a>
                                    </div>
                                </td>

                            </tr>
                            count = count + 1;
                        }
                    }
                </tbody>
            </table>
            <partial name="_Pager" model="@pager" />
        </div>
    </div>
    <div>
        @if (@Model.Count() == 0)
        {
            <p>There is no plan. Click 'Create Plan' to add new plan.</p>
        }
    </div>
</div>

@using Gharshare.Models
@using Gharshare.CommonHelper
@model List<StaticContent>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Static Pages List";
    Pager pager = new Pager();
    int pageNo = 0;

    if (ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;
        pageNo = pager.CurrentPage;
    }
}
<div class="col-lg-12">
    <div class="card m-5">
        <div class="card-header row">
            <div class="col-md-9">
                <h4 class="card-title">Static Pages List</h4>
            </div>
            <div class="col-md-3">
                <a asp-action="create" asp-controller="cms" asp-area="admin"
                   class="btn btn-primary">
                    <i class="fa fa-plus"></i>
                    Add new content
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row m-2">                 
                <div class="offset-md-8 col-md-4">
                    <select id="ddlContentType" asp-items="@ViewBag.ContentTypes"
                        class="nice-select wide w-100">
                        <option value="0">All content types</option>
                    </select>
                </div>
            </div>
            @if (Model.Any())
            {
                <div id="contentList" class="table-responsive">
                    <table class="table table-responsive-md">
                        <thead>
                            <tr>
                                <th style="width:50px;">
                                    <strong>No</strong>
                                </th>
                                <th><strong>Heading</strong></th>
                                <th><strong>Type</strong></th>
                                <th><strong>Created on</strong></th>
                                <th><strong>Created by</strong></th>
                                <th><strong>Status</strong></th>
                                <th><strong>Action</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count(); i++)
                            {
                                var pageContent = Model[i];
                                var sno = @i + 1;
                                <tr>
                                    <td>@sno</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span class="w-space-no">@pageContent.Heading</span>
                                        </div>
                                    </td>
                                    <td>@pageContent.ContentType.Name</td>
                                    <td>@Utility.ConvertToShortDateFormat(@pageContent.CreatedOn)</td>
                                    <td>@pageContent.CreatedbyUser.Name</td>
                                    <td>
                                        @if (pageContent.Status == StaticContent.status.active)
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="fa fa-circle text-success me-1"></i> Active
                                            </div>
                                        }
                                        else if (pageContent.Status == StaticContent.status.draft)
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="fa fa-circle text-warning me-1"></i> Draft
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="fa fa-circle text-danger me-1"></i> Canceled
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex">
                                            <a asp-action="edit" asp-route-uid="@pageContent.UId"
                                       class="edit btn btn-danger shadow btn-xs sharp me-1">
                                                <i class="fa fa-pen"></i>
                                            </a>
                                            <a asp-action="delete" asp-route-Id="@pageContent.UId"
                                       class="btn btn-danger shadow btn-xs sharp">
                                                <i class="fa fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <partial name="_Pager" model="@pager" />
            }
            else
            {
                <div class="row text-center p-3">
                    <h4>No record exists</h4>
                </div>
            }
            <div style="display:none" id="response" class="row text-center p-3">
                @*used when no data in ajax success*@
                <h4>No record exists</h4>
            </div>
        </div>
    </div>
</div>
<script src="~/js/admin/cms/getContent.js"></script>
<script src="~/js/commonfunctions/formatDateToDDMMYY.js"></script>
<script src="~/js/admin/cms/createContentlist.js"></script>
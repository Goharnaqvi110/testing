@using Gharshare.Models
@using Gharshare.CommonHelper
@model Service
@{
    ViewData["Title"] = "Delete Service";
    Layout = null;
}
<div class="row justify-content-center h-100 align-items-center">
    <div class="col-md-12">
        <div class="authincation-content">
            <div class="row no-gutters">
                <div class="col-xl-12">
                    @if (Model.planServices.Any())
                    {
                        <div class="alert alert-danger solid alert-dismissible fade show">
                            <div class="d-flex">
                                <svg viewBox="0 0 24 24" width="24 " height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="me-2"><polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                                The service is in use & can't be deleted
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="btn-close">
                            </button>
                        </div>
                    }
                    <div class="auth-form">
                        <form id="frmservice">
                            <input type="hidden" asp-for="ID" />
                            <div class="row justify-content-center mb-3">
                                <div class="col-sm-6">
                                    <label class="text-label form-label">Service type</label>
                                    <div class="d-flex">
                                        <span>
                                            @Utility.GetEnumDisplayName(Model.Type)
                                        </span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <label class="text-label form-label">Service name</label>
                                    <div class="flex">
                                        <input asp-for="Name" type="text" class="form-control"
                                               readonly>
                                    </div>
                                </div>
                            </div>
                            <div class="row justify-content-center mb-3">
                                <label class="text-label form-label">Service description</label>
                                <div class="flex">
                                    <textarea readonly rows="10" style="height:100px;"
                                              class="form-control" asp-for="Description">
                                </textarea>
                                </div>
                            </div>
                            @if (! Model.planServices.Any())
                            {
                                <div class="row justify-content-center mb-2">
                                    <button type="submit" class="btn btn-primary w-50">
                                        Delete Service
                                    </button>
                                </div>
                            }
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<partial name="_ValidationScriptsPartial" />
<partial name="_dtpPartial" />
<script src="~/js/service/createServicelist.js"></script>
<script src="~/js/service/deleteService.js"></script>

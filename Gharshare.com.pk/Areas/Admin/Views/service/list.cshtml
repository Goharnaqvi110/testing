@using Gharshare.Models
@using Gharshare.CommonHelper
@model List<Service>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Plan Services List";
    Pager pager = new Pager();
    int pageNo = 0;

    if (ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;
        pageNo = pager.CurrentPage;
    }
}
<div class="col-lg-12">
    <div class="card m-5">
        <div class="card-header">
            <h4 class="card-title">Plan Services</h4>
        </div>
        <div class="card-body">
            <div class="row m-2">
                <div class="col-md-8">
                    <a onclick="loadAddserviceView()" href="#"
                       class="btn btn-primary" data-bs-toggle="modal"
                       data-bs-target="#largeModal">
                        <i class="fa fa-plus"></i>
                        Add new service
                    </a>
                </div>                 
            </div>
            @if (Model.Any())
            {
                <div id="servicelist" class="table-responsive">
                    <table class="table table-responsive-md">
                        <thead>
                            <tr>
                                <th style="width:50px;">
                                    <strong>No</strong>
                                </th>
                                <th><strong>Service Name</strong></th>
                                <th><strong>Description</strong></th>                                 
                                <th><strong>Status</strong></th>
                                <th><strong>Action</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count(); i++)
                            {
                                var service = Model[i];
                                var sno = @i + 1;
                                <tr>
                                    <td>@sno</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span class="w-space-no">@service.Name</span>
                                        </div>
                                    </td>
                                    <td>@service.Description</td>                                     
                                    <td>
                                        @if (service.status == Service.Status.active)
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="fa fa-circle text-success me-1"></i> Active
                                            </div>
                                        }
                                        else if (service.status == Service.Status.pending)
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="fa fa-circle text-warning me-1"></i> Pending
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="fa fa-circle text-danger me-1"></i> Canceled
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex">
                                            <a href="#" onclick="loadservice2edit(@service.ID)" data-bs-toggle="modal" data-bs-target="#largeModal"
                                            class="edit btn btn-danger shadow btn-xs sharp me-1" title="Edit service">
                                                <i class="fa fa-pen"></i>
                                            </a>                                             
                                            <a href="#" title="Delete service" onclick="loadservice2delete(@service.ID)" data-bs-toggle="modal" data-bs-target="#largeModal"
                                            class="btn btn-danger shadow btn-xs sharp"><i class="fa fa-trash"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <partial name="_Pager" model="@pager" />
            }
            else
            {
                <div id="noservice" class="row text-center p-3">
                    <h4>No record exists</h4>
                </div>
            }
            <div style="display:none" id="message" class="row text-center p-3">
                @*used when no data in ajax success*@
                <h4>No record exists</h4>
            </div>
        </div>
    </div>
</div>
<script src="~/js/service/loadAddservice.js"></script>
<script src="~/js/service/loadService2edit.js"></script>
<script src="~/js/service/loadService2delete.js"></script> 
<script src="~/js/service/createServicelist.js"></script>
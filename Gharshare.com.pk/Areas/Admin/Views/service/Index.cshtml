    <div class="row">
        <div class="col-md-6">
            <h1>Service List</h1>
        </div>
        <div class="col-md-6 text-end">
            <a class="float-right btn btn-primary" asp-controller="Service" asp-action="Create" style="width:200px;"><i class="bi bi-plus-circle"></i> Create Service</a>
        </div>
        <hr />
    </div>
    <div class="row">
        <div class="text-start col-md-6 p-3">
            <vc:search-bar Search="@ViewBag.Search">
            </vc:search-bar>            
        </div>
        <div class="text-end col-md-6 p-2 ">
            <partial name="_Pager" model="@pager" />            
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col" class="col-3">
                            <i class="@ViewData["SortIcon4Name"]"></i>
                            <a asp-action="index" asp-route-pg="@ViewBag.pg" asp-route-sortOrder="@ViewBag.NameSort">Name</a>
                        </th>
                        <th scope="col" class="col-7">Description</th>
                        <th scope="col" class="col-2 text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        if(Model !=null){
                        var count = 1;

                        @foreach (var service in Model)
                        {
                            <tr>
                                <th scope="row">@count</th>
                                <td>@service.Name</td>                                
                                <td>@service.Description</td>                                
                                <td>
                                <div class="btn-group text-end" role="group">
                                    <a asp-action="Edit" asp-route-id=@service.ID class="btn btn-primary mx-1" style="width:90px;"><i class="bi bi-pencil-square"></i>Edit</a>
                                    <a asp-action="Delete" asp-route-id=@service.ID class="btn btn-danger mx-1" style="width:93px;"><i class="bi bi-trash-fill"></i>Delete</a>
                                    </div>
                                </td>

                            </tr>
                            count = count + 1;
                        }
                    }}
                </tbody>
            </table>
            <partial name="_Pager" model="@pager" />
        </div>
    </div>
    <div>
        @{
        if(Model.Count() !=null){
        if (Model.Count() == 0)
        {
            <p>There is no plan. Click 'Create Plan' to add new plan.</p>
        }}
        else{ <p>There is no service. Click 'Create Service' to add new service.</p>}
    }
    </div>
</div>


@using Gharshare.CommonHelper
@using Gharshare.Models 
@model Gharshare.Models.LeaseAgreement
@*@inject UserManager<ApplicationUser> userManager*@

@{
    ViewData["Title"] = "Bond";
    if (User.IsInRole(WebSiteRoles.Role_Landlord))    
       Layout = "~/Views/Shared/_LayoutLandlord.cshtml";
       else if (User.IsInRole(WebSiteRoles.Role_Tenant))
       Layout = "~/Views/Shared/_LayoutTenant.cshtml";
}
<div class="container">
    <h1 class="mt-4">Bond:@Model.Property.Address</h1>

    <p>
    @if (User.IsInRole(WebSiteRoles.Role_Tenant))
        {
            <a asp-action="index">Go to Dashboard</a>
        }        
        else
        {
        <a asp-controller="property" asp-action="list">Go to Dashboard</a>    
        }        
    </p>
    <form asp-action="bond">
        <div>
            <input type="hidden" asp-for=@Model.BondAmount />
            <input type="hidden" asp-for=@Model.From />
            <input type="hidden" asp-for="To" />
            <input type="hidden" asp-for="PropertyID" />
        </div>
        <table class="table">
            <thead>
                <tr>
                    <th>
                        <span>Due date</span>
                    </th>
                    <th>
                        <span>Rental Bond</span>
                    </th>
                    <th>
                        Total Amount
                    </th>
                    <th>
                        Status
                    </th>
                    @if (Model.IsBondPaid == false && User.IsInRole(WebSiteRoles.Role_Tenant))                        
                    {
                        <th>
                            Action
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => @Model.BondPaymentDate)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => @Model.BondAmount)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => @Model.BondAmount)
                    </td>
                    <td>
                        @{
                            if (Model.IsBondPaid == true)
                            {
                                <span>Paid</span>
                            }
                            else
                            {
                                <span>Unpaid</span>
                            }
                        }
                    </td>
                    <td>
                        @if (Model.IsBondPaid == false && User.IsInRole(WebSiteRoles.Role_Tenant))
                        {
                            <a id="proceed2pay" class="btn btn-primary">Proceed to payment</a>
                        }                         
                    </td>
                </tr>
            </tbody>
        </table>  
        @if (User.IsInRole(WebSiteRoles.Role_Tenant))
            {
                <div id="divpay" style="display:none;" class="row pt-5">
            <div class="col-md-6">
                <h3>Payment Summary</h3>
                <div>
                    <span>Title:</span>
                    <span>Bond</span>
                </div>
                <div>
                    <span>Amount:</span>
                    <span>@Model.BondAmount<br></span>
                </div>
                <div>
                    <span>Payment Due Date</span>
                    <span>@Model.BondPaymentDate</span>
                </div>
                <div>
                    <span>Subtotal</span>
                    <span>$@Model.BondAmount<br></span>
                </div>
                <div>
                    <span>Total</span>
                    <span>$@Model.BondAmount<br></span>
                </div>
                <div>
                    @*<img src="/wp-content/themes/realeswp/images/icons/cards/bank.svg">*@
                    <div>
                        @if (ViewBag.UserAccount != null)
                        {
                            <span>@ViewBag.UserAccount</span>
                        }
                        @if (ViewBag.PaymentMethod != null)
                        {
                            <span>@ViewBag.PaymentMethod</span>
                        }
                    </div>
                </div>
                <div class="form-group pl-3">
                    <label class="form-check-label">
                        <input type="checkbox" id="chkacknowledge" class="form-check-input" />
                        I acknowledge that when I click pay below that the payment will begin processing and the money will be collected via my preferred payment method.
                    </label>
                </div>
                <div><button id="btnpay" disabled class="btn btn-primary">Pay Now</button></div>
                @*<div><a disabled class="btn btn-primary">Pay Now</a></div>*@
            </div>
            <div class="col-md-4 col-md-offset-2 float-right-md">
                <h3>Note:</h3>
                <p>
                    Your payment will be run the same way as your normal rental payments please make sure there
                    are
                    funds in your account until the end of the next business day after clicking pay. It will be
                    processed
                    within 3 days.
                </p>
                <p>To change the method of payment, please go to '<b>My Account</b>'.</p>
            </div>
        </div>
            }
        
    </form>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/showpaybond.js" type="text/javascript">
</script>

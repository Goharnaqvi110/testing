@using Gharshare.Models
@model Feature
@{
    ViewData["Title"] = "Delete feature";
    Layout = null;
}
<div class="col-lg-12">
    <form id="frmFeature">
        <input type="hidden" asp-for="ID" />
        @Html.AntiForgeryToken()
        <div class="row justify-content-center mb-3">
            <label class="text-label form-label">
                Name
            </label>
            <div class="flex">
                <input type="text" asp-for="Title" readonly
                       class="form-control" />
            </div>
        </div>
        <div class="row justify-content-center mb-3">
            <div class="col-sm-6 text-end">                
                    <button type="submit" class="btn btn-primary">
                        Delete
                    </button>
                
            </div>
            <div class="col-sm-6">
                <a id="btnclose" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancel
                </a>
            </div>
        </div>
    </form>
</div>
<partial name="_ValidationScriptsPartial" />
<script src="~/js/site/deleteFeature.js"></script>
@using Gharshare.Models
@using Gharshare.CommonHelper
@model List<EmailTemplate>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "List of Email Templates";
    Pager pager = new Pager();
    int pageNo = 0;

    if (ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;
        pageNo = pager.CurrentPage;
    }
}
<div class="row justify-content-center">
    <div class="col-lg-12">
        <div class="card m-5">
            <div class="card-header">
                <div class="col-md-9"><h4 class="card-title">Email Template List</h4></div>
                <div class="col-md-3">
                    <a asp-action="createemailtemplate" asp-controller="site"
                       class="btn btn-primary">
                        <i class="fa fa-plus"></i>
                        Create new Template
                    </a>
                </div>
            </div>
            <div class="card-body">
                @if (Model.Any())
                {
                    <div id="planlist">
                        <table class="table table-responsive-md">
                            <thead>
                                <tr>
                                    <th>
                                        <strong>No</strong>
                                    </th>
                                    <th><strong>Name</strong></th>
                                    @*<th><strong>Type</strong></th>*@
                                    <th><strong>Created on</strong></th>
                                    <th><strong>Created by</strong></th>
                                    <th><strong>Status</strong></th>
                                    <th><strong>Action</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Count(); i++)
                                {
                                    var template = Model[i];
                                    var sno = @i + 1;
                                    <tr>
                                        <td>@sno</td>
                                        <td>@template.Title</td>
                                        @*<td>@template.EmailTemplateType.Title</td>*@
                                        <td>@Utility.ConvertToShortDateFormat(@template.CreatedOn)</td>
                                        <td>@template.CreatedbyUser?.Name</td>
                                        <td>
                                            @if (template.IsActive)
                                            {
                                                <div class="align-items-center">
                                                    <i class="fa fa-circle text-success me-1"></i> Active
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="align-items-center">
                                                    <i class="fa fa-circle text-warning me-1"></i> Inactive
                                                </div>
                                            }
                                        </td>
                                        <td class="">
                                            <div class="">
                                                <a asp-action="createemailtemplate" asp-route-templateId=@template.UId
                                           class="edit btn btn-danger shadow btn-xs sharp me-1">
                                                    <i class="fa fa-pen"></i>
                                                </a>
                                                <a class="btn btn-danger shadow btn-xs sharp"
                                           asp-action="deleteemailtemplate" asp-route-templateId=@template.UId>
                                                    <i class="fa fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <partial name="_Pager" model="@pager" />
                }
                else
                {
                    <div id="noplan" class="row text-center p-3">
                        <h4>There are no templates.</h4>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

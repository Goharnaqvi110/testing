@using Gharshare.Models
@using Gharshare.CommonHelper
@model DashboardVM

@{
    ViewData["Title"] = "Dashboard";
    Layout = "_LayoutAdmin";
}
<div class="container-fluid">
    <div class="mb-sm-4 d-flex flex-wrap align-items-center text-head">
        <h2 class="mb-3 me-auto">Dashboard</h2>
        <div>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="javascript:void(0)">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="javascript:void(0)">Dashboard</a></li>
            </ol>
        </div>
    </div>
    <div class="row">
        <div class="col-xl-6 col-sm-6">
            <div class="card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div class="card-data me-2">
                        <h5>Propeties</h5>
                        <h2 class="fs-40 font-w600">@Model.properties</h2>
                    </div>
                    <div>
                        <span class="donut1" data-peity='{ "fill": ["var(--primary)", "rgba(242, 246, 252)"]}'>@Model.properties</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6 col-sm-6">
            <div class="card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div class="card-data me-2">
                        <h5>Propeties for Rent</h5>
                        <h2 class="fs-40 font-w600">@Model.totalAds</h2>
                    </div>
                    <div>
                        <span class="donut1" data-peity='{ "fill": ["rgb(56, 226, 93,1)", "rgba(242, 246, 252)"]}'>@Model.totalAds/@Model.properties</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6 col-sm-6">
            <div class="card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div class="card-data me-2">
                        <h5>Landlords</h5>
                        <h2 class="fs-40 font-w600">@Model.landlords</h2>
                    </div>
                    <div>
                        <span class="donut1" data-peity='{ "fill": ["rgb(51, 62, 75,1)", "rgba(242, 246, 252)"]}'>@Model.landlords/@Model.totalCustomers</span>
                    </div>
                </div>
            </div>
        </div>        
        <div class="col-xl-6 col-sm-6">
            <div class="card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div class="card-data me-2">
                        <h5>Tenants</h5>
                        <h2 class="fs-40 font-w600">@Model.tenants</h2>
                    </div>
                    <div>
                        <span class="donut1" data-peity='{ "fill": ["rgb(255, 135, 35,1)", "rgba(242, 246, 252)"]}'>@Model.tenants/@Model.totalCustomers</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6 col-sm-6">
            <div class="card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div class="card-data me-2">
                        <h5>Total Customers</h5>
                        <h2 class="fs-40 font-w600">@Model.totalCustomers</h2>
                    </div>
                    <div>
                        <span class="donut1" data-peity='{ "fill": ["rgb(56, 226, 93,1)", "rgba(242, 246, 252)"]}'>@Model.totalCustomers/@Model.totalCustomers</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6 col-sm-6">
            <div class="card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div class="card-data me-2">
                        <h5>Total Income(Rs)</h5>
                        <h2 class="fs-40 font-w600">@Utility.Format(@Model.totalEarnings)</h2>
                    </div>
                    <div>
                        <span class="donut1" data-peity='{ "fill": ["rgb(51, 62, 75,1)", "rgba(242, 246, 252)"]}'>@Model.totalEarnings/@Model.totalEarnings</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xl-9 col-xxl-8">
            <div class="row">                
                <div>
                    <div class="card">
                        <input id="landlord" type="hidden" value="@Model.landlordPercent" />
                        <input id="tenant" type="hidden" value="@Model.tenantPercent" />
                        <input id="freeUser" type="hidden" value="@Model.totalCustomers" />

                        <div class="card-header border-0">
                            <h4 class="fs-20">Customer Chart</h4>
                        </div>
                        <div class="card-body pt-0 text-center" style="min-height:450px;">
                            <div id="pieChart2" class="d-inline-block pieChart1"></div>
                            <div class="chart-items">
                                <div class=" col-xl-12 col-sm-12">
                                    <div class="row text-black text-start mt-4 chart-link">
                                        <span class="offset-md-4 mb-2 col-2">
                                            <svg class="me-2" width="19" height="19" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <rect width="19" height="19" rx="9.5" fill="#2BC155" />
                                            </svg>
                                            Landlords
                                        </span>
                                        <span class="mb-2 col-4">
                                            <svg class="me-1" width="19" height="19" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <rect width="19" height="19" rx="9.5" fill="#FF7A30" />
                                            </svg>
                                            Tenants
                                        </span>
                                        @* <span class="mb-2 col-4">
                                            <svg class="me-2" width="19" height="19" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <rect width="19" height="19" rx="9.5" fill="#FFEF5F" />
                                            </svg>
                                            Free Users
                                        </span> *@
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>                
            </div>
        </div>
        <div class="col-xl-3 col-xxl-4">
            <div class="row">                
                <div class="col-xl-12 col-md-6">
                    <div class="card" style="min-height:370px;">
                        <div class="card-header border-0 pb-0">
                            <h4 class="fs-20">Recent Customer</h4>
                            <div class="dropdown custom-dropdown mb-0">
                                <div class="btn sharp tp-btn dark-btn" data-bs-toggle="dropdown">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M12 13C12.5523 13 13 12.5523 13 12C13 11.4477 12.5523 11 12 11C11.4477 11 11 11.4477 11 12C11 12.5523 11.4477 13 12 13Z" stroke="#342E59" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                        <path d="M12 6C12.5523 6 13 5.55228 13 5C13 4.44772 12.5523 4 12 4C11.4477 4 11 4.44772 11 5C11 5.55228 11.4477 6 12 6Z" stroke="#342E59" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                        <path d="M12 20C12.5523 20 13 19.5523 13 19C13 18.4477 12.5523 18 12 18C11.4477 18 11 18.4477 11 19C11 19.5523 11.4477 20 12 20Z" stroke="#342E59" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </div>
                                <div class="dropdown-menu dropdown-menu-right">
                                    <a class="dropdown-item"
                                    asp-controller="user" asp-action="index" asp-area="admin">
                                    Go to User List</a>                                     
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            @if (Model.recentCustomers.Any())
                            {
                                foreach (var customer in Model.recentCustomers)
                                {
                                    <div class="d-flex align-items-center mb-4">
                                        <div class="recent-customer me-3">
                                            <img src='@(customer?.ProfilePicture ?? "/img/user-image.png")' width="50" alt="">
                                        </div>
                                        <div><a href="#" title="Edit user" onclick="loadUserProfile('@customer.Id')"
                                           data-bs-toggle="modal" data-bs-target="#largeModal">
                                       <h5 class="mb-0">@customer.Name</h5>    
                                       </a>                                            
                                            <p class="font-w600 mb-0 text-primary">
                                                @Utility.GetEnumDisplayName(customer.UserType)
                                            </p>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                        <div class="card-footer border-0">
                            <a href="#" onclick="loadCreateUser()" data-bs-target="#basicModal"
                           data-bs-toggle="modal"class="btn btn-primary btn-block">+Add New</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Apex Chart -->
<script src="~/theme/vendor/apexchart/apexchart.js"></script>
<!-- Chart piety plugin files -->
<script src="~/theme/vendor/peity/jquery.peity.min.js"></script>
<!-- Dashboard 1 -->
<script src="~/theme/js/dashboard/dashboard-1.js"></script>
<script src="~/theme/js/dashboard/analytics.js"></script>
<!-- JS for dotted map -->
<script src="~/theme/vendor/dotted-map/js/contrib/jquery.smallipop-0.3.0.min.js"></script>
<script src="~/theme/vendor/dotted-map/js/contrib/suntimes.js"></script>
<script src="~/theme/vendor/dotted-map/js/contrib/color-0.4.1.js"></script>
<script src="~/theme/vendor/dotted-map/js/world.js"></script>
<script src="~/theme/vendor/dotted-map/js/smallimap.js"></script>
<script src="~/theme/js/dashboard/dotted-map-init.js"></script>
<script src="~/js/admin/user/loadUserProfilePopup.js"></script>
<script src="~/js/admin/user/loadCreateuserPopup.js"></script>

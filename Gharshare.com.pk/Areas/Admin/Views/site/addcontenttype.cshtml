@using Gharshare.Models
@model ContentType
@{
    ViewData["Title"] = "Add content type";
    Layout = null;
}
<div class="col-lg-12">
    <form id="frmContentType" method="Post">
        <input type="hidden" id="txttypeId" asp-for="ID" />
        @Html.AntiForgeryToken()        
        <div class="row justify-content-center mb-3">
            <label class="text-label form-label">
                Name
            </label>
            <div class="flex">
                <input type="text" asp-for="Name" id="txtCity"
                       class="form-control required placeholder="Enter content name..." />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
        <div class="row justify-content-center mb-3">
            <div class="col-sm-6 text-end">
                @if (Model.ID > 0)
                {
                    <button type="submit" class="btn btn-primary">
                        Update
                    </button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary">
                        Save
                    </button>
                }
            </div>
            <div class="col-sm-6">
                <a id="btnclose" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancel
                </a>
            </div>
        </div>
    </form>
</div>
<partial name="_ValidationScriptsPartial" />
<script src="~/js/site/saveContentType.js"></script>
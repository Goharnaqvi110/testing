@using Gharshare.Models
@model Accepting
@{
    ViewData["Title"] = "Add accepting";
    Layout = null;
}
<div class="col-lg-12">
    <form id="frmAccepting" asp-area="admin" asp-action="addaccepting" method="Post">
        <input type="hidden" id="txtId" asp-for="ID" />
        <input type="hidden" asp-for="uid" />
        @Html.AntiForgeryToken()        
        <div class="row justify-content-center mb-3">
            <label class="text-label form-label">
                Name
            </label>
            <div class="flex">
                <input type="text" asp-for="Title" 
                       class="form-control" required placeholder="Enter name..." />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
        </div>  
        <div class="row justify-content-center mb-3">
            <div class="col-sm-6 text-end">
                @if (Model.ID > 0)
                {
                    <button type="submit" class="btn btn-primary">
                        Update
                    </button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary">
                        Save
                    </button>
                }
            </div>
            <div class="col-sm-6">
                <a id="btnclose" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancel
                </a>
            </div>
        </div>
    </form>
</div>
<partial name="_ValidationScriptsPartial" />
<script src="~/js/site/saveAccepting.js"></script>
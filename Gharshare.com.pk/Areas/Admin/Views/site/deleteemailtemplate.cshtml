@using Gharshare.Models
@model EmailTemplate
@{
    ViewData["Title"] = "Delete email template";
    Layout = "_LayoutAdmin";
}
<div class="col-lg-12">
    <div class="card m-5">
        <div class="card-header">
            <h4 class="card-title">Delete email template</h4>
        </div>
        <div class="card-body">
            <form asp-area="admin" asp-action="deleteemailtemplate" method="Post" enctype="multipart/form-data">
                <input type="hidden" asp-for="ID" />                 
                <div class="row justify-content-center mb-3">
                    <div class="col-sm-6">
                        <label class="text-label form-label">Template Type</label>
                        <div class="flex">
                             <span>@Model.Title</span>
                        </div>
                    </div>
                </div>
                <div class="row justify-content-center mb-3">
                    <div class="col-sm-6">
                        <label class="text-label form-label">Title</label>
                        <div class="flex">
                            <input asp-for="Title" type="text" class="form-control"
                             readonly>                            
                        </div>
                    </div>
                </div>
                <div class="row justify-content-center mb-3">
                    <div class="col-sm-6 text-start">
                        <label class="text-label form-label">Status</label>
                        <div class="form-check custom-checkbox ms-1 ">
                            <input disabled type="checkbox" asp-for="IsActive"
                                   class="form-check-input" />
                            <label class="form-check-label">
                                Active
                            </label>
                        </div>
                    </div>
                </div>
                <div class="row justify-content-center mb-3 mt-2">
                    <div class="col-sm-12">
                        <label class="text-label form-label">Template content</label>
                        <div id="editor"></div>
                        <input type="hidden" asp-for="Template" />
                    </div>
                </div>
                <div class="row justify-content-center mb-2">
                       <button type="submit" class="btn btn-primary w-50">
                            Delete this template
                        </button>                     
                </div>
            </form>
        </div>
    </div>
</div>
<partial name="_ValidationScriptsPartial" />
<script src="https://cdn.ckeditor.com/ckeditor5/36.0.1/classic/ckeditor.js"></script>
<script src="~/js/commonfunctions/initializeCkeditor.js"></script>
<script>
    // Call the function to initialize CKEditor
    initializeCKEditor('Template');
</script>

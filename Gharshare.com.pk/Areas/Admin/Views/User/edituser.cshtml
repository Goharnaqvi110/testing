@using Gharshare.Models
@model ApplicationUser
@{
    ViewData["Title"] = "Edit User";
    Layout = null;
}
<div class="row justify-content-center h-100 align-items-center">
    <div class="col-md-12">
        <div class="">
            <div class="row no-gutters">
                <div class="col-xl-12">
                    <div class="">
                        <div class="text-center mb-2">
                            <div class="rounded-image">
                                <div id="AccountPic">
                                    <img src='@(Model?.ProfilePicture ?? "/img/user-image.png")' alt="Rounded Image"
                                         onclick="document.getElementById('file-upload').click();" />
                                </div>
                                <input id="file-upload" type="file" accept="image/*" style="display: none;"
                                       onchange="validateAndUploadImage(this);" />
                            </div>
                        </div>
                        <form id="frmUser">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="UserType" />
                            <div class="mb-3">
                                <label><strong>Name</strong></label>
                                <div class="form-inline">
                                    <input required id="txtName" type="text" class="form-control" asp-for=@Model.Name />                                            
                                    <span id="spanName" asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label><strong>Email Address</strong></label>
                                    <div class="form-inline">
                                        <input id="txtEmail" readonly type="email" class="form-control" asp-for="Email">
                                        <span id="spanEmail" asp-validation-for="Email" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label><strong>Mobile Number</strong></label>
                                    <div class="form-inline">
                                        <input id="txtMobile" oninput="formatMobileNumber(this)" type="tel"
                                               class="form-control" asp-for="Mobile" maxlength="15">
                                    </div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label><strong>Address</strong></label>
                                <input class="form-control" asp-for="Address">
                            </div>
                            <div class="row mb-3">
                                <div class="col-sm-6 text-start">
                                    <label class="text-label form-label">Is this user active and can access their account?</label>
                                    <div class="form-check custom-checkbox ms-1 ">
                                        <input type="radio" name="IsActive" value="true"
                                        @(Model.IsActive == true ? "checked" : "")
                                               class="form-check-input" />
                                        <label class="form-check-label">
                                            Yes! the user is active 
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-sm-6 text-start">                                     
                                    <div class="form-check custom-checkbox ms-1 ">
                                        <input type="radio" name="IsActive" value="false"
                                        @(Model.IsActive == false ? "checked" : "")
                                               class="form-check-input" />
                                        <label class="form-check-label">
                                            No! the user is blocked
                                        </label>
                                    </div>
                                </div>
                            </div>
                            @if (Model.UserType != ApplicationUser.usertype.admin)
                            {
                                <div class="loginBoxAccount">
                                    <label for="">
                                        Allow members to be able to contact user directly on mobile?
                                        <a href="#" data-toggle="tooltip" data-placement="bottom" title="Tooltip on bottom">
                                            <svg fill="#000000" width="15" version="1.1" id="Capa_1"
                                             xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
                                             viewBox="0 0 416.979 416.979" xml:space="preserve">
                                            <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                                            <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round">
                                                                                            </g>
                                            <g id="SVGRepo_iconCarrier">
                                            <g>
                                            <path d="M356.004,61.156c-81.37-81.47-213.377-81.551-294.848-0.182c-81.47,81.371-81.552,213.379-0.181,294.85 c81.369,81.47,213.378,81.551,294.849,0.181C437.293,274.636,437.375,142.626,356.004,61.156z M237.6,340.786 c0,3.217-2.607,5.822-5.822,5.822h-46.576c-3.215,0-5.822-2.605-5.822-5.822V167.885c0-3.217,2.607-5.822,5.822-5.822h46.576 c3.215,0,5.822,2.604,5.822,5.822V340.786z M208.49,137.901c-18.618,0-33.766-15.146-33.766-33.765 c0-18.617,15.147-33.766,33.766-33.766c18.619,0,33.766,15.148,33.766,33.766C242.256,122.755,227.107,137.901,208.49,137.901z">
                                                                                                    </path>
                                                                                                </g>
                                                                                            </g>
                                                                                        </svg>
                                        </a>
                                    </label>
                                    <div class="form-check custom-checkbox ms-1 ">
                                        <input type="radio" name="showNumber" id="chkShownumber"
                                           value="true" @(Model.ShowNumber == true ? "checked" : "") class="form-check-input" />
                                        <label class="form-check-label">
                                            Yes please! Make my number public
                                        </label>
                                    </div>
                                    <div class="form-check custom-checkbox ms-1 ">
                                        <input type="radio" name="showNumber" id="chkNotShownumber"
                                           class="form-check-input" value="false" @(Model.ShowNumber == false ? "checked" : "") />
                                        <label class="form-check-label"
                                           for="basic_checkbox_1">No thanks. Keep it private</label>
                                    </div>
                                </div>
                            }
                            <div class="text-center mt-3 mb-1">
                                <button type="submit"
                                        class="btn btn-primary btn-block">
                                    Save changes
                                </button>
                            </div>
                        </form>
                        @if (Model.UserType == ApplicationUser.usertype.admin)
                        {
                            <div class="text-center mt-2">
                                <a onclick="loadChangepasswordPageInPopup();"
                               class="btn btn-secondary btn-block">
                                    Change password
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<partial name="_ValidationScriptsPartial" />
<script src="~/js/profile/uploadProfileImage.js"></script>
<script src="~/js/admin/user/updateUser.js"></script> 
<script src="/js/profile/formatmobilenum.js"></script>

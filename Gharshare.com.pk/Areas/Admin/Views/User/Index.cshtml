@using Gharshare.Models
@using Gharshare.CommonHelper
@model List<ApplicationUser>
@{
    ViewData["Title"] = "User List";
    Pager pager = new Pager();
    int pageNo = 0;

    if (ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;
        pageNo = pager.CurrentPage;
    }
}
<div class="row justify-content-center">
    <div class="col-lg-12">
        <div class="card m-5">
            <div class="card-header">
                <h4 class="card-title">User List</h4>
            </div>
            <div class="card-body">
                <div class="row m-2">
                    <div class="col-md-3">
                        @*<a asp-area="Admin" asp-page="/Register"*@
                        <a onclick="loadCreateUser()" data-bs-target="#basicModal"
                           data-bs-toggle="modal"
                           class="btn btn-primary">
                            <i class="fa fa-plus"></i>
                            Create new user
                        </a>
                    </div>
                    <div class="col-md-6">
                        <input type="text" id="txtUsersearch" class="form-control"
                               placeholder="Enter name to search user..." />
                    </div>
                    <div class="col-md-3">
                        <select id="ddluserType" class="nice-select wide w-100">
                            <option value="">All users</option>
                            <option value="4">Super admin</option>
                            <option value="3">Admin</option>                             
                            <option value="1">Landlord</option>
                            <option value="2">Tenant</option>
                        </select>
                    </div>
                </div>
                @if (Model.Any())
                {
                    <div id="userList">
                        <table class="table table-responsive-md">
                            <thead>
                                <tr>
                                    <th>
                                        <strong>No</strong>
                                    </th>
                                    <th>
                                        <strong>
                                            <i class="@ViewData["SortIcon"]"></i>
                                            <a asp-action="index" asp-route-pg="@ViewBag.pg"
                                           asp-route-sortOrder="@ViewBag.NameSortParam">
                                                NAME
                                            </a>
                                        </strong>
                                    </th>
                                    <th>
                                        <strong>
                                            <i class="@ViewData["SortIconType"]"></i>
                                            <a asp-action="index" asp-route-pg="@ViewBag.pg"
                                           asp-route-sortOrder="@ViewBag.TypeSortParam">
                                                TYPE
                                            </a>
                                        </strong>
                                    </th>
                                    <th><strong>PHONE</strong></th>
                                    <th><strong>EMAIL</strong></th>
                                    <th>
                                        <strong>
                                            <i class="@ViewData["SortIconAddress"]"></i>
                                            <a asp-action="index" asp-route-pg="@ViewBag.pg"
                                           asp-route-sortOrder="@ViewBag.AddressSortParam">ADDRESS</a>
                                        </strong>
                                    </th>
                                    <th><strong>Status</strong></th>
                                    <th><strong>Action</strong></th>
                                </tr>
                            </thead>
                            <tbody>

                                @{
                                    var count = 1;
                                }
                                @foreach (var user in Model)
                                {
                                    <tr>
                                        <td>@count</td>
                                        <td>
                                            <div style="width:180px;">
                                                <img src='@(user?.ProfilePicture ?? "../img/user-image.png")' class='rounded-lg me-2' width='24' alt=''>
                                                <span class="w-space-no">@user.Name</span>
                                            </div>
                                        </td>
                                        <td>@Utility.GetEnumDisplayName(user.UserType)</td>
                                        <td>
                                            @if (@user.PhoneNumber == null)
                                            {
                                                <span>N/A</span>
                                            }
                                            else
                                                @user.PhoneNumber
                                            </td>
                                            <td>@user.Email</td>
                                            <td style="width:250px;">
                                                @if (@user.Address == null)
                                            {
                                                <span>N/A</span>
                                            }
                                            else
                                                @user.Address


                                            </td>
                                            <td class="align-items-center" style="width:75px;">
                                                @if (user.IsActive)
                                            {
                                                <div class="align-items-center">
                                                    <i class="fa fa-circle text-success me-1"></i> Active
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="align-items-center">
                                                    <i class="fa fa-circle text-warning me-1"></i> Inactive
                                                </div>
                                            }
                                        </td>
                                        <td style="width:100px;">
                                            <div class="">
                                                <a href="#" title="Edit user" onclick="loadUserProfile('@user.Id')"
                                           data-bs-toggle="modal" data-bs-target="#largeModal"
                                           class="edit btn btn-danger shadow btn-xs sharp me-1">
                                                    <i class="fa fa-pen"></i>
                                                </a>
                                                <a title="Delete user" href="#" class="btn btn-danger shadow btn-xs sharp"
                                           onclick="loadHardelUserInPopup('@user.Id')" data-bs-toggle="modal"
                                           data-bs-target="#largeModal">
                                                    <i class="fa fa-trash"></i>
                                                </a>

                                                @if (user.UserType == ApplicationUser.usertype.superadmin)
                                                {
                                                    <a title="Deactivate user" href="#" class="btn btn-danger shadow btn-xs sharp"
                                           onclick="loadUserProfile('@user.Id')"
                                           data-bs-toggle="modal" data-bs-target="#largeModal">
                                                        <i class="fa fa-ban"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a title="Deactivate user" href="#" class="btn btn-danger shadow btn-xs sharp"
                                           onclick="deactivateUser('@user.Id')" data-bs-toggle="modal"
                                           data-bs-target="#largeModal">
                                                        <i class="fa fa-ban"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                    count = count + 1;
                                }
                            </tbody>
                        </table>
                         <partial name="_Pager" model="@pager" />
                    </div>
                    <div class="row m-3 justify-content-center" id="response">
                        <h4>&nbsp;</h4>
                    </div>                    
                }
                else
                {
                    <div id="message" class="row text-center p-3">
                        <h4>no record found.</h4>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<script src="~/js/profile/loadDeactivateAccountInPopup.js"></script>
<script src="~/js/admin/user/deactivateUser.js"></script> 
<script src="~/js/admin/user/loadHardeleteUser.js"></script>
<script src="~/js/admin/user/searchUser.js"></script>
<script src="~/js/admin/user/getUsers.js"></script>
<script src="~/js/admin/user/createUserlist.js"></script>
<script src="~/js/admin/user/loadCreateuserPopup.js"></script>
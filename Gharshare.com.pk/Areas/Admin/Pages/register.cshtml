@page "/admin/register"
@using Gharshare.CommonHelper
@using Gharshare.Models
@using Gharshare.com.pk.Areas.Admin.Pages
@model RegisterModelAdmin
@{
    ViewData["Title"] = "Create new user";
    Layout = null;
}
<div class="row justify-content-center">
    <div class="col-lg-12 m-2">
        <form id="registerForm">
            @Html.AntiForgeryToken()
            <div class="input-group mb-3">
                <span class="input-group-text">
                    <i class="fas fa-user-tie icon"></i>
                </span>
                @if (User.IsInRole(WebSiteRoles.Role_SuperAdmin))
                {
                    <select asp-for="Input.UserType" required class="form-control">
                        <option selected="selected" value="">--select user type--</option>
                        <option value="@ApplicationUser.usertype.admin">Admin</option>
                        <option value="@ApplicationUser.usertype.landlord">Landlord</option>
                        <option value="@ApplicationUser.usertype.tenant">Tenant</option>
                    </select>
                }
                else
                {
                    <select asp-for="Input.UserType" required class="form-control">
                        <option selected="selected" value="">--select user type--</option>
                        <option value="@ApplicationUser.usertype.landlord">Landlord</option>
                        <option value="@ApplicationUser.usertype.tenant">Tenant</option>
                    </select>
                }
                <span asp-validation-for="Input.UserType" class="text-danger"></span>
            </div>
            <div class="input-group mb-3">
                <span class="input-group-text">
                    <i class="fa fa-user icon"></i>
                </span>
                <input asp-for="Input.Name" required class="form-control" data autocomplete="Name" placeholder="full name" aria-required="true" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div class="input-group mb-3">
                <span class="input-group-text">
                    <i class="fa fa-id-card icon"></i>
                </span>
                <input id="cnic" maxlength="15" asp-for="Input.CNIC" oninput="formatCnic(this)" maxlength="15" class="form-control" data-val="true" data-val-required="*" placeholder="cnic">
                <span asp-validation-for="Input.CNIC" class="text-danger"></span>
            </div>
            <div class="input-group mb-3">
                <span class="input-group-text">
                    <i class="fas fa-genderless icon"></i>
                </span>
                <select asp-for="Input.Gender" data-val="true" data-val-required="*" class="form-control">
                    <option selected="selected" value="">--select gender--</option>
                    <option value=@ApplicationUser.gender.male>Male</option>
                    <option value=@ApplicationUser.gender.female>Female</option>
                    <option value=@ApplicationUser.gender.transgender>Transgender</option>
                </select>
                <span asp-validation-for="Input.Gender" class="text-danger"></span>
            </div>
            @*<div class="input-group mb-3">
                <span class="input-group-text">
                    <i class="fa fa-mobile icon"></i>
                </span>
                <input id="mobile" asp-for="Input.Mobile" oninput="formatMobileNumber(this)" maxlength="15" class="form-control" data-val="true" data-val-required="*" placeholder="mobile phone">
                <span asp-validation-for="Input.Mobile" class="text-danger"></span>
            </div>
            <div class="input-group mb-3">
                <span class="input-group-text">
                    <i class="fas fa-map-marked-alt icon"></i>
                </span>
                <select data-val="true" data-val-required="*" id="state" asp-for="Input.StateID" asp-items=@Model.States class="form-control">
                    <option selected="selected" value="">--select province--</option>
                </select>
                <span asp-validation-for="Input.StateID" class="text-danger"></span>
            </div>
            <div class="input-group mb-3">
                <span class="input-group-text">
                    <i class="fas fa-building icon"></i>
                </span>
                <select data-val="true" data-val-required="*" id="city" asp-for="Input.CityID" asp-items=@Model.Cities class="form-control">
                    <option selected value="">--select city--</option>
                </select>
                <span asp-validation-for="Input.CityID" class="text-danger"></span>
            </div>*@
            <div class="input-group mb-3">
                <span class="input-group-text">
                    <i class="fa fa-envelope icon"></i>
                </span>
                <input asp-for="Input.Email" id="txtusername" required class="form-control"
                       placeholder="hello@example.com" aria-required="true" />
                <span id="spanEmail" asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="input-group mb-3">
                <span class="input-group-text">
                    <i class="fa fa-lock icon"></i>
                </span>
                <input type="password" asp-for="Input.Password" required class="form-control" placeholder="password" aria-required="true" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="input-group mb-3">
                <span class="input-group-text">
                    <i class="fa fa-shield icon"></i>
                </span>
                <input type="password" asp-for="Input.ConfirmPassword" required class="form-control" placeholder="confirm password" aria-required="true" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            @*<div id="divcaptcha"></div>
            <input type="hidden" id="txtcaptcha" required />*@
            <div>
                <input style="visibility: hidden;" id="chkTerms" type="checkbox"
                       value="true" asp-for="Input.AgreedtoTerms" class="form-check-input">
            </div>
            <div class="text-center mt-4">
                <button type="submit" class="btn btn-primary w-50">
                    Create User
                </button>
            </div>
        </form>
    </div>
</div>
<!--**********************************
    Scripts
***********************************-->
<script src="~/js/commonFunctions/formatcnic.js"></script>
<script src="~/js/commonFunctions/formatmobilenum.js"></script>
<script src="~/js/register/checkUsername.js"></script>
<partial name="_ValidationScriptsPartial" />
<script src="~/js/PopulateDropdownList.js" type="text/javascript"></script>
<script src="~/js/admin/user/createUser.js"></script>
<partial name="_GoogleAutocompAddPartial" />
@page "/login"
@model LoginModel

@{
    ViewData["Title"] = "Sign in";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="~/css/admin/style.css" rel="stylesheet">
    <link rel="shortcut icon" href="~/img/favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>
<body>
    <div class="vh-100">
        <div class="authincation h-100">
            <div class="container h-100">
                <div class="row justify-content-center h-100 align-items-center">
                    <div class="col-md-6">
                        <div class="authincation-content">
                            <div class="row no-gutters">
                                <div class="col-xl-12">
                                    <div class="auth-form">
                                        <div class="text-center mb-3">
                                            <a asp-area="" asp-controller="home" asp-action="index">
                                                <img src="~/img/logo-2.png" style="width:30%;" alt=""></a>
                                        </div>
                                        <h4 class="text-center mb-4">Welcome to Smart Property Manager</h4>
                                        @*<div asp-validation-summary="ModelOnly" class="text-danger"></div>*@
                                        <form id="account" method="post">
                                            <div class="mb-3">                                                 
                                                <div class="input-group mb-3">
                                                    <span class="input-group-text">
                                                        <i class="fa fa-user icon"></i>
                                                    </span>                                                     
                                                    <input type="email" data-val="true" data-val-required="*" class="form-control" asp-for="Input.Email" />
                                                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                                                </div>                                                 
                                            </div>
                                            <div class="mb-3">                                                 
                                                <div class="input-group mb-3">
                                                    <span class="input-group-text">
                                                        <i class="fa fa-lock icon"></i>
                                                    </span>                                                     
                                                    <input type="password" asp-for="Input.Password" class="form-control" value="Password">
                                                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                                                </div>
                                            </div>
                                            <div class="row d-flex justify-content-between mt-4 mb-2">
                                                <div class="mb-3">
                                                    <div class="form-check custom-checkbox ms-1">
                                                        <input type="checkbox" asp-for="Input.RememberMe" class="form-check-input" id="basic_checkbox_1">
                                                        <label asp-for="Input.RememberMe" class="form-check-label" for="basic_checkbox_1">Remember Me</label>
                                                    </div>
                                                </div>
                                                <div class="mb-3">
                                                    <a id="forgot-password" asp-page="./ForgotPassword">Forgot Password?</a>
                                                </div>
                                            </div>
                                            <div class="text-center">
                                                <button type="submit" id="login-submit" class="btn btn-primary btn-block">Sign Me In</button>
                                            </div>
                                        </form>
                                        <div class="new-account mt-3">
                                            <p>Don't have an account? <a class="text-primary" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Sign up</a></p>
                                        </div>
                                        <div class="new-account mt-3">
                                            <p>
                                                Want to get email confirmation? <a class="text-primary" id="resend-confirmation"
                                                                                   asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    </body>
    </html>

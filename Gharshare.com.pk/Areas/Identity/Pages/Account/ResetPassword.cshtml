@page "/resetpassword"
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="~/img/favicon.png" type="image/x-icon" />
    <link href="~/css/admin/style.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>
<body>
<div class="vh-100">
    <div class="authincation h-100">
        <div class="container h-100">
            <div class="row justify-content-center h-100 align-items-center">
                <div class="col-md-6">
                    <div class="authincation-content">
                        <div class="row no-gutters">
                            <div class="col-xl-12">
                                <div class="auth-form">
                                    <div class="text-center mb-3">
                                            <a asp-area="" asp-controller="home" asp-action="index">
                                                <img src="~/img/logo-2.png" style="width:60%;" alt="">
                                            </a>
                                        </div>
                                    <h3>@ViewData["Title"]</h3><hr />
                                    <form method="post">
                                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                        <input asp-for="Input.Code" type="hidden" />

                                        <div class="mb-3">
                                            <div class="input-group mb-3">
                                                <span class="input-group-text">
                                                    <i class="fa fa-user icon"></i>
                                                </span>
                                                <input type="email" data-val="true" 
                                                data-val-required="*" class="form-control" 
                                                placeholder="Please enter your email" asp-for="Input.Email" />
                                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <div class="input-group mb-3">
                                                <span class="input-group-text">
                                                    <i class="fa fa-lock icon"></i>
                                                </span>
                                                <input type="password" asp-for="Input.Password" class="form-control" value="Password" placeholder="Please enter password">
                                                <span asp-validation-for="Input.Password" class="text-danger"></span>
                                            </div>
                                        </div>
                                         <div class="mb-3">
                                            <div class="input-group mb-3">
                                                <span class="input-group-text">
                                                    <i class="fa fa-lock icon"></i>
                                                </span>
                                                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password"
                                                placeholder="Please re-enter password" aria-required="true" />
                                                 <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="text-center">
                                            <button type="submit" id="login-submit" class="btn btn-primary btn-block">Reset</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
</body>
</html>


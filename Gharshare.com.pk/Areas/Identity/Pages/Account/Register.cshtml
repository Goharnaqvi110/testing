    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/PopulateDropdownList.js" type="text/javascript"></script>
    <script src="~/js/enableRegistration.js" type="text/javascript"></script>
    <partial name="_GoogleAutocompAddPartial" />
    <!-- Required vendors -->
    <script src="./vendor/global/global.min.js"></script>
    <script src="./js/custom.min.js"></script>
    <script src="./js/deznav-init.js"></script>
    <script src="~/js/formatcnic.js"></script>
    <script src="~/js/formatmobilenum.js"></script>
    <script src="~/js/profile/checkUsername.js"></script>
    <script src="~/js/profile/validatePassword.js"></script>
</body>
</html>
@page "/register"
@model RegisterModel
@using Gharshare.CommonHelper
@using Gharshare.Models
@{
    ViewData["Title"] = "Sign up";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="robots" content="noindex, follow" />
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"] - smartpropertymanager.pk</title>
    <link href="~/css/admin/style.css" rel="stylesheet">
    <!-- Place favicon.png in the root directory -->
    <link rel="shortcut icon" href="~/img/favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.3.0/css/all.min.css" integrity="sha512-SzlrxWUlpfuzQ+pcUCosxcglQRNAq/DZjVsC0lE40xsADsfeQoEypE+enwcOiGjk/bSuGGKHEyjSoQ1zVisanQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body class="vh-100">
    <div class="authincation mt-50 mb-50">
        <div class="container h-100">
            <div class="row justify-content-center h-100 align-items-center">
                <div class="col-md-7">
                    <div class="authincation-content mt-4 mb-4">
                        <div class="row no-gutters">
                            <div class="col-xl-12">
                                <div class="auth-form">
                                    <div class="text-center mb-3">
                                        <a asp-area="" asp-controller="home" asp-action="index">
                                            <img src="~/img/logo-2.png" style="width:30%;" alt="logo">
                                        </a>
                                    </div>
                                    <h5 class="text-center mb-4">
                                        Register Now to Find & Manage Tenants or Properties,
                                        100% Online
                                    </h5>
                                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post"
                                          enctype="multipart/form-data">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="input-group mb-3">
                                                    <input type="radio" required value=@ApplicationUser.usertype.landlord checked
                                                           asp-for="Input.UserType" />
                                                    <label style="margin:2px;"> I have a property to rent out</label>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="input-group mb-3">
                                                    <input type="radio" value=@ApplicationUser.usertype.tenant required
                                                           asp-for="Input.UserType" />
                                                    <label style="margin:2px;"> I need a property on rent</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="input-group mb-3">
                                                <span class="input-group-text">
                                                    <i class="fa fa-user icon"></i>
                                                </span>
                                                <input asp-for="Input.Name" data-val="true" data-val-required="*"
                                                       class="form-control" autocomplete="off" placeholder="full name"
                                                       aria-required="true" />
                                                <span asp-validation-for="Input.Name" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="input-group mb-3">
                                                    <span class="input-group-text">
                                                        <i class="fas fa-genderless icon"></i>
                                                    </span>
                                                    <select asp-for="Input.Gender" data-val="true" data-val-required="*" class="form-control">
                                                        <option selected="selected" value="">--select gender--</option>
                                                        <option value=@ApplicationUser.gender.male>Male</option>
                                                        <option value=@ApplicationUser.gender.female>Female</option>
                                                        <option value=@ApplicationUser.gender.transgender>Transgender</option>
                                                    </select>
                                                    <span asp-validation-for="Input.Gender" class="text-danger"></span>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="input-group mb-3">
                                                    <span class="input-group-text">
                                                        <i class="fa fa-id-card icon"></i>
                                                    </span>
                                                    <input id="cnic" maxlength="15" asp-for="Input.CNIC"
                                                           oninput="formatCnic(this)" maxlength="15"
                                                           class="form-control" data-val="true" data-val-required="*"
                                                           placeholder="cnic" autocomplete="off">
                                                    <span asp-validation-for="Input.CNIC" class="text-danger"></span>
                                                </div>
                                            </div>
                                        </div>
                                        @* <div class="input-group mb-3">
                                        <span class="input-group-text">
                                        <i class="fa fa-mobile icon"></i>
                                        </span>
                                        <input id="mobile" asp-for="Input.Mobile" oninput="formatMobileNumber(this)" maxlength="15" class="form-control" data-val="true" data-val-required="*" placeholder="mobile phone">
                                        <span asp-validation-for="Input.Mobile" class="text-danger"></span>
                                        </div> *@
                                        @* <div class="input-group mb-3">
                                        <span class="input-group-text">
                                        <i class="fas fa-map-marked-alt icon"></i>
                                        </span>
                                        <select data-val="true" data-val-required="*" id="state"
                                        asp-for="Input.StateID" asp-items=@Model.States class="form-control">
                                        <option selected="selected" value="">--select province--</option>
                                        </select>
                                        <span asp-validation-for="Input.StateID" class="text-danger"></span>
                                        </div> *@
                                        <div class="input-group mb-3">
                                            <span class="input-group-text">
                                                <i class="fas fa-building icon"></i>
                                            </span>
                                            <select data-val="true" data-val-required="*" id="city"
                                                    asp-for="Input.CityID" asp-items=@Model.Cities class="form-control">
                                                <option selected value="">--select city--</option>
                                            </select>
                                            <span asp-validation-for="Input.CityID" class="text-danger"></span>
                                        </div>
                                        <div class="input-group mb-3">
                                            <span class="input-group-text">
                                                <i class="fas fa-home icon"></i>
                                            </span>
                                            <input id="address" asp-for="Input.Address" placeholder="address"
                                                   class="form-control" autocomplete="off" aria-required="true" />
                                        </div>
                                        <div class="input-group mb-3">
                                            <span class="input-group-text">
                                                <i class="fa fa-envelope icon"></i>
                                            </span>
                                            <input asp-for="Input.Email" id="txtusername" data-val="true" data-val-required="*"
                                                   class="form-control" placeholder="hello@example.com"
                                                   aria-required="true" autocomplete="off" />
                                            <span id="spanEmail" asp-validation-for="Input.Email" class="text-danger"></span>
                                        </div>
                                        <div class="input-group mb-3">
                                            <span class="input-group-text">
                                                <i class="fa fa-lock icon"></i>
                                            </span>
                                            <input id="txtPassword" asp-for="Input.Password" class="form-control" placeholder="password"
                                                   data-val="true" data-val-required="*" aria-required="true" autocomplete="off" />
                                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                                        </div>
                                        <div class="input-group mb-3">
                                            <span class="input-group-text">
                                                <i class="fa fa-shield icon"></i>
                                            </span>
                                            <input asp-for="Input.ConfirmPassword" data-val="true" data-val-required="*"
                                                   class="form-control" placeholder="confirm password" aria-required="true"
                                                   autocomplete="off" />
                                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                                        </div>
                                        <div>
                                            <div id="divcaptcha"></div>
                                            <input type="hidden" id="txtcaptcha" required />
                                        </div>
                                        <div class="row d-flex justify-content-between">
                                            <div class="mb-2">
                                                <div class="form-check custom-checkbox ms-1">
                                                    <input id="chkTerms" type="checkbox" asp-for="Input.AgreedtoTerms" class="form-check-input" id="basic_checkbox_1">
                                                    <label class="form-check-label" for="basic_checkbox_1">
                                                        By clicking Get Started, you agree to our
                                                        <a class="text-primary" href="#">terms & conditions</a>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="text-center mt-1">
                                            <button id="registerSubmit" disabled type="submit"
                                                    class="btn btn-primary btn-block">
                                                Get Started
                                            </button>
                                        </div>
                                    </form>
                                    <div class="new-account mt-2">
                                        <p>Already have an account? <a class="text-primary" id="login" asp-area="identity" asp-page="/account/login">Sign in</a></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--**********************************
        Scripts
    ***********************************-->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.js"></script>
    @*<script src="https://www.google.com/recaptcha/api.js?onload=onloadCallback&render=explicit" async defer>
    </script>*@
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.32/dist/sweetalert2.all.min.js"></script>

